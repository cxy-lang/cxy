module hello

pub struct Mayor {
    _name: String|f64

    func getString(): strview {
        match (_name) {
            case String as val => return val == null ? "".s : val.s()
            ...            => return "".s
        }
    }

    @inline
    const func text() => _name is #String ? "Str".s : "".s

    @[static, inline]
    func text(s: strview) {
        return s
    }
}
