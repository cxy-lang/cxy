
extern func printf(format: string, ...args: auto): i32

// func hello(x: (i8, bool, string)) {
//     return (x.1, x.2, x.0)
// }
func say(data: [i8]) {
    for i in data {
        printf("%d\n", i)
    }
}

func take(x: i32|string) {
    if x is #i32 {
        printf("i32: %d\n", x as i32)
    } else {
        printf("string: %s\n", x as string)
    }
}

func give(s: bool): i32|string {
    if s {
        return "Hello"
    } else {
        return 42.i32
    }
}

class Awesome {
    func `init`() {}
    func say() => "Hello"
}

func main() {
    var x = Awesome()
    var msg = x?.say()
    printf("%s\n", msg ?? "default")
}
