
extern func printf(format: string, ...args: auto): i32

func hello(x: (i8, bool, string)) {
    return (x.1, x.2, x.0)
}

struct Awesome {
    name: string
    age: i8

    func hello() {
        printf("Hello, %s", name)
    }

    func `init`(name: string, age: i8) {
        this.name = name
        this.age = age
    }
}

func main() {
    for i in 0..10 {
        printf("%d\n", i)
    }
}
