import { WebSocketClient, wsConnect } from "stdlib/ws.cxy"

class ClientApplication {
    channel: String
    count: i64 = 0
    client: WebSocketClient

    func `init`(channel: String) {
        this.channel = channel
    }

    func onOpen(client: WebSocketClient): bool => {
        println("[Cxy WS Client] Connected to channel: ", channel)
        println("[Cxy WS Client] Sending initial message...")
        client.send("Hello from Cxy WebSocketStream!") catch {
            println("[Cxy WS Client] Send failed: ", ex!.what())
            return false
        }

        this.client = &&client
        return true
    }

    func onMessage(msg: strview): void => {
        println("[Cxy WS Client] Received: ", msg)
        count++
        if (count < 10) {
            client.send(f"Client ping #{count}".s()) catch discard
        } else {
            println("[Cxy WS Client] Reached limit, closing...")
            client.close(1000, "Done") catch discard
        }
    }

    func onClose(code: u16, reason: strview): void => {
        println("[Cxy WS Client] Closed: code = ", code, " reason = ", reason)
    }
}

func main(): !void {
    var app = ClientApplication("chat".S)
    var client = wsConnect[ClientApplication]("ws://127.0.0.1:8004/wss", &app)
    client.listen()
}
