import "stdlib/json.cxy"

@json
struct User {
    @json(optional, b64)
    name: String? = null
    age: i64 = 0
    func `init`()  {}
}

func main(): !void {
    var s = String()
    var x = User{name: "The world".S, age: 42}
    json.toJSON(s, &x)
    var y = json.parse[User](s.__str())
    println(s, " Serialized: ", y)
}
