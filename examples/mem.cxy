func apply(x: i32, op: func(i32) -> i32): i32 {
    return op(x)
}

func invokeTwice(cb: func() -> void): void {
    cb()
    cb()
}

func main(): void {
    var factor = 3
    var res = apply(10, |factor|(x: i32) => x * factor)

    var count = 0
    invokeTwice(|&count|() => {
        count = count + 1
    })
}
