import { wssUpgrade, WebSocket } from "stdlib/ws.cxy"
import { Server, Request, Response, Config } from "stdlib/http.cxy"
import { Address } from "stdlib/net.cxy"

struct WsContext {
    count: i64 = 0
    func `init`() => {}
}

class WsApplication {
    channel: String

    func `init`(channel: String) {
        this.channel = channel
    }

    func onOpen(ws: &WebSocket[WsContext]): bool => {
        println("[WSS Server] onOpen: channel = ", channel, ", count = ", ws.context().count)
        return true
    }

    func onMessage(ws: &WebSocket[WsContext], msg: __string): void => {
        ws.context().count++
        println("[WSS Server] onMessage: count = ", ws.context().count, ", msg = ", msg)
        ws.send(msg) catch {
            println("[WSS Server] send failed: ", ex!.what())
        }
    }

    func onClose(ws: &WebSocket[WsContext], code: u16, reason: __string): void => {
        println("[WSS Server] onClose: count = ", ws.context().count, ", code = ", code, ", reason = ", reason)
    }
}

func main(): !void {
    var app = WsApplication("chat".S)
    var server = Server[](Config{address: Address("0.0.0.0", 8004)});
    server("GET /wss", |&app|(req: &const Request, resp: &Response) => {
        wssUpgrade(req, resp, app, WsContext())
    })
    server.start()
}
