// @TEST_ARGS: ~--without-builtins
// A module finalizer is the function the compiler made for the module's globals.
// A user function that only has `__fini` in its name is not one: it runs when it
// is called and not again at exit.
class Node {
    id: i32
    func `init`(id: i32) { this.id = id }
    func `deinit`() { println("node ", this.id, " destroyed") }
}

var shared = Node(1)

func __fini_cache() {
    println("user function ran")
}

func main(): void {
    println("main ", shared.id)
    __fini_cache()
}
