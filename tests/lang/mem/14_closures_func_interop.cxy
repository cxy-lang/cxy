func rawAdd(a: i32, b: i32): i32 {
    return a + b
}

func rawSay(): void { }

func executeOp(a: i32, b: i32, op: func(i32, i32) -> i32): i32 {
    return op(a, b)
}

func executeVoid(cb: func() -> void): void {
    cb()
}

func main(): void {
    var res = executeOp(10, 20, rawAdd)
    executeVoid(rawSay)
}
