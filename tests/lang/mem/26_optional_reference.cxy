class Resource {
    id: i32
    func `init`(id: i32) { this.id = id }
    func `deinit`() { }
}

struct Holder {
    res: Resource? = null
}

// An optional behind a reference is still an optional: it can be tested, and
// passing a field by reference must not copy (no refcount traffic).
func isSet[T](it: &const T): i32 {
    #if T.isOptional {
        if (it) {
            return 1
        }
        return 0
    }
    else {
        return 2
    }
}

func isSetConst(it: &(const Resource?)): i32 {
    if (it) {
        return 1
    }
    return 0
}

func main(): void {
    var full = Holder{res: Resource(1)}
    var empty = Holder{}
    isSet[Resource?](&full.res)
    isSet[Resource?](&empty.res)
    isSetConst(&full.res)
    isSetConst(&empty.res)
}
