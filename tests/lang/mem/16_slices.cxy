// Tests for slice expressions, reslicing, and slicing operator overloads

class Resource {
    id: i32
    func `init`(id: i32) { this.id = id }
    func `deinit`() { }
}

func testArraySlice(): void {
    var arr = [10.i32, 20, 30, 40, 50]
    var s1: [i32] = arr.[1..4]
    var s2: [i32] = arr.[2..]
    var s3: [i32] = arr.[..3]
    var s4: [i32] = arr.[..]
}

func testReslice(): void {
    var arr = [1.i32, 2, 3, 4, 5, 6]
    var s: [i32] = arr.[1..5]
    var sub: [i32] = s.[1..3]
}

struct Buffer {
    _data: ^i32
    _len: u64

    func `init`(data: ^i32, len: u64) {
        this._data = data
        this._len = len
    }

    func `[..]`(st: i32 = 0, e: i32? = null): [i32] {
        var end = e ?? _len as i32
        return slice!(ptroff!(_data + st), (end - st) as u64)
    }
}

func testCustomSliceOverload(): void {
    var raw: [i32, 5] = [100.i32, 200, 300, 400, 500]
    var buf = Buffer(ptrof raw.[0], 5)
    var s1 = buf.[1..4]
    var s2 = buf.[2..]
}

func testManagedArraySlice(): void {
    var arr = [Resource(1), Resource(2), Resource(3), Resource(4)]
    var s: [Resource] = arr.[1..3]
}

func main(): void {
    testArraySlice()
    testReslice()
    testCustomSliceOverload()
    testManagedArraySlice()
}
