// Every statement marked below takes a new owner without `@copy` or `&&`
class Node {
    id: i32
    func `init`(id: i32) { this.id = id }
    func `deinit`() {}
}

struct Holder {
    node: Node
}

func take(n: Node): i32 => n.id
func peek(n: &Node): i32 => n.id

func main(): void {
    var a = Node(1)
    var b = a
    take(a)
    var h = Holder{node: a}
}
