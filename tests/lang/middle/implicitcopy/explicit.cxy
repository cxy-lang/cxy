// Explicit `@copy`, `&&`, borrows and temporaries are not implicit copies
class Node {
    id: i32
    func `init`(id: i32) { this.id = id }
    func `deinit`() {}
}

struct Holder {
    node: Node
}

func take(n: Node): i32 => n.id
func peek(n: &Node): i32 => n.id
func make(): Node => Node(9)

func keep(): Node {
    var local = Node(5)
    return local
}

func main(): void {
    var a = Node(1)
    var b = @copy a
    var c = Node(2)
    var d = &&c
    take(@copy a)
    take(Node(3))
    take(make())
    peek(a)
    var h = Holder{node: @copy a}
    var k = keep()
}
