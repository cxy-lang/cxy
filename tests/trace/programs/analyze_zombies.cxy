import { Vector } from "stdlib/vector.cxy"
import { waitForHarness } from "./_harness.cxy"

class Node {
    id: i32
    func `init`(id: i32) { this.id = id }
    func `deinit`() { }
}

func main(): void {
    var weaks = Vector[Weak[Node]]()
    waitForHarness()
    // after the baseline: twelve nodes are destroyed, their weak references stay
    for i in 0..12 {
        var n = Node(i)
        weaks.push(Weak[Node](n))
    }
    waitForHarness()
}
