import { Vector } from "stdlib/vector.cxy"
import { waitForHarness } from "./_harness.cxy"

class Node {
    id: i32
    func `init`(id: i32) { this.id = id }
    func `deinit`() { }
}

func main(): void {
    var v = Vector[i32]()
    for i in 0..20 {
        v.push(i)
    }
    var a = Node(1)
    var b = Node(2)
    var c = Node(3)
    // a destroyed object that a weak reference keeps: a zombie
    var w = Weak[Node](c)
    c = Node(4)
    waitForHarness()
}
