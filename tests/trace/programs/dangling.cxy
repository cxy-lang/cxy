import { Vector } from "stdlib/vector.cxy"
import { waitForHarness } from "./_harness.cxy"

class Node {
    id: i32
    func `init`(id: i32) { this.id = id }
    func `deinit`() { }
}

// Owns an object and a container as well as the borrow: the scan walks all of it
class View {
    src: &Node
    owned: Node
    items: Vector[Node]
    func `init`(n: &Node) {
        this.src = n
        this.owned = Node(9)
        this.items = Vector[Node]()
        this.items.push(Node(10))
    }
}

func main(): void {
    var n = Node(1)
    var v = View(&n)
    waitForHarness()
    n = Node(2)
    waitForHarness()
}
