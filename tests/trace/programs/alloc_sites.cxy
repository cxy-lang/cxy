import { waitForHarness } from "./_harness.cxy"

class Node {
    id: i32
    func `init`(id: i32) { this.id = id }
    func `deinit`() { }
}

// An unmarked factory is charged to the line inside it
func make(id: i32): Node {
    return Node(id)
}

func generic[T](v: T) {
    var n = Node(1)
}

func main(): void {
    var a = Node(1)
    var b = Node(2)
    for i in 0..3 {
        var c = Node(i)
    }
    var d = make(4)
    generic[i32](5)
    waitForHarness()
}
