import "stdlib/thread.cxy"
import { Vector } from "stdlib/vector.cxy"
import { waitForHarness } from "./_harness.cxy"
import "unistd.h" as unistd

class Node {
    id: i32
    func `init`(id: i32) { this.id = id }
    func `deinit`() { }
}

var stop = false

// A worker that keeps a cache growing at a steady pace while the harness watches
func main(): !void {
    var worker = launch {
        var cache = Vector[Node]()
        var i = 0
        while !stop {
            cache.push(Node(i))
            i = i + 1
            unistd.usleep(1000)
        }
    }
    waitForHarness()
    stop = true
    worker.join()
}
