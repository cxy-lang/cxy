import { waitForHarness } from "./_harness.cxy"

class Node {
    id: i32
    func `init`(id: i32) { this.id = id }
    func `deinit`() { }
}

class View {
    src: &Node
    func `init`(n: &Node) { this.src = n }
}

func main(): void {
    var n = Node(1)
    waitForHarness()
    // after the baseline: a view borrows a node, then the node is replaced
    var view = View(&n)
    n = Node(2)
    waitForHarness()
}
