import "stdlib/thread.cxy"
import { waitForHarness } from "./_harness.cxy"

class Node {
    id: i32
    func `init`(id: i32) { this.id = id }
    func `deinit`() { }
}

// Objects allocated and freed on other threads: the totals must be exact
func main(): !void {
    var t1 = launch {
        var a = Node(1)
        var b = Node(2)
    }
    var t2 = launch {
        var c = Node(3)
        var d = Node(4)
        var e = Node(5)
    }
    t1.join()
    t2.join()
    var keep = Node(6)
    waitForHarness()
}
