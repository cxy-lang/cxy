func some(): !String? => "Hello".S
func none(): !String? => null

// `r ?? null` for a `!T?` call is `r ? *r : null`: the payload is taken once. The
// value reaches the variable (not freed before the branch), the other is null, and
// the exit report is empty.
func main(): !void {
    var a: String = some() ?? null
    var b: String = none() ?? null
    println("a null: ", a == null, " b null: ", b == null)
    println("a = ", a.s())
}
