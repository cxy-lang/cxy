import { waitForHarness } from "./_harness.cxy"

class Node {
    id: i32
    next: Node
    func `init`(id: i32) { this.id = id }
    func `deinit`() { }
}

var registry: Node

// Two nodes that own each other and nothing else: a leaked cycle
func leakCycle(): void {
    var a = Node(10)
    var b = Node(11)
    a.next = @copy b
    b.next = @copy a
}

func main(): void {
    registry = Node(1)
    registry.next = Node(2)
    waitForHarness()
    // after the mark: a leaked cycle and an object only the stack owns
    leakCycle()
    var held = Node(3)
    waitForHarness()
}
