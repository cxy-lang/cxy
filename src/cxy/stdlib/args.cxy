module args

import { Vector }  from "./vector.cxy"
import { HashMap } from "./hash.cxy"
import { getenv }  from "./os.cxy"

import test { setenv, unsetenv } from "./os.cxy"
// Basic exceptions
exception ParseError(msg: String) => msg != null? msg.str() : ""

pub exception ValidationError(msg: String) => msg != null? msg.str() : ""

// Only __string values are accumulated for repeatable flags (both the
// list form used today, and a possible future "key=value" map form).
pub type FlagValue = __string | bool | i64 | Vector[__string] | HashMap[__string, __string]

// Flag group types
pub enum FlagGroupType {
    MutuallyExclusive,
    RequiredTogether
}

// Flag group for validation
pub struct FlagGroup {
    name: __string
    flags = Vector[__string]()
    groupType: FlagGroupType = .MutuallyExclusive
    required: bool = false

    func `init`(name: __string, groupType: FlagGroupType) {
        this.name = name
        this.groupType = groupType
    }

    func `str`(@unused os: &OutputStream) { }

    @static
    func mutuallyExclusive(name: __string, a: __string, b: __string, ...args: __string): This {
        var group = This(name, FlagGroupType.MutuallyExclusive)
        group.flags.push(a)
        group.flags.push(b)
        #for arg in args {
            group.flags.push(#{arg})
        }
        return &&group
    }
}

// Simple flag definition
pub struct Flag {
    name: __string
    shorthand: char = '\0'
    usage: __string
    defaultValue: FlagValue
    required = false
    envVar = __string()
    // Terminal flags (like --help) short-circuit validation (flag groups,
    // positional args, required subcommand) and signal the caller should
    // handle the request itself instead of executing the command's action.
    terminal = false
    // Repeatable flags (e.g. `--param p1 --param p2=100`) accumulate every
    // occurrence instead of overwriting the previous one. Only supported
    // for string flags - read them back with FlagValues.getList
    // instead of getString.
    multiple = false
    // Map-valued flags accept entries via `--name:key value` (or
    // `--name:key=value`), e.g. `--params:a 1 --params:b 2` builds
    // {a: "1", b: "2"}. Only supported for string flags - read them back
    // with FlagValues.getMap instead of getString.
    isMap = false

    func `init`(name: __string, usage: __string, defaultValue: __string = "".s) {
        this.name = name
        this.usage = usage
        this.defaultValue = defaultValue
    }

    func `init`(name: __string, usage: __string, defaultValue: __string, envVar: __string) {
        this.name = name
        this.usage = usage
        this.defaultValue = defaultValue
        this.envVar = envVar
    }

    func `init`(name: __string, shorthand: char, usage: __string, defaultValue: __string = "".s) {
        this.name = name
        this.shorthand = shorthand
        this.usage = usage
        this.defaultValue = defaultValue
    }

    func `init`(name: __string, shorthand: char, usage: __string, defaultValue: __string, envVar: __string) {
        this.name = name
        this.shorthand = shorthand
        this.usage = usage
        this.defaultValue = defaultValue
        this.envVar = envVar
    }

    func `init`(name: __string, usage: __string, defaultValue: bool = false) {
        this.name = name
        this.usage = usage
        this.defaultValue = defaultValue
    }

    func `init`(name: __string, usage: __string, defaultValue: bool, envVar: __string) {
        this.name = name
        this.usage = usage
        this.defaultValue = defaultValue
        this.envVar = envVar
    }

    func `init`(name: __string, shorthand: char, usage: __string, defaultValue: bool = false) {
        this.name = name
        this.shorthand = shorthand
        this.usage = usage
        this.defaultValue = defaultValue
    }

    func `init`(name: __string, shorthand: char, usage: __string, defaultValue: bool, envVar: __string) {
        this.name = name
        this.shorthand = shorthand
        this.usage = usage
        this.defaultValue = defaultValue
        this.envVar = envVar
    }

    func `init`(name: __string, usage: __string, defaultValue: i64 = 0) {
        this.name = name
        this.usage = usage
        this.defaultValue = defaultValue
    }

    func `init`(name: __string, usage: __string, defaultValue: i64, envVar: __string) {
        this.name = name
        this.usage = usage
        this.defaultValue = defaultValue
        this.envVar = envVar
    }

    func `init`(name: __string, shorthand: char, usage: __string, defaultValue: i64 = 0) {
        this.name = name
        this.shorthand = shorthand
        this.usage = usage
        this.defaultValue = defaultValue
    }

    func `init`(name: __string, shorthand: char, usage: __string, defaultValue: i64, envVar: __string) {
        this.name = name
        this.shorthand = shorthand
        this.usage = usage
        this.defaultValue = defaultValue
        this.envVar = envVar
    }

    @private
    func `init`(name: __string, shorthand: char, usage: __string, defaultValue: FlagValue) {
        this.name = name
        this.shorthand = shorthand
        this.usage = usage
        this.defaultValue = &&defaultValue
    }

    @static func map(name: __string, usage: __string): This {
        var flag = This(name, '\0', usage, HashMap[__string, __string]())
        flag.isMap = true
        return &&flag
    }

    @static func list(name: __string, usage: __string): This {
        var flag = This(name, '\0', usage, Vector[__string]())
        flag.multiple = true
        return &&flag
    }
}

// Declared positional argument (validated after parsing, shown in help)
pub struct PositionalArg {
    name: __string
    usage: __string
    required: bool = true
    variadic: bool = false
    defaultValue = __string()

    func `init`(name: __string, usage: __string, required: bool = true, variadic: bool = false) {
        this.name = name
        this.usage = usage
        this.required = required
        this.variadic = variadic
    }

    // Declaring a default value implies the argument is optional
    func `init`(name: __string, usage: __string, defaultValue: __string) {
        this.name = name
        this.usage = usage
        this.required = false
        this.defaultValue = defaultValue
    }
}

// Storage for parsed flag values
pub struct FlagValues {
    values = HashMap[__string, FlagValue]()
    func set(name: __string, value: FlagValue): void {
        values.[name] = &&value
    }

    // Append a value for a repeatable flag instead of overwriting it.
    func append(name: __string, value: __string): void {
        var existing = values.[name]
        if existing {
            match (*existing) {
                Vector[__string] as list => list.push(value)
                ... => {}
            }
        } else {
            var list = Vector[__string]()
            list.push(value)
            values.[__copy!(name)] = &&list
        }
    }

    @inline
    func has(name: __string) => values.contains(name)

    // Number of values recorded for a repeatable flag (0 if never set).
    func count(name: __string): u64 {
        var val = values.[name]
        if val {
            match (*val) {
                Vector[__string] as list => return list.size()
                ... => {}
            }
        }
        return 0
    }

    // Read back all values recorded for a repeatable flag, or null if the
    // flag was never set.
    func getList(name: __string): Vector[__string] {
        var val = values.[name]
        if val {
            match (*val) {
                Vector[__string] as list => return list
                ... => {}
            }
        }
        return null
    }

    // Set an entry for a map-valued flag instead of overwriting the whole
    // flag value.
    func set(name: __string, key: __string, value: __string): void {
        var existing = values.[name]
        if existing {
            match (*existing) {
                HashMap[__string, __string] as m => m.[key] = value
                ... => {}
            }
        } else {
            var m = HashMap[__string, __string]()
            m.[key] = value
            values.[__copy!(name)] = &&m
        }
    }

    // Read back all entries recorded for a map-valued flag, or null if the
    // flag was never set.
    func getMap(name: __string): HashMap[__string, __string] {
        var val = values.[name]
        if val {
            match (*val) {
                HashMap[__string, __string] as m => return m
                ... => {}
            }
        }
        return null
    }

    func getString(name: __string): __string {
        var val = values.[name]
        if (val) {
            match (*val) {
                __string as s => return s
                ... => return __string()
            }
        }
        return __string()
    }

    func getBool(name: __string): bool {
        var val = values.[name]
        if (val) {
            match (*val) {
                bool as b => return b
                ... => return false
            }
        }
        return false
    }

    func getInt(name: __string): i64 {
        var val = values.[name]
        if (val) {
            match (*val) {
                i64 as i => return i
                ... => return 0
            }
        }
        return 0
    }
}

// Simple command definition
pub class Command {
    name: __string
    description: __string
    version = __string()
    flags = HashMap[__string, Flag]()
    flagsByShorthand = HashMap[char, __string]()
    flagValues = FlagValues{}
    args = Vector[__string]()
    positionalArgs = Vector[PositionalArg]()

    // Hierarchical command structure
    parent: &This? = null
    commands = HashMap[__string, Command]()

    // Persistent flags (inherited by subcommands)
    persistentFlags = HashMap[__string, Flag]()
    persistentFlagsByShorthand = HashMap[char, __string]()

    // Flag groups for validation
    flagGroups = Vector[FlagGroup]()
    type Handler = func(cmd: &This) -> i32
    // Action handler for this command
    action: Handler = null

    func `init`(name: __string, description: __string) {
        this.name = name
        this.description = description
    }

    // Set the action handler for this command
    func setAction(@escaping handler: Handler): void {
        action = &&handler
    }

    // Execute this command's action or show help if no action
    func execute(): i32 {
        if action != null {
            return action(this)
        } else {
            help(&stdout)
            return 0
        }
    }

    // Repeatable flags (multiple = true) only make sense for string flags
    @private
    func checkFlagModifiers(flag: &Flag): !void {
        if flag.multiple && flag.isMap {
            raise ParseError(f"flag '{flag.name}' cannot be both multiple and map")
        }
        if flag.multiple {
            match (flag.defaultValue) {
                Vector[__string] as _ => {}
                ... => raise ParseError(f"flag '{flag.name}' is marked multiple but only list flags support that")
            }
        }
        if flag.isMap {
            match (flag.defaultValue) {
                HashMap[__string, __string] as _ => {}
                ... => raise ParseError(f"flag '{flag.name}' is marked map but only map flags support that")
            }
        }
    }

    // Add a flag to this command
    func addFlag(flag: Flag): !void {
        if flags.contains(flag.name) {
            raise ParseError(f"flag '{flag.name}' already exists")
        }
        if flag.shorthand != '\0' && flagsByShorthand.contains(flag.shorthand) {
            raise ParseError(f"shorthand '{flag.shorthand}' already exists")
        }
        checkFlagModifiers(&flag)
        if flag.shorthand != '\0' {
            flagsByShorthand.[flag.shorthand] = flag.name
        }
        flags.[flag.name] = &&flag
    }

    @inline
    func addFlag(name: __string, shorthand: char, def: __string, help: __string): !void {
        addFlag(Flag(name, shorthand, def, help))
    }

    @inline
    func addFlag(name: __string, shorthand: char, def: __string, help: __string, envVar: __string): !void {
        addFlag(Flag(name, shorthand, def, help, envVar))
    }

    @inline
    func add[T, Opts](name: __string, help: __string, def: __string, @unused opts: Opts): !void {
        require!(T.isStruct, "conf must be a struct")
        #if #T == #Flag {
            var flag = Flag(name, '\0', help, def)
            #if (has_member!(#Opts, "shorthand", #__string)) {
                flag.shorthand = opts.shorthand
            }
            #if (has_member!(#Opts, "env", #__string)) {
                flag.envVar = opts.env
            }
            #if (has_member!(#Opts, "required", #bool)) {
                flag.required = opts.required
            }
            #if (has_member!(#Opts, "persistent", #bool)) {
                if opts.persistent {
                    addPersistentFlag(&&flag)
                }
                else {
                    addFlag(&&flag)
                }
            }
            else {
                addFlag(&&flag)
            }
        }
        else {
            error!("type must be Flag, got {t}", #T)
        }
    }

    // Find flag by shorthand character
    @private
    func findFlagByShorthand(shorthand: char): &Flag? {
        // First check local flags
        var flagName = flagsByShorthand.[shorthand]
        if flagName {
            var name = *flagName
            return flags.[__copy!(name)]
        }

        // Then check persistent flags
        var persistentFlagName = persistentFlagsByShorthand.[shorthand]
        if persistentFlagName {
            var name = *persistentFlagName
            return persistentFlags.[__copy!(name)]
        }

        return null
    }

    // Add a persistent flag (inherited by subcommands)
    func addPersistentFlag(flag: Flag): !void {
        if persistentFlags.contains(flag.name) {
            raise ParseError(f"persistent flag '{flag.name}' already exists")
        }
        if flag.shorthand != '\0' && persistentFlagsByShorthand.contains(flag.shorthand) {
            raise ParseError(f"persistent shorthand '{flag.shorthand}' already exists")
        }
        checkFlagModifiers(&flag)

        if flag.shorthand != '\0' {
            persistentFlagsByShorthand.[flag.shorthand] = flag.name
        }
        persistentFlags.[flag.name] = &&flag
    }

    // Add a persistent, terminal "--version" flag. Like --help, this bypasses
    // validation (flag groups, positional args, required subcommand) so the
    // caller can print the version and exit instead of running any action.
    func addVersionFlag(version: __string, shorthand: char = '\0'): !void {
        this.version = version
        var flag = Flag("version", shorthand, "Show version information", false)
        flag.terminal = true
        addPersistentFlag(flag)
    }

    // Write "<name> <version>" to the given stream
    func printVersion(os: &OutputStream): void {
        os << name << " " << version << "\n"
    }

    // Declare a positional argument for this command. Required arguments must
    // be declared before optional ones, and a variadic argument (captures all
    // remaining values) must be the last one declared.
    func addArg(arg: PositionalArg): !void {
        var hasVariadic = false
        var hasOptional = false
        for existing, _ : positionalArgs {
            if existing.name == arg.name {
                raise ParseError(f"positional argument '{arg.name}' already exists")
            }
            if existing.variadic {
                hasVariadic = true
            }
            if !existing.required {
                hasOptional = true
            }
        }
        if hasVariadic {
            raise ParseError(f"cannot add positional argument '{arg.name}' after a variadic argument")
        }
        if hasOptional && arg.required {
            raise ParseError(f"required positional argument '{arg.name}' cannot follow an optional argument")
        }
        positionalArgs.push(arg)
    }

    // Add a subcommand to this command
    func addCommand(cmd: Command): !void {
        if commands.contains(cmd.name) {
            raise ParseError(f"command '{cmd.name}' already exists")
        }
        cmd.parent = this

        // Inherit persistent flags from parent. Re-registering them as
        // persistent (not local) on the child ensures they keep propagating
        // to grandchildren when the child later adds its own subcommands.
        for (const _, flag: persistentFlags) {
            cmd.addPersistentFlag(flag) catch discard  // Ignore conflicts
        }

        commands.[cmd.name] = &&cmd
    }

    // Add flag group for validation
    func addFlagGroup(group: FlagGroup): void {
        flagGroups.push(group)
    }

    // Find subcommand by name
    @private
    func findCommand(name: __string): This {
        var cmd = commands.[name]
        if cmd {
            var tmp = *cmd
            return __copy!(tmp)
        }
        return null
    }

    // Check if any terminal flag (local or persistent) was set, e.g. --help
    // or a user-declared --version. Terminal flags bypass validation and
    // signal that the caller should handle the request instead of running
    // the command's action.
    @private
    func hasTerminalFlagSet(): bool {
        for (const _, flag: flags) {
            if flag.terminal && flagValues.getBool(flag.name) {
                return true
            }
        }
        for (const _, flag: persistentFlags) {
            if flag.terminal && flagValues.getBool(flag.name) {
                return true
            }
        }
        return false
    }

    // Check if string looks like a boolean value
    @private
    func isBooleanValue(s: __string): bool {
        return s == "true" || s == "false" || s == "1" || s == "0"
    }

    // Parse integer from string
    @private
    func parseInt(s: __string): i64? {
        if s.empty() { return null }

        var result = 0`i64
        var negative = false
        var start = 0

        if s.[0] == '-' {
            negative = true
            start = 1
        }

        for i : start..s.size() {
            var c = s.[i]
            if c < '0' || c > '9' {
                return null
            }
            result = result * 10 + (c - '0')
        }

        return negative ? -result : result
    }

    // Parse command line arguments with subcommand support
    // Returns (finalCommand, shouldExecute) - finalCommand is null if error
    func parse(argv: [string]): !(This, bool) {
        var i = 0 as i64
        while (i < len!(argv)) {
            var arg = __string(argv.[i]);

            // Check for subcommands before treating as positional args
            if !arg.startswith("-") {
                var subCmd = findCommand(arg)
                if subCmd {
                    // Copy already-parsed persistent flag values to subcommand
                    for (const name, value: flagValues.values) {
                        if persistentFlags.contains(name) {
                            subCmd.flagValues.values.[name] = value
                        }
                    }

                    // Parse subcommand with remaining args
                    var remaining = Vector[string]()
                    for (j : (i + 1)..len!(argv)) {
                        remaining.push(argv.[j])
                    }
                    var remainingArray = slice!(remaining.data(), remaining.size())
                    return subCmd.parse(remainingArray)
                } else {
                    // Not a subcommand, store as positional arg
                    args.push(arg)
                    i++
                    continue
                }
            }

            // Handle long flags (--flag)
            if arg.startswith("--") {
                i = parseLongFlagArg(argv, i)
                continue
            }

            // Handle short flags (-f)
            if arg.size() > 1 {
                i = parseShortFlagArg(argv, i)
                continue
            }

            // Single dash is treated as positional argument
            args.push(arg)
            i++
        }

        // Apply environment variable values for flags not set by command line
        applyEnvVars()

        // Check if a terminal flag (e.g. --help, --version) was requested
        // before validating, so it isn't blocked by missing required
        // flags/arguments or a missing subcommand
        if hasTerminalFlagSet() {
            return (__copy!(this), false)  // Don't execute, let the caller handle it
        }

        // If this command has subcommands, one must have been invoked above
        // (which returns early). Otherwise it's an error.
        if !commands.empty() {
            raise ParseError(f"'{name}' requires a subcommand")
        }

        // Fill in defaults for optional positional args not provided
        applyPositionalArgs()

        // Ensure required flags were provided before filling in defaults
        validateRequiredFlags()

        // Validate flag groups before filling in defaults so defaults don't trigger conflicts
        validateFlagGroups()

        // Fill in default values for flags not set via command line or env var
        applyFlagDefaults()

        // Validate declared positional arguments
        validatePositionalArgs()

        return (__copy!(this), true)  // Execute this command
    }

    // Parse long flag arguments
    @private
    func parseLongFlagArg(argv: [string], index: i64): !i64 {
        var arg = __string(argv.[index]);

        // Parse --flag=value format
        var eqPos = arg.indexOf('=')
        if eqPos {
            var flagName = arg.substr(2, <i64>*eqPos - 2)
            var flagValue = arg.substr(*eqPos + 1);
            parseLongFlag(flagName, flagValue, true)
            return index + 1
        }

        // Parse --flag format (value might be next arg)
        var flagName = arg.substr(2)
        var flagValue = __string()
        var hasValue = false

        // Check if next arg is the value (not another flag)
        if (index + 1 < len!(argv)) {
            var nextArg = __string(argv.[index + 1])
            if !nextArg.startswith("-") {
                // Only treat as value if this flag type requires a value.
                // Look up by the base name, stripping any ":key" suffix
                // used for map-valued flags (e.g. "params:a" -> "params").
                var baseName = baseFlagName(flagName)
                var flag = flags.[baseName]
                if !flag {
                    flag = persistentFlags.[baseName]
                }
                if flag {
                    if flag&.isMap {
                        // Map entries (--name:key value) always consume
                        // the next arg as a raw string value.
                        flagValue = nextArg
                        hasValue = true
                        parseLongFlag(flagName, flagValue, hasValue)
                        return index + 2
                    }
                    match (flag&.defaultValue) {
                        bool as _ => {
                            // Check if next arg is a boolean value
                            if isBooleanValue(nextArg) {
                                flagValue = nextArg
                                hasValue = true
                                parseLongFlag(flagName, flagValue, hasValue)
                                return index + 2  // Skip both flag and value
                            } else {
                                // Not a boolean, don't consume next arg
                                parseLongFlag(flagName, flagValue, hasValue)
                                return index + 1  // Just skip the flag
                            }
                        }
                        ... => {
                            // String/int flags do consume next arg as value
                            flagValue = nextArg
                            hasValue = true
                            parseLongFlag(flagName, flagValue, hasValue)
                            return index + 2  // Skip both flag and value
                        }
                    }
                }
            }
        }

        parseLongFlag(flagName, flagValue, hasValue)
        return index + 1
    }

    // Parse short flag arguments
    @private
    func parseShortFlagArg(argv: [string], index: i64): !i64 {
        var arg = __string(argv.[index])
        var flags_str = arg.substr(1) // Skip the -

        // Handle single short flag with potential attached value: -fvalue
        if flags_str.size() == 1 {
            var shorthand = flags_str.[0]
            var flag = findFlagByShorthand(shorthand)
            if !flag {
                raise ParseError(f"unknown shorthand flag: -{shorthand}")
            }

            return parseShortFlag(argv, index, *flag)
        }

        // Handle multiple short flags: -abc
        for i : 0..flags_str.size() {
            var shorthand = flags_str.[i]
            var flag = findFlagByShorthand(shorthand)
            if !flag {
                raise ParseError(f"unknown shorthand flag: -{shorthand}")
            }

            // For boolean flags, just set to true
            match (flag&.defaultValue) {
                bool as _ => {
                    flagValues.set(flag&.name, true)
                }
                ... => {
                    // Non-boolean flags in group need special handling
                    if i < flags_str.size() - 1 {
                        raise ParseError(f"flag -{shorthand} requires a value but is in a group")
                    }
                    // Last flag in group can have a value
                    return parseShortFlag(argv, index, *flag)
                }
            }
        }

        return index + 1
    }

    // Parse individual short flag
    @private
    func parseShortFlag(argv: [string], index: i64, flag: &Flag): !i64 {
        var flagValue = __string()
        var hasValue = false

        // Check if next arg is the value (not another flag)
        if (index + 1 < len!(argv)) {
            var nextArg = __string(argv.[index + 1])
            if !nextArg.startswith("-") {
                match (flag.defaultValue) {
                    bool as _ => {
                        // Check if next arg is a boolean value
                        if isBooleanValue(nextArg) {
                            flagValue = nextArg
                            hasValue = true
                            parseLongFlag(flag.name, flagValue, hasValue)
                            return index + 2
                        } else {
                            // Not a boolean, don't consume next arg
                            parseLongFlag(flag.name, flagValue, hasValue)
                            return index + 1
                        }
                    }
                    ... => {
                        // String/int flags do consume next arg as value
                        flagValue = nextArg
                        hasValue = true
                        parseLongFlag(flag.name, flagValue, hasValue)
                        return index + 2
                    }
                }
            }
        }

        parseLongFlag(flag.name, flagValue, hasValue)
        return index + 1
    }

    // Parse a single long flag
    // Strip a ":key" suffix (used for map-valued flags) from a flag name,
    // e.g. "params:a" -> "params". Returns the name unchanged if there's
    // no colon.
    @private
    func baseFlagName(flagName: __string): __string {
        var colonPos = flagName.indexOf(':')
        if colonPos {
            return flagName.substr(0, <i64>*colonPos)
        }
        return flagName
    }

    @private
    func parseLongFlag(flagName: __string, flagValue: __string, hasValue: bool): !void {
        // Map entry syntax: --name:key (value) / --name:key=value
        var colonPos = flagName.indexOf(':')
        if colonPos {
            var baseName = flagName.substr(0, <i64>*colonPos)
            var key = flagName.substr(<i64>*colonPos + 1)
            var flag = flags.[baseName]
            if !flag {
                flag = persistentFlags.[baseName]
            }
            if !flag {
                raise ParseError(f"unknown flag: --{baseName}")
            }
            if !flag&.isMap {
                raise ParseError(f"flag '--{baseName}' does not support ':key' syntax")
            }
            flagValues.set(baseName, key, flagValue)
            return
        }

        // Check local flags first, then persistent flags
        var flag = flags.[flagName]
        if !flag {
            flag = persistentFlags.[flagName]
        }
        if !flag {
            raise ParseError(f"unknown flag: --{flagName}")
        }
        // Handle different flag types
        match (flag&.defaultValue) {
            bool as _ => {
                if hasValue {
                    if flagValue == "true" || flagValue == "1" {
                        flagValues.set(flagName, true)
                    } else if flagValue == "false" || flagValue == "0" {
                        flagValues.set(flagName, false)
                    } else {
                        raise ParseError(f"invalid boolean value for --{flagName}: {flagValue}")
                    }
                } else {
                    // Boolean flag without value defaults to true
                    flagValues.set(flagName, true)
                }
            }
            i64 as _ => {
                if !hasValue {
                    raise ParseError(f"flag --{flagName} requires a value")
                }
                var intVal = parseInt(flagValue)
                if !intVal {
                    raise ParseError(f"invalid integer value for --{flagName}: {flagValue}")
                }
                flagValues.set(flagName, *intVal)
            }
            __string as _ => {
                if !hasValue {
                    raise ParseError(f"flag --{flagName} requires a value")
                }
                if flag&.multiple {
                    flagValues.append(flagName, flagValue)
                } else {
                    flagValues.set(flagName, flagValue)
                }
            }
            Vector[__string] as _ => {
                if !hasValue {
                    raise ParseError(f"flag --{flagName} requires a value")
                }
                flagValues.append(flagName, flagValue)
            }
            ... => {
                raise ParseError(f"flag --{flagName} is invalid")
            }
        }
    }

    // Enhanced help generation with subcommands
    func help(os: &OutputStream): void {
        os << description << "\n\n"

        // Usage line
        os << "Usage: " << name << " [flags]"
        if !commands.empty() {
            os << " [command]"
        }
        for arg, _ : positionalArgs {
            os << " "
            if arg.required {
                os << "<" << arg.name
            } else {
                os << "[" << arg.name
            }
            if arg.variadic {
                os << "..."
            }
            if arg.required {
                os << ">"
            } else {
                os << "]"
            }
        }
        os << "\n"

        // Positional arguments
        if !positionalArgs.empty() {
            os << "\nArguments:\n"

            var maxArgLen = 0 as u64
            for arg, _ : positionalArgs {
                if arg.name.size() > maxArgLen {
                    maxArgLen = arg.name.size()
                }
            }
            var argPadWidth = maxArgLen + 4

            for arg, _ : positionalArgs {
                os << "  " << arg.name
                var padding = argPadWidth - arg.name.size()
                for i : 0..padding {
                    os << " "
                }
                os << arg.usage
                if !arg.required {
                    os << " (optional)"
                }
                os << "\n"
            }
        }

        // Available commands
        if !commands.empty() {
            os << "\nAvailable Commands:\n"

            // Find longest command name for alignment
            var maxCmdLen = 0 as u64
            for (const _, cmd: commands) {
                if cmd.name.size() > maxCmdLen {
                    maxCmdLen = cmd.name.size()
                }
            }
            var cmdPadWidth = maxCmdLen + 4  // Add 4 spaces buffer

            for (const _, cmd: commands) {
                os << "  " << cmd.name
                var padding = cmdPadWidth - cmd.name.size()
                for i : 0..padding {
                    os << " "
                }
                os << cmd.description << "\n"
            }
        }

        // Flags
        var hasLocalFlags = !flags.empty()
        var hasPersistentFlags = !persistentFlags.empty()

        if hasLocalFlags || hasPersistentFlags {
            os << "\nFlags:\n"

            // Find longest flag name for alignment
            var maxFlagLen = 0 as u64
            for (const _, flag: flags) {
                var flagLen = flag.name.size() + 2  // +2 for "--"
                if flagLen > maxFlagLen {
                    maxFlagLen = flagLen
                }
            }
            for (const _, flag: persistentFlags) {
                var flagLen = flag.name.size() + 2  // +2 for "--"
                if flagLen > maxFlagLen {
                    maxFlagLen = flagLen
                }
            }
            var flagPadWidth = maxFlagLen + 4  // Add 4 spaces buffer

            // Show local flags first
            for (const _, flag: flags) {
                os << "  --" << flag.name
                var padding = flagPadWidth - (flag.name.size() + 2)
                for i : 0..padding {
                    os << " "
                }
                os << flag.usage
                if flag.multiple {
                    os << " (can be repeated)"
                } else if flag.isMap {
                    os << " (use --" << flag.name << ":key value, can be repeated)"
                }
                os << "\n"
            }

            // Show persistent flags
            for (const _, flag: persistentFlags) {
                os << "  --" << flag.name
                var padding = flagPadWidth - (flag.name.size() + 2)
                for i : 0..padding {
                    os << " "
                }
                os << flag.usage
                if flag.multiple {
                    os << " (can be repeated)"
                } else if flag.isMap {
                    os << " (use --" << flag.name << ":key value, can be repeated)"
                }
                os << "\n"
            }
        }

        // Help footer
        if !commands.empty() {
            os << "\nUse \"" << name << " [command] --help\" for more information about a command.\n"
        }
    }

    // Validate flag groups for mutual exclusion and required together
    @private
    func validateFlagGroups(): !void {
        for group, _ : flagGroups {
            var setFlags = Vector[__string]()

            // Find which flags in this group are set
            for flagName, _ : group.flags {
                if flagValues.has(flagName.str()) {
                    setFlags.push(flagName.str())
                }
            }

            switch (group.groupType) {
                .MutuallyExclusive => {
                    if setFlags.size() > 1 {
                        raise ValidationError(f"flags in group '{group.name}' are mutually exclusive: {setFlags.[0]}, {setFlags.[1]}")
                    }
                }
                .RequiredTogether => {
                    if setFlags.size() > 0 && setFlags.size() != group.flags.size() {
                        var missing = Vector[__string]()
                        for flagName, _ : group.flags {
                            if !flagValues.has(flagName.str()) {
                                missing.push(flagName.str())
                            }
                        }
                        raise ValidationError(f"flag group '{group.name}' requires all flags to be provided together, missing: {missing.[0]}")
                    }
                }
            }

            // Check if required group is satisfied
            if group.required && setFlags.empty() {
                raise ValidationError(f"required flag group '{group.name}' must have at least one flag set")
            }
        }
    }

    // Ensure every flag marked required was actually provided, either on the
    // command line or via its bound environment variable. Must run before
    // applyFlagDefaults(), otherwise every flag would appear "set" once its
    // default is filled in and this check would never fire.
    @private
    func validateRequiredFlags(): !void {
        for (const _, flag: flags) {
            if flag.required && !flagValues.has(flag.name) {
                raise ValidationError(f"required flag not provided: --{flag.name}")
            }
        }
        for (const _, flag: persistentFlags) {
            if flag.required && !flagValues.has(flag.name) {
                raise ValidationError(f"required flag not provided: --{flag.name}")
            }
        }
    }

    // Fill in a single flag's registered default value if it wasn't set via
    // the command line or an environment variable. Only scalar flag types
    // have a meaningful default here - list/map flags are left unset so
    // getList/getMap correctly report null when never provided.
    @private
    func applyFlagDefault(flag: Flag): void {
        if flagValues.has(flag.name) {
            return
        }
        match (flag.defaultValue) {
            bool as b => flagValues.set(flag.name, b)
            i64 as iv => flagValues.set(flag.name, iv)
            __string as s => flagValues.set(flag.name, s)
            ... => {}
        }
    }

    // Fill in default values for flags not set via command line or env var
    @private
    func applyFlagDefaults(): void {
        for (const _, flag: flags) {
            applyFlagDefault(flag)
        }
        for (const _, flag: persistentFlags) {
            applyFlagDefault(flag)
        }
    }

    // Fill in default values for optional positional args that weren't provided
    @private
    func applyPositionalArgs(): void {
        if positionalArgs.empty() {
            return
        }

        var i = 0 as u64
        for arg, _ : positionalArgs {
            if !arg.required && !arg.variadic && i >= args.size() && !arg.defaultValue.empty() {
                args.push(arg.defaultValue)
            }
            i++
        }
    }

    // Validate declared positional arguments after parsing
    @private
    func validatePositionalArgs(): !void {
        if positionalArgs.empty() {
            return
        }

        var provided = args.size()
        var declared = 0 as u64
        var variadic = false

        for arg, _ : positionalArgs {
            if arg.required && declared >= provided {
                raise ValidationError(f"missing required argument: {arg.name}")
            }
            variadic = arg.variadic
            declared++
        }

        if !variadic && provided > declared {
            raise ValidationError(f"too many arguments: expected at most {declared}, got {provided}")
        }
    }

    // Apply environment variable values for flags not explicitly set
    @private
    func applyEnvVars(): void {
        // Check local flags
        for (const _, flag: flags) {
            if !flag.envVar.empty() && !flagValues.has(flag.name) {
                var envValue = getenv(flag.envVar.str(), "") catch __string()
                if !envValue.empty() {
                    parseEnvValue(flag, envValue) catch discard
                }
            }
        }

        // Check persistent flags
        for (const _, flag: persistentFlags) {
            if !flag.envVar.empty() && !flagValues.has(flag.name) {
                var envValue = getenv(flag.envVar.str(), "") catch __string()
                if !envValue.empty() {
                    parseEnvValue(flag, envValue) catch discard
                }
            }
        }
    }

    // Parse environment variable value according to flag type
    @private
    func parseEnvValue(flag: Flag, envValue: __string): !void {
        match (flag.defaultValue) {
            bool as _ => {
                if envValue == "true" || envValue == "1" || envValue == "yes" {
                    flagValues.set(flag.name, true)
                } else if envValue == "false" || envValue == "0" || envValue == "no" {
                    flagValues.set(flag.name, false)
                } else {
                    raise ValidationError(f"invalid boolean value for env var {flag.envVar}: {envValue}")
                }
            }
            i64 as _ => {
                var intVal = parseInt(envValue)
                if !intVal {
                    raise ValidationError(f"invalid integer value for env var {flag.envVar}: {envValue}")
                }
                flagValues.set(flag.name, *intVal)
            }
            __string as _ => flagValues.set(flag.name, envValue)
        }
    }
}

// Module level tests
test "Flag creation and storage" {
    var stringFlag = Flag("name", "Service name", "default".s)
    ok!(stringFlag.name == "name")
    ok!(stringFlag.usage == "Service name")

    var boolFlag = Flag("verbose", "Enable verbose output", false)
    ok!(boolFlag.name == "verbose")

    var intFlag = Flag("port", "Port number", 8080 as i64)
    ok!(intFlag.name == "port")
}

test "FlagValues type safety" {
    var values = FlagValues{}
    values.set("str", "hello".s)
    values.set("bool", true)
    values.set("int", 42 as i64)

    ok!(values.getString("str") == "hello")
    ok!(values.getBool("bool") == true)
    ok!(values.getInt("int") == 42)

    // Type mismatches return defaults
    ok!(values.getString("bool") == __string())
    ok!(values.getBool("str") == false)
    ok!(values.getInt("str") == 0)
}

test "Command flag parsing --flag=value" {
    var cmd = Command("test", "Test command")
    cmd.addFlag(Flag("verbose", "Enable verbose", false)) catch discard
    cmd.addFlag(Flag("port", "Port number", 8080)) catch discard
    cmd.addFlag(Flag("name", "Service name", "default".s)) catch discard

    var args = ["--verbose=true", "--port=9000", "--name=myservice"]
    cmd.parse(args) catch discard

    ok!(cmd.flagValues.getBool("verbose") == true)
    ok!(cmd.flagValues.getInt("port") == 9000)
    ok!(cmd.flagValues.getString("name") == "myservice")
}

test "Command flag parsing --flag value" {
    var cmd = Command("test", "Test command")
    cmd.addFlag(Flag("verbose", "Enable verbose", false)) catch discard
    cmd.addFlag(Flag("count", "Item count", 10)) catch discard

    var args = ["--verbose", "--count", "25"]
    cmd.parse(args) catch discard

    ok!(cmd.flagValues.getBool("verbose") == true)
    ok!(cmd.flagValues.getInt("count") == 25)
}

test "Repeated flag accumulates values" {
    var cmd = Command("test", "Test command")
    var flag = Flag.list("param", "Parameter")
    cmd.addFlag(flag) catch discard

    var args = ["--param", "p1", "--param", "p2=100"]
    cmd.parse(args) catch discard

    ok!(cmd.flagValues.count("param") == 2)
    var values = cmd.flagValues.getList("param")
    ok!(values.size() == 2)
    ok!(values.[0] == "p1")
    ok!(values.[1] == "p2=100")
}

test "Repeated flag with --flag=value syntax" {
    var cmd = Command("test", "Test command")
    var flag = Flag.list("param", "Parameter")
    cmd.addFlag(flag) catch discard

    var args = ["--param=p1", "--param=p2"]
    cmd.parse(args) catch discard

    var values = cmd.flagValues.getList("param")
    ok!(values.size() == 2)
    ok!(values.[0] == "p1")
    ok!(values.[1] == "p2")
}

test "Repeated flag not provided returns empty list" {
    var cmd = Command("test", "Test command")
    var flag = Flag.list("param", "Parameter")
    cmd.addFlag(flag) catch discard

    var args: [string] = []
    cmd.parse(args) catch discard

    ok!(cmd.flagValues.count("param") == 0)
    ok!(cmd.flagValues.getList("param") == null)
}

test "Map flag builds entries from --name:key value" {
    var cmd = Command("test", "Test command")
    var flag = Flag.map("params", "Parameters")
    cmd.addFlag(flag) catch discard

    var args = ["--params:key", "value", "--params:key2", "--params:key3", "10"]
    cmd.parse(args) catch discard

    var params = cmd.flagValues.getMap("params")
    ok!(params.size() == 3)
    var keyVal = params.["key"]
    ok!(!!keyVal && *keyVal == "value")
    var key2Val = params.["key2"]
    ok!(!!key2Val && *key2Val == "")
    var key3Val = params.["key3"]
    ok!(!!key3Val && *key3Val == "10")
}

test "Map flag supports --name:key=value syntax" {
    var cmd = Command("test", "Test command")
    var flag = Flag.map("params", "Parameters")
    cmd.addFlag(flag) catch discard

    var args = ["--params:a=1", "--params:b=2"]
    cmd.parse(args) catch discard

    var params = cmd.flagValues.getMap("params")
    ok!(params.size() == 2)
    var aVal = params.["a"]
    ok!(!!aVal && *aVal == "1")
    var bVal = params.["b"]
    ok!(!!bVal && *bVal == "2")
}

test "Map flag not provided returns null" {
    var cmd = Command("test", "Test command")
    var flag = Flag.map("params", "Parameters")
    cmd.addFlag(flag) catch discard

    var args: [string] = []
    cmd.parse(args) catch discard

    ok!(cmd.flagValues.getMap("params") == null)
}

test "Colon syntax on a non-map flag fails" {
    var cmd = Command("test", "Test command")
    cmd.addFlag(Flag("name", "Service name", "".s)) catch discard

    var args = ["--name:key", "value"]
    var _, failed = cmd.parse(args) catch (null as Command, true)
    ok!(failed)
}

test "addFlag rejects a flag that is both multiple and map" {
    var cmd = Command("test", "Test command")
    var flag = Flag.map("params", "Parameters")
    flag.multiple = true

    var failed = false
    cmd.addFlag(flag) catch {
        failed = true
    }
    ok!(failed)
}

test "Command positional arguments" {
    var cmd = Command("test", "Test command")
    cmd.addFlag(Flag("verbose", "Enable verbose", false)) catch discard

    var args = ["--verbose", "file1.txt", "file2.txt"]
    cmd.parse(args) catch discard
    ok!(cmd.flagValues.getBool("verbose") == true)
    ok!(cmd.args.size() == 2)
    ok!(cmd.args.[0] == "file1.txt")
    ok!(cmd.args.[1] == "file2.txt")
}

test "Declared required positional argument is captured" {
    var cmd = Command("test", "Test command")
    cmd.addArg(PositionalArg("file", "Input file")) catch discard

    var args = ["input.txt"]
    cmd.parse(args) catch discard

    ok!(cmd.args.size() == 1)
    ok!(cmd.args.[0] == "input.txt")
}

test "Missing required positional argument fails validation" {
    var cmd = Command("test", "Test command")
    cmd.addArg(PositionalArg("file", "Input file")) catch discard

    var args: [string] = []
    var _, failed = cmd.parse(args) catch (null as Command, true)
    ok!(failed)
}

test "Too many positional arguments fails validation" {
    var cmd = Command("test", "Test command")
    cmd.addArg(PositionalArg("file", "Input file")) catch discard

    var args = ["a.txt", "b.txt"]
    var _, failed = cmd.parse(args) catch (null as Command, true)
    ok!(failed)
}

test "Optional positional argument uses default value when omitted" {
    var cmd = Command("test", "Test command")
    cmd.addArg(PositionalArg("src", "Source file")) catch discard
    cmd.addArg(PositionalArg("dst", "Destination file", "out.txt".s)) catch discard

    var args = ["in.txt"]
    cmd.parse(args) catch discard

    ok!(cmd.args.size() == 2)
    ok!(cmd.args.[0] == "in.txt")
    ok!(cmd.args.[1] == "out.txt")
}

test "Variadic positional argument captures remaining args" {
    var cmd = Command("test", "Test command")
    cmd.addArg(PositionalArg("action", "Action to run")) catch discard
    cmd.addArg(PositionalArg("files", "Files to process", true, true)) catch discard

    var args = ["run", "a.txt", "b.txt", "c.txt"]
    cmd.parse(args) catch discard

    ok!(cmd.args.size() == 4)
    ok!(cmd.args.[0] == "run")
    ok!(cmd.args.[3] == "c.txt")
}

test "addArg rejects invalid declarations" {
    var cmd = Command("test", "Test command")
    cmd.addArg(PositionalArg("file", "Input file")) catch discard
    ok!(cmd.positionalArgs.size() == 1)

    // Duplicate name is rejected
    cmd.addArg(PositionalArg("file", "Duplicate")) catch discard
    ok!(cmd.positionalArgs.size() == 1)

    // Required argument cannot follow an optional one
    cmd.addArg(PositionalArg("opt", "Optional file", "default.txt".s)) catch discard
    ok!(cmd.positionalArgs.size() == 2)
    cmd.addArg(PositionalArg("required", "Should fail")) catch discard
    ok!(cmd.positionalArgs.size() == 2)

    // Nothing can be declared after a variadic argument
    var cmd2 = Command("test2", "Test command 2")
    cmd2.addArg(PositionalArg("files", "Files", true, true)) catch discard
    ok!(cmd2.positionalArgs.size() == 1)
    cmd2.addArg(PositionalArg("extra", "Should fail")) catch discard
    ok!(cmd2.positionalArgs.size() == 1)
}

test "Boolean flag without value defaults to true" {
    var cmd = Command("test", "Test command")
    cmd.addFlag(Flag("verbose", "Enable verbose", false)) catch discard

    var args = ["--verbose"]
    cmd.parse(args) catch discard

    ok!(cmd.flagValues.getBool("verbose") == true)
    ok!(cmd.args.empty())
}

test "Boolean flag with explicit true value" {
    var cmd = Command("test", "Test command")
    cmd.addFlag(Flag("debug", "Enable debug", false)) catch discard

    var args = ["--debug", "true"]
    cmd.parse(args) catch discard

    ok!(cmd.flagValues.getBool("debug") == true)
    ok!(cmd.args.empty())
}

test "Boolean flag with explicit false value" {
    var cmd = Command("test", "Test command")
    cmd.addFlag(Flag("quiet", "Quiet mode", true)) catch discard

    var args = ["--quiet", "false"]
    cmd.parse(args) catch discard

    ok!(cmd.flagValues.getBool("quiet") == false)
    ok!(cmd.args.empty())
}

test "Boolean flag with numeric values" {
    var cmd = Command("test", "Test command")
    cmd.addFlag(Flag("enable", "Enable feature", false)) catch discard
    cmd.addFlag(Flag("disable", "Disable feature", true)) catch discard

    var args = ["--enable", "1", "--disable", "0"]
    cmd.parse(args) catch discard

    ok!(cmd.flagValues.getBool("enable") == true)
    ok!(cmd.flagValues.getBool("disable") == false)
    ok!(cmd.args.empty())
}

test "Boolean flag ignores non-boolean next argument" {
    var cmd = Command("test", "Test command")
    cmd.addFlag(Flag("verbose", "Enable verbose", false)) catch discard

    var args = ["--verbose", "filename.txt", "another.txt"]
    cmd.parse(args) catch discard

    ok!(cmd.flagValues.getBool("verbose") == true)
    ok!(cmd.args.size() == 2)
    ok!(cmd.args.[0] == "filename.txt")
    ok!(cmd.args.[1] == "another.txt")
}

test "Mixed boolean and non-boolean flags" {
    var cmd = Command("test", "Test command")
    cmd.addFlag(Flag("verbose", "Enable verbose", false)) catch discard
    cmd.addFlag(Flag("port", "Port number", 3000)) catch discard
    cmd.addFlag(Flag("debug", "Enable debug", false)) catch discard

    var args = ["--verbose", "--port", "8080", "--debug", "false", "file.txt"]
    cmd.parse(args) catch discard

    ok!(cmd.flagValues.getBool("verbose") == true)
    ok!(cmd.flagValues.getInt("port") == 8080)
    ok!(cmd.flagValues.getBool("debug") == false)
    ok!(cmd.args.size() == 1)
    ok!(cmd.args.[0] == "file.txt")
}

test "Short flag parsing basic" {
    var cmd = Command("test", "Test command")
    cmd.addFlag(Flag("verbose", 'v', "Enable verbose", false)) catch discard
    cmd.addFlag(Flag("port", 'p', "Port number", 3000)) catch discard
    cmd.addFlag(Flag("name", 'n', "Service name", "default".s)) catch discard

    var args = ["-v", "-p", "8080", "-n", "myservice"]
    cmd.parse(args) catch discard

    ok!(cmd.flagValues.getBool("verbose") == true)
    ok!(cmd.flagValues.getInt("port") == 8080)
    ok!(cmd.flagValues.getString("name") == "myservice")
}

test "Short flag with boolean values" {
    var cmd = Command("test", "Test command")
    cmd.addFlag(Flag("debug", 'd', "Enable debug", false)) catch discard
    cmd.addFlag(Flag("quiet", 'q', "Quiet mode", true)) catch discard

    var args = ["-d", "true", "-q", "false"]
    cmd.parse(args) catch discard

    ok!(cmd.flagValues.getBool("debug") == true)
    ok!(cmd.flagValues.getBool("quiet") == false)
}

test "Combined short flags -abc" {
    var cmd = Command("test", "Test command")
    cmd.addFlag(Flag("verbose", 'v', "Enable verbose", false)) catch discard
    cmd.addFlag(Flag("all", 'a', "Show all", false)) catch discard
    cmd.addFlag(Flag("force", 'f', "Force operation", false)) catch discard

    var args = ["-vaf"]
    cmd.parse(args) catch discard

    ok!(cmd.flagValues.getBool("verbose") == true)
    ok!(cmd.flagValues.getBool("all") == true)
    ok!(cmd.flagValues.getBool("force") == true)
}

test "Mixed short and long flags" {
    var cmd = Command("test", "Test command")
    cmd.addFlag(Flag("verbose", 'v', "Enable verbose", false)) catch discard
    cmd.addFlag(Flag("port", 'p', "Port number", 3000)) catch discard
    cmd.addFlag(Flag("debug", "Enable debug", false)) catch discard

    var args = ["-v", "--debug", "-p", "9000", "file.txt"]
    cmd.parse(args) catch discard

    ok!(cmd.flagValues.getBool("verbose") == true)
    ok!(cmd.flagValues.getBool("debug") == true)
    ok!(cmd.flagValues.getInt("port") == 9000)
    ok!(cmd.args.size() == 1)
    ok!(cmd.args.[0] == "file.txt")
}

test "Short flag ignores non-boolean next argument" {
    var cmd = Command("test", "Test command")
    cmd.addFlag(Flag("verbose", 'v', "Enable verbose", false)) catch discard

    var args = ["-v", "filename.txt", "another.txt"]
    cmd.parse(args) catch discard

    ok!(cmd.flagValues.getBool("verbose") == true)
    ok!(cmd.args.size() == 2)
    ok!(cmd.args.[0] == "filename.txt")
    ok!(cmd.args.[1] == "another.txt")
}

test "Basic subcommand support" {
    var rootCmd = Command("docker", "Container management")
    var containerCmd = Command("container", "Manage containers")
    rootCmd.addCommand(containerCmd) catch discard

    var subCmd = rootCmd.findCommand("container")
    ok!(subCmd != null)
    ok!(subCmd.name == "container")
    ok!(!!subCmd.parent)
}

test "Persistent flags inheritance" {
    var rootCmd = Command("docker", "Container management")
    rootCmd.addPersistentFlag(Flag("debug", 'd', "Debug mode", false)) catch discard

    var containerCmd = Command("container", "Manage containers")
    rootCmd.addCommand(containerCmd) catch discard

    var args = ["--debug", "true"]
    containerCmd.parse(args) catch discard

    ok!(containerCmd.flagValues.getBool("debug") == true)
}

test "Subcommand routing" {
    var rootCmd = Command("docker", "Container management")
    var containerCmd = Command("container", "Manage containers")
    containerCmd.addFlag(Flag("all", 'a', "Show all", false)) catch discard
    rootCmd.addCommand(containerCmd) catch discard

    var args = ["container", "--all"]
    rootCmd.parse(args) catch discard

    ok!(containerCmd.flagValues.getBool("all") == true)
    ok!(rootCmd.args.empty())
}

test "Command with subcommands requires one to be specified" {
    var rootCmd = Command("docker", "Container management")
    var containerCmd = Command("container", "Manage containers")
    rootCmd.addCommand(containerCmd) catch discard

    var args: [string] = []
    var _, failed = rootCmd.parse(args) catch (null as Command, true)
    ok!(failed)

    // Specifying the subcommand still works fine
    var args2 = ["container"]
    var finalCmd, shouldExecute = rootCmd.parse(args2) catch (null as Command, false)
    ok!(finalCmd != null)
    ok!(shouldExecute)
    ok!(finalCmd.name == "container")
}

test "Unregistered --version flag fails with unknown flag error" {
    var rootCmd = Command("docker", "Container management")
    var containerCmd = Command("container", "Manage containers")
    rootCmd.addCommand(containerCmd) catch discard

    var args = ["--version"]
    var _, failed = rootCmd.parse(args) catch (null as Command, true)
