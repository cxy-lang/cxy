import "native/http/llhttp.h" as parser

macro CRLF =    "\r\n"

enum Encoding {
    UrlEncode, MultipartForm, MultipartOther
}

func urlEncode(os: &OutputStream, url: strview) {
    const hex = "0123456789abcdef"
    var p = url.data() !: ^const u8;
    for (var i: 0..url.size()) {
        if (   ('a'`char <= url.[i] && url.[i] <= 'z'`char)
            || ('A'`char <= url.[i] && url.[i] <= 'Z'`char)
            || ('0'`char <= url.[i] && url.[i] <= '9'`char)
           )
        {
            os << url.[i];
        }
        else {
            os << '%'`char
            os << hex.[p.[i] >> 4]
            os << hex.[p.[i] & 0xF];
        }
    }
}

const LOG_TAG = "HTTP_CLIENT";

struct FileUpload {
    _name: String;
    _contentType: strview;
    _path: Path = null

    func `init`(name: String, path: Path, contentType: strview = "".s) {
        _name = &&name
        _path = &&path
        _contentType = &&contentType
    }

    @inline
    const func contentType() => _contentType

    @inline
    const func path() => &_path

    @inline
    const func name() => &_name

    @inline
    const func open(): !os.FileDescriptor {
        return os.open(_path.s())
    }

    @inline
    const func size(): !u64 => getFileSize(_path.str())

    @inline
    const func `==`(other: &const This) => _name == &other._name
}

// A part whose bytes are in memory
struct BlobPart {
    _name: String
    _filename: String
    _contentType: String
    _data: String

    // The bytes are copied. An empty content type is application/octet-stream.
    func `init`(name: String, filename: String, data: [u8], contentType: strview) {
        _name = &&name
        _filename = &&filename
        _contentType = contentType.empty()
            ? String("application/octet-stream")
            : String(contentType)
        var size = len!(data);
        if (size == 0)
            _data = String()
        else
            _data = String((ptrof data.[0]) !: ^const char, size)
    }
}

// A text field that carries a content type of its own
struct TextPart {
    _name: String
    _value: String
    _contentType: String

    func `init`(name: String, value: String, contentType: strview) {
        _name = &&name
        _value = &&value
        _contentType = String(contentType)
    }
}

// A name or a filename sits between double quotes in a part header. As browsers do
// (the HTML form data rules), a quote, CR and LF in it are written %22, %0D and %0A,
// so no name can end its quotes or start a header of its own.
func partEscape(os: &OutputStream, text: strview) {
    var p = text.data() !: ^const u8
    for (const i: 0..text.size()) {
        const c = p.[i]
        if (c == '"'`u8)
            os << "%22"
        else if (c == 13`u8)
            os << "%0D"
        else if (c == 10`u8)
            os << "%0A"
        else
            os << <char>c
    }
}

// The size of `text` once written by partEscape
func partEscapedSize(text: strview): u64 {
    var p = text.data() !: ^const u8
    var size = text.size();
    for (const i: 0..text.size()) {
        const c = p.[i]
        if (c == '"'`u8 || c == 13`u8 || c == 10`u8)
            size += 2
    }
    return size
}

const CONTENT_DISPOSITION = "Content-Disposition: form-data; name=\"".s;
const CONTENT_DISPOSITION_FILENAME = "\"; filename=\"".s;
const CONTENT_TYPE = "Content-Type: ".s;

pub class Form {
    - _encoding = Encoding.UrlEncode;
    - _boundary: String = null;
    - _data = HeaderMap();
    - _uploads = Vector[FileUpload]();
    - _blobs = Vector[BlobPart]();
    - _typed = Vector[TextPart]();

    func `init`(boundary: String) {
        this._boundary = boundary
    }

    @inline
    func add(name: String, value: String) {
        _data.[&&name] = &&value
    }

    @inline
    func upload(name: String, path: Path, contentType: strview = "".s) {
        _uploads.push(FileUpload(&&name, &&path, contentType))
        _encoding = .MultipartForm
    }

    // A text field with a content type of its own, such as the `application/json`
    // metadata that goes with a file. Only a multipart part can say it, so the form
    // is sent as multipart. An empty content type is a plain field.
    func add(name: String, value: String, contentType: strview) {
        if (contentType.empty()) {
            _data.[&&name] = &&value
            return
        }
        _typed.push(TextPart(&&name, &&value, contentType))
        _encoding = .MultipartForm
    }

    // A part whose bytes are in memory, they are copied. The form is sent as
    // multipart, the parts in this order: fields, typed fields, files, then these.
    func upload(name: String, filename: String, data: [u8], contentType: strview = "".s) {
        _blobs.push(BlobPart(&&name, &&filename, data, contentType))
        _encoding = .MultipartForm
    }

    @inline
    const func `!!`() => hasParts();

    - const func hasParts(): bool =>
        !_data.empty() || !_typed.empty() || !_uploads.empty() || !_blobs.empty();

    - const func urlEncode(os: &OutputStream) {
        var first = true
        for (const item: _data) {
            if (!first)
                os << "&"
            base64.percentEncode(os, &item.0)
            os << "="
            base64.percentEncode(os, &item.1)
            first = false
        }
    }

    - const func multipartEncode(os: &BufferedSocketOutputStream): !void {
        for (const item: _data) {
            os << "--" << _boundary << CRLF!
               << CONTENT_DISPOSITION
            partEscape(os, item.0.s())
            os << '"' << CRLF!
               << CRLF! << item.1 << CRLF!
        }

        for (const item, _: _typed) {
            os << "--" << _boundary << CRLF!
               << CONTENT_DISPOSITION
            partEscape(os, item._name.s())
            os << '"' << CRLF!
               << CONTENT_TYPE << item._contentType << CRLF!
               << CRLF! << item._value << CRLF!
        }

        for (const item, _: _uploads) {
            os << "--" << _boundary << CRLF!
               << CONTENT_DISPOSITION
            partEscape(os, item.name().s())
            os << CONTENT_DISPOSITION_FILENAME
            partEscape(os, item.path().name())
            os << "\"" << CRLF!

            if (!item.contentType().empty())
                os << CONTENT_TYPE << item.contentType() << CRLF!
            os << CRLF!

            var fd = item.open()
            var sent =  os.sendFile(fd.fd, 0, fd.size())
            if (!sent)
                raise HttpError(f"uploading file '{item.path()}' failed: {strerr()}")
            os << CRLF!
        }

        for (const item, _: _blobs) {
            os << "--" << _boundary << CRLF!
               << CONTENT_DISPOSITION
            partEscape(os, item._name.s())
            os << CONTENT_DISPOSITION_FILENAME
            partEscape(os, item._filename.s())
            os << "\"" << CRLF!
               << CONTENT_TYPE << item._contentType << CRLF!
               << CRLF!
            os.append(item._data.data(), item._data.size())
            os << CRLF!
        }

        os << "--" << _boundary << "--"
    }

    const func encode(os: &BufferedSocketOutputStream): !void {
        if (!hasParts())
            return
        if (_encoding == .UrlEncode)
            urlEncode(os)
        else
            multipartEncode(os)
    }

    - const func urlEncodedSize() {
        var size = _data.size() - 1 /* & by size-1 */
        for (const item: _data) {
            size += (
                  1 /* = */
                + base64.percentEncodeSize(&item.0)
                + base64.percentEncodeSize(&item.1)
            )
        }

        return size
    }

    - const func multipartEncodeSize(): !u64 {
        var size = 0`u64
        for (const item: _data) {
            size += (
                2 /*--*/
              + _boundary.size()
              + 8 /* 4 * CRLF */
              + CONTENT_DISPOSITION.size()
              + 1 /* +1 for the last '"' */
              + partEscapedSize(item.0.s())
              + item.1.size()
            )
        }

        for (const item, _: _typed) {
            size += (
                2 /*--*/
              + _boundary.size()
              + 8 /* 4 * CRLF */
              + CONTENT_DISPOSITION.size()
              + 1 /* +1 for the last '"' */
              + partEscapedSize(item._name.s())
              + CONTENT_TYPE.size() + item._contentType.size() + 2 /* CRLF */
              + item._value.size()
            )
        }

        for (const item, _: _uploads) {
            size += (
                  2 /* -- */
                + _boundary.size()
                + 4 /* 2 * CRLF */
                + CONTENT_DISPOSITION.size()
                + partEscapedSize(item.name().s())
                + CONTENT_DISPOSITION_FILENAME.size()
                + partEscapedSize(item.path().name())
                + 1 /* '"' */
            )

            if (!item.contentType().empty())
                size += (CONTENT_TYPE.size() + item.contentType().size() + 2 /* CRLF */ )
            size += 2 /* CRLF */
            size += (item.size() + 2 /* CRLF */ )
        }

        for (const item, _: _blobs) {
            size += (
                  2 /* -- */
                + _boundary.size()
                + 4 /* 2 * CRLF */
                + CONTENT_DISPOSITION.size()
                + partEscapedSize(item._name.s())
                + CONTENT_DISPOSITION_FILENAME.size()
                + partEscapedSize(item._filename.s())
                + 1 /* '"' */
                + CONTENT_TYPE.size() + item._contentType.size() + 2 /* CRLF */
                + 2 /* CRLF */
                + item._data.size() + 2 /* CRLF */
            )
        }

        size +=  (
              4 /* 2 * -- */
            + _boundary.size()
        )
        return size
    }

    - const func size(): !u64 {
        if (!hasParts())
            return 0`u64
        if (_encoding == .UrlEncode)
            return urlEncodedSize()
        else
            return multipartEncodeSize()
    }
}

// A method whose requests carry a body: an empty one still declares its length
// (RFC 9110 8.6). The others send no Content-Length unless they have a body.
func takesBody(method: Method) =>
    method == Method.Post || method == Method.Put || method == Method.Patch

pub class Request {
    - _headers = HeaderMap();
    - _args = HashMap[String, String]();
    - _form: Form? = null;
    - _body: String = null;
    - _sendFile: SendFile? = null;
    - _method = Method.Get;
    - _resource = strview("");

    @inline
    - func `init`() {}

    @inline
    func header(name: String, value: String) => _headers.[&&name] = &&value

    @inline
    func arg(name: String, value: String) => _args.[&&name] = &&value

    func body(value: String = null): !&String {
        if (_form)
            raise HttpError("Request body already set as a form")
        else if (_sendFile)
            raise HttpError("Request body already set as a file")
        if (_body == null)
            _body = (value == null? String() : &&value)
        return &_body
    }

    @inline
    func setContentType(value: String) => _headers.["Content-Type"] = &&value

    func setForm(fm: Form): !void {
        if (_body != null)
            raise HttpError("Request body already set as a string buffer")
        else if (_sendFile)
            raise HttpError("Request body already set as a file")
        else if (_form)
            raise HttpError("Request form already set")

        if (fm._encoding == .UrlEncode) {
            setContentType("application/x-www-form-urlencoded")
        }
        else {
            var contentType = "multipart/form-data; boundary=".S;
            contentType << fm._boundary
            setContentType(&&contentType)
        }

        _form = &&fm
    }

    func setFile(path: Path, contentType: String): !void {
        if (_body != null)
            raise HttpError("Request body already set as a string buffer")
        else if (_form)
            raise HttpError("Request body already set as a form")
        else if (_sendFile)
            raise HttpError("Request file already set")
        var fd = os.open(path.s())
        var size = fd.size();
        _sendFile = SendFile(&&fd, size)
        setContentType(&&contentType)
    }

    // The body is the bytes of `data`, any byte, NUL included. They are copied, so
    // `data` need not outlive the request. The content type is `contentType` when
    // given, else the one already set, else `application/octet-stream`.
    func setBytes(data: [u8], contentType: String = null): !void {
        if (_body != null)
            raise HttpError("Request body already set as a string buffer")
        else if (_form)
            raise HttpError("Request body already set as a form")
        else if (_sendFile)
            raise HttpError("Request body already set as a file")

        var size = len!(data);
        if (size == 0)
            _body = String()
        else
            _body = String((ptrof data.[0]) !: ^const char, size)

        if (contentType != null)
            setContentType(&&contentType)
        else if (!_headers.contains("Content-Type"))
            setContentType("application/octet-stream")
    }

    func cleanup() {
        _args.clear()
        _headers.clear()
        _form = null
        _body = null
        _sendFile = null
        _resource = strview();
    }

    func reset(method: Method, resource: strview, clear: bool) {
       if (clear || method != _method || _resource != resource) {
            cleanup()
            _resource = &&resource
            _method = method
       }
       else {
            _args.clear()
            _headers.clear()
            _form = null
            _body = null
            _sendFile = null
       }
    }

    const func contentLength(): !u64 {
        if (_body != null)
            return _body.size()
        if (_form)
           return _form&.size()
        if (_sendFile)
            return _sendFile&.count
        return 0`u64
    }

    const func encodeHeaders(os: &BufferedSocketOutputStream) {
        for (const hdr: _headers) {
            os << hdr.0 << ": " << hdr.1 << CRLF!
        }
    }

    const func encodeArgs(os: &BufferedSocketOutputStream) {
        if (_args.empty())
            return;
        os << '?'
        var first = true
        for (const arg: _args) {
            if (!first)
                os << '&'
            urlEncode(os, arg.0.s())
            os << '='
            urlEncode(os, arg.1.s())
            first = false
        }
    }

    func submit(sock: &Socket, timeout: u64 = 0): !void {
        var sos = BufferedSocketOutputStream(sock, timeout);
        sos << _method << " "
        if (_resource.empty())
            sos << "/"
        else
            sos << _resource
        encodeArgs(&sos)
        sos << " HTTP/1.1" << CRLF!
        encodeHeaders(&sos)
        var size = contentLength();
        if (size > 0 || takesBody(_method))
            sos << "Content-Length: " << size << CRLF!
        sos << "Date: " << Time() << CRLF!
        sos << CRLF!

        if (size == 0)
            return

        if (_body != null) {
            // Send body as it is
            sos << _body
        }
        else if (_sendFile) {
            // Send the file
            sos.sendFile(_sendFile&.raw(), _sendFile&.offset, _sendFile&.count)
        }
        else if (_form) {
            // Encode the form
            _form&.encode(&sos)
        }
        // Nothing follows the body: Content-Length ends the message, and a byte more
        // would start the next request on this connection (RFC 9112)
    }
}

type WriterFn = func(buf: ^const char, size: u64) -> bool

pub class Response {
    @static
    _empty = String();
    - _status: Status;
    - _headers = HeaderMap();
    - _writer: lambda_of!(#WriterFn);
    - _body: String = null;
    - _parser: ^parser.llhttp_t = null;
    - _s1: String = null;
    - _s2: String = null;
    - _isComplete = false;
    - _headersComplete = false;
    // Bytes that followed the headers of an event stream or upgrade, they belong
    // to the stream and are not parsed as a body
    - _rest: String = null;

    @inline
    func `init`(settings: ^const parser.llhttp_settings_t) {
        _parser = parser.llhttp_alloc(parser.llhttp_type_t.HTTP_RESPONSE, settings)
        _parser.data = this
    }

    @inline
    func `init`(settings: ^const parser.llhttp_settings_t, @escaping fn: WriterFn) {
        this.op__init(settings)
        _writer = &&fn
    }

    func `deinit`() {
        if (_parser != null) {
            parser.llhttp_free(_parser)
            _parser = null
        }
    }

    @[inline, prop]
    const func ok() => _parser.status_code == Status.Ok

    @[inline, prop]
    const func statusCode() => _parser.status_code

    @inline
    const func status() => _parser.status_code as Status

    @[prop, inline]
    const func contentLength() => _parser.content_length

    @[prop]
    const func body() => &_body

    // The body as bytes, whatever they are, empty when there is none. The slice
    // points into the response, it is valid while the response is.
    const func bytes(): [u8] {
        if (_body == null || _body.size() == 0) {
            var none: ^u8 = null;
            return slice!(none, 0)
        }
        return slice!(_body.data() !: ^u8, _body.size())
    }

    @inline
    func header(name: String, value: String) => _headers.[&&name] = &&value

    @inline
    func header(name: String) => _headers.[&&name]

    @[inline, prop]
    const func headersComplete() => _headersComplete

    // Takes the bytes read after the headers of an event stream, null if none
    - func takeRest(): String {
        var rest = &&_rest
        _rest = null
        return &&rest
    }

    func isEventStream(): bool {
        var ct = _headers.[String("Content-Type")]
        if (!!ct && ct&.contains("text/event-stream".s)) {
            return true
        }
        return false
    }

    func onBodyPart(buf: ^const char, len: u64): i32 {
        if (_writer != null) {
            // Write the body to the writer
            return _writer(buf, len)? (-1`i32) : 0
        }
        else if (_body == null) {
            _body = String(buf, len)
        }
        else {
            _body << strview(buf !: string, len)
        }
        return 0
    }

    func onHeadersComplete(): i32 {
        if (_writer == null)
            return 0

        // invoke _writer with null and contentLength to initialized
        if (_writer(null, contentLength()))
            return 0
        return -1
    }

    func onMessageComplete(): i32 {
        if (_writer != null) {
            // notify writer that message os complete
            _writer(null, 0)
        }
        return 0
    }

    func feed(buf: ^const char, len: u64): bool {
        const ret = parser.llhttp_execute(_parser, buf !: ^const char, len)
        if (ret == parser.llhttp_errno.HPE_PAUSED_UPGRADE || ret == parser.llhttp_errno.HPE_PAUSED) {
            _isComplete = true
            // The parser stops after the headers, keep what came with them
            const pos = parser.llhttp_get_error_pos(_parser)
            const consumed = (pos !: u64) - (buf !: u64)
            if (consumed < len)
                _rest = String(pos, len - consumed)
            return true
        }
        if (ret != parser.llhttp_errno.HPE_OK) {
            const s = parser.llhttp_errno_name(ret) !: string
            const reason = parser.llhttp_get_error_reason(_parser) !: string;
            DBG!("parsing response failed - error: " << s << ", reason: " << reason )
            return false
        }
        return true
    }

    func receive(sock: &Socket, timeout: u64): !void {
        var buffer: [char, 8192] = []
        while (!_isComplete) {
            var count = sock.receive(buffer, sizeof!(buffer), timeout);
            if (!count)
                raise HttpError(f"Receiving fetch response failed: {strerr()}")
            if (*count == 0) {
                raise HttpError("Connection closed by server before response was complete")
            }
            if (!feed(buffer, *count)) {
                const err = parser.llhttp_get_error_reason(_parser) !: string
                raise HttpError(f"Parsing fetch response failed: {err}")
            }
        }
    }
}

func responseParserOnHeaderField(p: ^parser.llhttp_t, at: ^const char, len: u64) {
    var resp = &(p.data !: Response)
    if (resp._s2 != null) {
        // We have seen a new header
        assert!(resp._s1 != null)
        resp._headers.[&&resp._s1] = &&resp._s2
        resp._s1 = null
        resp._s2 = null
    }
    if (resp._s1 == null) {
        resp._s1 = String(at, len)
    }
    else {
        resp._s1 << strview(at !: string, len)
    }
    return 0`i32
}

func responseParserOnHeaderValue(p: ^parser.llhttp_t, at: ^const char, len: u64) {
    var resp = &(p.data !: Response);
    assert!(resp._s1 != null)
    if (resp._s2 == null) {
        resp._s2 = String(at, len)
    }
    else {
        resp._s2 << strview(at !: string, len)
    }
    return 0`i32
}

func responseParserOnHeadersComplete(p: ^parser.llhttp_t): i32 {
    var resp = &(p.data !: Response);
    if (resp._s1 != null) {
        assert!(resp._s1 != null)
        resp._headers.[&&resp._s1] = &&resp._s2
        resp._s1 = null
        resp._s2 = null
    }
    resp._headersComplete = true
    if (resp.isEventStream()) {
        resp._isComplete = true
        return 2
    }
    return resp.onHeadersComplete()
}

func responseParserOnBody(p: ^parser.llhttp_t, at: ^const char, len: u64) {
    var resp = &(p.data !: Response);
    return resp.onBodyPart(at, len)
}

func responseParserOnMessageComplete(p: ^parser.llhttp_t) {
    var resp = &(p.data !: Response);
    resp._isComplete = true;
    return 0
}

const HTTP_PARSER_SETTINGS = parser.llhttp_settings_t{
    on_header_field: responseParserOnHeaderField,
    on_header_value: responseParserOnHeaderValue,
    on_headers_complete: responseParserOnHeadersComplete,
    on_body: responseParserOnBody,
    on_message_complete: responseParserOnMessageComplete
};

pub type RequestBuilder = func(req: &Request) -> !void

pub class Session {
    - _port = 80`u16;
    - _headers = HeaderMap();
    - _timeout = 20000`u64; /* 20 sec */
    - _addr = Address();
    // Whether the protocol is https. The protocol itself is not kept: it can be a view
    // into the url, which may not outlive the session.
    - _https = false;
    - _sock: Socket = null;
    - _sslCtx: SslContext = null;
    - _req: Request = null;
    - _hostname: String = null;
    // Bytes of the last response that followed its headers, see takeSocketAndPending
    - _pending: String = null;

    func `init`(proto: strview, host: String, port: u16, addr: Address, timeout: u64 = 20000`u64) {
        _https = proto == "https".s
        _port = port
        _addr = &&addr
        _hostname = &&host
        _timeout = timeout
        header("Host", _hostname)
    }

    @inline
    func isHttps() => _https

    // How an https server is trusted, and the client certificate to show it: CA files
    // and mutual TLS. Without one the server is verified against the system roots.
    func tls(ctx: SslContext): void {
        _sslCtx = &&ctx
    }

    @inline
    func header(name: String, value: String): void { _headers.[&&name] = &&value }

    @inline
    func language(lang: String) { header("Accept-Language", &&lang) }

    @inline
    func userAgent(agent: String) { header("User-Agent", &&agent) }

    func perform(
        method: Method,
        resource: strview,
        builder: RequestBuilder = null,
        @escaping writer: WriterFn = null
    ): !Response {
        _pending = null
        if (_req == null)
            _req = Request()
        _req.reset(method, &&resource, false)
        for (var hdr: _headers) {
            _req.header(hdr.0, hdr.1)
        }

        if (builder != null) {
            // Invoke request builder
            builder(&_req)
        }

        @unlikely if (_sock == null || !_sock) {
            if (_addr.isUnix()) {
                var fd = unixConnect(_addr, _timeout)
                _sock = UnixSocket(fd, _addr)
            }
            else {
                var fd = tcpConnect(_addr, _timeout)
                if (isHttps() && _sslCtx != null)
                    _sock = SslSocket.create(fd, _addr, _hostname.str(), _sslCtx.raw())
                else if (isHttps())
                    _sock = SslSocket.create(fd, _addr, _hostname.str())
                else
                    _sock = TcpSocket(fd, _addr)
            }
        }
        // Submit request
        _req.submit(&_sock, _timeout)
        var resp: Response = Response(ptrof HTTP_PARSER_SETTINGS, &&writer);
        resp.receive(&_sock, _timeout)
        _pending = resp.takeRest()
        return &&resp
    }

    func connect(hdrs: &const HeaderMap): !void {
        var resp = perform(Method.Connect,  "/", (req: &Request): !void => {
            if (hdrs != null) {
                for (const hdr: hdrs) {
                    req.header(hdr.0, hdr.1)
                }
            }
        })

        if (!resp.ok())
            raise HttpError(
                f".Connect to server '{_addr}' failed (status: {resp.statusCode()}"
            )
        _req.cleanup()
    }

    @inline
    func connect(): !void {
        var hdrs: HeaderMap = null;
        connect(&hdrs)
    }

    func head(resource: strview, hdrs: &const HeaderMap): !Response {
        return perform(Method.Head, &&resource, (req: &Request): !void => {
            for (const hdr: hdrs) {
                req.header(hdr.0, hdr.1)
            }
        })
    }

    @inline
    func head(resource: strview): !Response {
        var hdrs: HeaderMap = null;
        return head(&&resource, &hdrs)
    }

    // A session on the unix domain socket at `path`, for a server such as the docker
    // daemon. The Host header says `localhost`. TLS is not used over a unix socket.
    @static
    func createUnix(path: strview, timeout: u64 = 20000.u64): !Session {
        if (path.empty())
            raise HttpError("Invalid unix socket path, it is empty")
        var pathStr = String(path)
        var addr = unixAddress(pathStr.str());
        if (!addr)
            raise HttpError(f"Invalid unix socket path '{path}'")
        return This("http".s, String("localhost"), 80`u16, &&addr, timeout)
    }

    // `http+unix://<socket path>` names a unix socket, the path percent-encoded so
    // that its slashes are not taken for the resource: `http+unix://%2Ftmp%2Fa.sock`.
    // A `+` in the path has to be written `%2B`.
    @static
    func create(url: strview, timeout: u64 = 20000.u64): !Session {
        var idx = url.find("://")
        var host = url;
        var proto = "http".s
        var port  = 80`u16

        if (idx) {
            proto = url.substr(0, <i64>*idx)
            host = url.substr(*idx + 3)
        }

        if (proto == "https+unix".s)
            raise HttpError("TLS is not supported over a unix socket")
        if (proto == "http+unix".s) {
            if (host.empty())
                raise HttpError("Invalid url, the unix socket path is missing")
            var path = String();
            base64.percentDecode(&path, &host)
            return createUnix(path.s(), timeout)
        }

        idx = host.rIndexOf(':'`char)
        if (idx) {
            port = host.substr(*idx + 1).toi[u16]()
            host = host.substr(0, <i64>*idx)
        }
        else if(proto == "https".s) {
            port = 443
        }
        var hostStr = String(host)
        var addr = getRemoteAddress(hostStr.str(), port);
        TRC1!(f"Connected to host: '{proto}://{host}:{port}'")
        return This(proto, hostStr, port, &&addr, timeout)
    }

    // Note: bytes that arrived with the response headers (events of an event
    // stream) are dropped, use takeSocketAndPending() to get them
    func takeSocket(): Socket {
        var sock = &&_sock
        _sock = null
        _pending = null
        return &&sock
    }

    // Like takeSocket(), also returns the bytes read after the response headers,
    // they have to be processed before reading from the socket. Null if none.
    func takeSocketAndPending(): (Socket, String) {
        var pending = &&_pending
        _pending = null
        var sock = &&_sock
        _sock = null
        return (&&sock, &&pending)
    }

    func resetConnection() {
        _pending = null
        if (_sock != null) {
            _sock.close()
            _sock = null
        }
    }
}

// `tls` says how an https server is trusted, and gives the client certificate to show
// it: CA files, mutual TLS. Without one the server is verified against the system roots.
pub func fetch(url: strview, builder: RequestBuilder = null, tls: SslContext = null): !Response {
    var method = Method.Get
    if (!url.empty() && url.[0] == '@'`char) {
        var methodName = url.substr(1)
        var ret = methodFromString(methodName)
        if (ret.0 == .Unknown)
            raise HttpError(f"Invalid fetch url '{url}', @METHOD in url is unknown")
        var i = <i64>ret.1
        while {
            if (!isSpace!(methodName.[i]))
                break
            i++
        }
        url = methodName.substr(i)
        method = ret.0
    }

    var idx = url.find("://")
    var resource = "/".s
    if (idx) {
        var stem = url.substr(*idx + 3)
        var idx2 = stem.indexOf('/'`char)
        if (idx2) {
            resource = stem.substr(*idx2)
            url = url.substr(0, <i64>(3 + *idx + *idx2))
        }
    }

    var session = Session.create(url);
    if (tls != null)
        session.tls(&&tls)
    session.userAgent("Cxy/0.0.1")
    return session.perform(method, resource, &&builder)
}

test "Form URL encoding with simple values" {
    var form = Form(String("boundary"))
    form.add(String("name"), String("john"))
    form.add(String("age"), String("25"))

    var output = String()
    form.urlEncode(&output)

    // Should be key=value&key=value format
    ok!(output.s().contains("name=john"))
    ok!(output.s().contains("age=25"))
    ok!(output.s().contains("&"))
}

test "Form URL encoding with special characters" {
    var form = Form(String("boundary"))
    form.add(String("query"), String("hello world"))
    form.add(String("data"), String("a=b&c"))

    var output = String()
    form.urlEncode(&output)

    // Space should be encoded as +
    ok!(output.s().contains("hello+world"))
    // = and & should be percent-encoded
    ok!(output.s().contains("%3D"))  // =
    ok!(output.s().contains("%26"))  // &
}

test "Form URL encoded size calculation" {
    var form = Form(String("boundary"))
    form.add(String("key"), String("value"))

    var output = String()
    form.urlEncode(&output)

    // Size should match actual encoded output
    ok!(form.size() == output.size())
}

test "Form URL encoding with multiple special characters" {
    var form = Form(String("boundary"))
    form.add(String("token"), String("abc=def=ghi"))
    form.add(String("msg"), String("hello & goodbye"))

    var output = String()
    form.urlEncode(&output)

    var size = form.size()
    ok!(size == output.size())

    // Verify special chars are encoded
    ok!(!output.s().contains("=def="))  // = should be encoded
    ok!(!output.s().contains(" & "))    // space and & should be encoded
}

test "Form empty form returns zero size" {
    var form = Form(String("boundary"))

    ok!(form.size() == 0)
    ok!(!form)  // !! operator should return false for empty form
}

test "Form URL encoding exact output validation" {
    var form = Form(String("boundary"))
    form.add(String("name"), String("john"))

    var output = String()
    form.urlEncode(&output)

    ok!(output.s() == "name=john")
}

test "Form URL encoding exact output with special chars" {
    var form = Form(String("boundary"))
    form.add(String("msg"), String("a b"))

    var output = String()
    form.urlEncode(&output)

    // Space should be encoded as +
    ok!(output.s() == "msg=a+b")
}

test "Form URL encoding exact output with equals and ampersand" {
    var form = Form(String("boundary"))
    form.add(String("data"), String("x=y"))

    var output = String()
    form.urlEncode(&output)

    // = should be encoded as %3D
    ok!(output.s() == "data=x%3Dy")
}

test "Form URL encoding preserves unreserved chars" {
    var form = Form(String("boundary"))
    form.add(String("key"), String("a-b_c.d~e"))

    var output = String()
    form.urlEncode(&output)

    // Unreserved chars (-_.~) should not be encoded
    ok!(output.s() == "key=a-b_c.d~e")
}

test "Form multipart encoding mode activated on upload" {
    var form = Form(String("my-boundary"))
    form.add(String("field"), String("value"))

    // Before upload, should use URL encoding
    var output1 = String()
    form.urlEncode(&output1)
    ok!(output1.s() == "field=value")

    // After adding upload, encoding mode changes
    // (We can't easily test multipart output without a socket,
    // but we can verify the form has content)
    ok!(!!form)
}

test "Form multipart size calculation for data fields" {
    var form = Form(String("boundary"))
    form.add(String("name"), String("test"))

    // Force multipart mode by checking size would include boundary markers
    // For URL encoding: "name=test" = 9 bytes
    var urlSize = form.size()
    ok!(urlSize == 9)
}

test "Form with single field exact format" {
    var form = Form(String("bound"))
    form.add(String("x"), String("1"))

    var output = String()
    form.urlEncode(&output)

    ok!(output.s() == "x=1")
    ok!(form.size() == 3)
}

test "Form URL encoding multiple fields exact format" {
    var form = Form(String("boundary"))
    form.add(String("a"), String("1"))
    form.add(String("b"), String("2"))

    var output = String()
    form.urlEncode(&output)

    // Size should account for both fields and & separator
    var size = form.size()
    ok!(size == output.size())

    // Output should have both fields with & separator
    ok!(output.s().contains("a=1"))
    ok!(output.s().contains("b=2"))
    ok!(output.s().contains("&"))
}

test {
    // Answers one request on a unix socket with a fixed response and keeps the request
    class CannedServer {
        listener: UnixListener
        request = String()

        func `init`(path: string) {
            unistd.unlink(path !: ^const char)
            listener = UnixListener(unixAddress(path))
        }

        @task
        func serve(): void {
            var conn = listener.accept(5000);
            if (!conn)
                return
            var buf: [char, 512] = [];
            var n = (*conn).receive(buf, 512, 5000);
            if (n)
                request.append(buf !: ^const char, *n)
            var reply = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhello";
            var sent = (*conn).sendBuffer(reply !: ^const void, len!(reply), 5000);
        }
    }
}

test "Session: a unix socket path is fetched from" {
    var server = CannedServer("/tmp/cxy-fetch-session.sock")
    ok!(server.listener.listen())
    var task = @async server.serve()

    var session = Session.createUnix("/tmp/cxy-fetch-session.sock") catch {
        ok!(false, "create failed")
        return
    }
    var resp = session.perform(Method.Get, "/status") catch {
        ok!(false, "request failed")
        return
    }
    ok!(resp.ok())
    ok!(resp.body() == "hello")
    task.join() catch {
        ok!(false, "server task raised")
    }
    ok!(server.request.s().contains("GET /status HTTP/1.1"))
    ok!(server.request.s().contains("Host: localhost"))
}

test "fetch: a http+unix url names the socket with a percent-encoded path" {
    var server = CannedServer("/tmp/cxy-fetch-url.sock")
    ok!(server.listener.listen())
    var task = @async server.serve()

    var resp = fetch("http+unix://%2Ftmp%2Fcxy-fetch-url.sock/api/v1/ping") catch {
        ok!(false, "fetch failed")
        return
    }
    ok!(resp.ok())
    ok!(resp.body() == "hello")
    task.join() catch {
        ok!(false, "server task raised")
    }
    ok!(server.request.s().contains("GET /api/v1/ping HTTP/1.1"))
}

test "Session: a session built from a unix address connects to it" {
    var server = CannedServer("/tmp/cxy-fetch-addr.sock")
    ok!(server.listener.listen())
    var task = @async server.serve()

    var session = Session("http", String("localhost"), 80`u16, unixAddress("/tmp/cxy-fetch-addr.sock"));
    var resp = session.perform(Method.Get, "/") catch {
        ok!(false, "request failed")
        return
    }
    ok!(resp.ok())
    task.join() catch {
        ok!(false, "server task raised")
    }
}

test "Session: createUnix refuses an empty path" {
    var raised = false;
    Session.createUnix("") catch {
        raised = true
    }
    ok!(raised)
}

test "Session: a http+unix url without a path is refused" {
    var raised = false;
    Session.create("http+unix://") catch {
        raised = true
    }
    ok!(raised)
}

// A socket that keeps what is written to it
class CaptureSocket: Socket {
    captured = String()

    func `init`() {
        super(-1`i32, Address())
    }

    func receive(buffer: ^void, size: u64, timeout: u64 = 0): u64? => 0`u64

    func sendBuffer(buffer: ^const void, size: u64, timeout: u64 = 0): u64? {
        captured.append(buffer !: ^const char, size)
        return size
    }

    func sendFile(fd: i32, offset: u64, count: u64, timeout: u64 = 0): u64? {
        var buf: [char, 256] = [];
        var copied = 0`u64;
        while (copied < count) {
            var want = count - copied;
            if (want > 256)
                want = 256
            var n = unistd.pread(fd, buf !: ^void, want, <i64>(offset + copied));
            if (n <= 0)
                break
            captured.append(buf !: ^const char, <u64>n)
            copied += <u64>n
        }
        return copied
    }
}

// The Content-Length a captured request declares
func declaredLength(raw: strview): u64 {
    var at = raw.find("Content-Length: ");
    if (!at)
        return 0`u64
    return raw.substr(*at + 16).toi[u64]()
}

// A request ends where its Content-Length says: nothing follows the body, as RFC 9112
// has it, or the next request on the connection starts with stray bytes
func endsWithItsBody(sock: &CaptureSocket, length: u64): bool {
    var raw = sock.captured.s();
    var end = raw.find("\r\n\r\n");
    if (!end)
        return false
    return declaredLength(raw) == length && sock.captured.size() == *end + 4 + length
}

// 300 bytes with every kind of byte in them: a NUL, a CRLF CRLF, and 0xFF
func fillPayload(data: ^u8) {
    for (const i: 0..300) {
        data.[i] = <u8>(i % 256)
    }
    data.[10] = 0
    data.[20] = 13
    data.[21] = 10
    data.[22] = 13
    data.[23] = 10
    data.[299] = 255`u8
}

test "Request: a byte slice is sent as the body whatever bytes it holds" {
    var payload: [u8, 300] = [];
    fillPayload(ptrof payload.[0])

    var req = Request();
    req.reset(Method.Post, "/upload", true)
    req.setBytes(payload) catch {
        ok!(false, "setBytes raised")
        return
    }
    var sock = CaptureSocket();
    req.submit(&sock) catch {
        ok!(false, "submit raised")
        return
    }

    var raw = sock.captured.s();
    ok!(raw.contains("POST /upload HTTP/1.1"))
    ok!(raw.contains("Content-Length: 300"))
    ok!(raw.contains("Content-Type: application/octet-stream"))

    // the body follows the first empty line, and is exactly the payload
    var end = raw.find("\r\n\r\n");
    ok!(!!end)
    var body = sock.captured.data() + (*end + 4);
    ok!(memcmp(body, ptrof payload.[0], 300) == 0)
}

test "Request: setBytes keeps a content type set before it and takes an explicit one" {
    var payload: [u8, 300] = [];
    fillPayload(ptrof payload.[0])

    var first = Request();
    first.reset(Method.Post, "/a", true)
    first.setContentType("image/png")
    first.setBytes(payload) catch {
        ok!(false, "setBytes raised")
        return
    }
    var sock1 = CaptureSocket();
    first.submit(&sock1) catch {
        ok!(false, "submit raised")
        return
    }
    ok!(sock1.captured.s().contains("Content-Type: image/png"))
    ok!(!sock1.captured.s().contains("octet-stream"))

    var second = Request();
    second.reset(Method.Post, "/b", true)
    second.setBytes(payload, "application/x-custom") catch {
        ok!(false, "setBytes raised")
        return
    }
    var sock2 = CaptureSocket();
    second.submit(&sock2) catch {
        ok!(false, "submit raised")
        return
    }
    ok!(sock2.captured.s().contains("Content-Type: application/x-custom"))
}

test "Request: setBytes is refused when a body is already set" {
    var payload: [u8, 300] = [];
    fillPayload(ptrof payload.[0])

    var text = Request();
    text.reset(Method.Post, "/a", true)
    text.body("text")
    var raised = false;
    text.setBytes(payload) catch {
        raised = true
    }
    ok!(raised)

    var twice = Request();
    twice.reset(Method.Post, "/b", true)
    twice.setBytes(payload)
    raised = false
    twice.setBytes(payload) catch {
        raised = true
    }
    ok!(raised)
}

test "Request: nothing follows a string body" {
    var req = Request();
    req.reset(Method.Post, "/a", true)
    req.body("hello world")
    var sock = CaptureSocket();
    req.submit(&sock) catch {
        ok!(false, "submit raised")
        return
    }
    ok!(endsWithItsBody(&sock, 11))
}

test "Request: nothing follows a byte slice body" {
    var payload: [u8, 300] = [];
    fillPayload(ptrof payload.[0])
    var req = Request();
    req.reset(Method.Post, "/a", true)
    req.setBytes(payload)
    var sock = CaptureSocket();
    req.submit(&sock) catch {
        ok!(false, "submit raised")
        return
    }
    ok!(endsWithItsBody(&sock, 300))
}

test "Request: nothing follows a url encoded form" {
    var form = Form(String("boundary"))
    form.add(String("a"), String("1"))
    form.add(String("b"), String("2"))
    var req = Request();
    req.reset(Method.Post, "/a", true)
    req.setForm(form)
    var sock = CaptureSocket();
    req.submit(&sock) catch {
        ok!(false, "submit raised")
        return
    }
    // a=1&b=2
    ok!(endsWithItsBody(&sock, 7))
}

test "Request: nothing follows a file body" {
    unistd.unlink("/tmp/cxy-fetch-body.txt" !: ^const char)
    var out = fcntl.creat("/tmp/cxy-fetch-body.txt" !: ^const char, 420);
    unistd.write(out, "0123456789" !: ^const void, 10)
    unistd.close(out)

    var req = Request();
    req.reset(Method.Post, "/a", true)
    req.setFile(Path("/tmp/cxy-fetch-body.txt"), String("text/plain"))
    var sock = CaptureSocket();
    req.submit(&sock) catch {
        ok!(false, "submit raised")
        return
    }
    unistd.unlink("/tmp/cxy-fetch-body.txt" !: ^const char)
    ok!(endsWithItsBody(&sock, 10))
    ok!(sock.captured.s().contains("0123456789"))
}

test "Request: nothing follows a multipart form and its size is exact" {
    unistd.unlink("/tmp/cxy-fetch-part.txt" !: ^const char)
    var out = fcntl.creat("/tmp/cxy-fetch-part.txt" !: ^const char, 420);
    unistd.write(out, "0123456789" !: ^const void, 10)
    unistd.close(out)

    var form = Form(String("xyz"))
    form.add(String("field"), String("value"))
    form.upload(String("file"), Path("/tmp/cxy-fetch-part.txt"), "text/plain".s)
    var req = Request();
    req.reset(Method.Post, "/a", true)
    req.setForm(form)
    var sock = CaptureSocket();
    req.submit(&sock) catch {
        ok!(false, "submit raised")
        return
    }
    unistd.unlink("/tmp/cxy-fetch-part.txt" !: ^const char)
    var raw = sock.captured.s();
    ok!(raw.contains("--xyz--"))
    var end = raw.find("\r\n\r\n");
    ok!(!!end)
    // Content-Length is the size of the whole body, and the body is nothing more
    ok!(sock.captured.size() == *end + 4 + declaredLength(raw))
}

// What a request with no body declares, for a method
func emptyRequestHeaders(method: Method): String {
    var req = Request();
    req.reset(method, "/a", true)
    var sock = CaptureSocket();
    req.submit(&sock) catch {
        return String()
    }
    return String(sock.captured.data(), sock.captured.size())
}

test "Request: an empty body of a method that takes one declares Content-Length 0" {
    var post = emptyRequestHeaders(Method.Post);
    var put = emptyRequestHeaders(Method.Put);
    var patch = emptyRequestHeaders(Method.Patch);
    ok!(post.s().contains("POST /a HTTP/1.1"))
    ok!(post.s().contains("Content-Length: 0"))
    ok!(put.s().contains("Content-Length: 0"))
    ok!(patch.s().contains("Content-Length: 0"))
}

test "Request: a method that takes no body declares no Content-Length" {
    var get = emptyRequestHeaders(Method.Get);
    var head = emptyRequestHeaders(Method.Head);
    var del = emptyRequestHeaders(Method.Delete);
    var options = emptyRequestHeaders(Method.Options);
    // a request was written at all, so the checks below are about the header
    ok!(get.s().contains("GET /a HTTP/1.1"))
    ok!(head.s().contains("HEAD /a HTTP/1.1"))
    ok!(del.s().contains("DELETE /a HTTP/1.1"))
    ok!(options.s().contains("OPTIONS /a HTTP/1.1"))
    ok!(!get.s().contains("Content-Length"))
    ok!(!head.s().contains("Content-Length"))
    ok!(!del.s().contains("Content-Length"))
    ok!(!options.s().contains("Content-Length"))
}

test "Request: a body still declares its own length" {
    var req = Request();
    req.reset(Method.Post, "/a", true)
    req.body("hello")
    var sock = CaptureSocket();
    req.submit(&sock) catch {
        ok!(false, "submit raised")
        return
    }
    ok!(sock.captured.s().contains("Content-Length: 5"))
    ok!(!sock.captured.s().contains("Content-Length: 0"))
}

test "Response: bytes gives the body whatever bytes it holds" {
    var payload: [u8, 300] = [];
    fillPayload(ptrof payload.[0])

    var resp = Response(ptrof HTTP_PARSER_SETTINGS);
    // the body arrives in parts
    resp.onBodyPart((ptrof payload.[0]) !: ^const char, 100)
    resp.onBodyPart((ptrof payload.[100]) !: ^const char, 200)

    var got = resp.bytes();
    ok!(len!(got) == 300)
    ok!(memcmp(ptrof got.[0], ptrof payload.[0], 300) == 0)
    // the NUL in it does not cut the body short
    ok!(got.[10] == 0 && got.[299] == 255)
}

test "Response: bytes is empty when there is no body" {
    var resp = Response(ptrof HTTP_PARSER_SETTINGS);
    ok!(len!(resp.bytes()) == 0)
}

// The request a form makes, as it goes on the wire
func submitForm(form: Form, sock: &CaptureSocket): bool {
    var req = Request();
    req.reset(Method.Post, "/up", true)
    req.setForm(form) catch {
        return false
    }
    req.submit(sock) catch {
        return false
    }
    return true
}

test "Form: a part from memory is sent with its bytes, in a body of the size declared" {
    unistd.unlink("/tmp/cxy-fetch-part2.txt" !: ^const char)
    var out = fcntl.creat("/tmp/cxy-fetch-part2.txt" !: ^const char, 420);
    unistd.write(out, "0123456789" !: ^const void, 10)
    unistd.close(out)

    var payload: [u8, 300] = [];
    fillPayload(ptrof payload.[0])

    var form = Form(String("xyz"))
    form.add(String("field"), String("value"))
    form.upload(String("doc"), Path("/tmp/cxy-fetch-part2.txt"), "text/plain".s)
    form.upload(String("img"), String("pic.png"), payload, "image/png".s)
    var sock = CaptureSocket();
    ok!(submitForm(form, &sock))
    unistd.unlink("/tmp/cxy-fetch-part2.txt" !: ^const char)

    var raw = sock.captured.s();
    var end = raw.find("\r\n\r\n");
    ok!(!!end)
    // Content-Length is the size of the whole body, and the body is nothing more
    ok!(sock.captured.size() == *end + 4 + declaredLength(raw))

    ok!(raw.contains("name=\"field\""))
    ok!(raw.contains("name=\"doc\"; filename=\"cxy-fetch-part2.txt\""))
    ok!(raw.contains("name=\"img\"; filename=\"pic.png\""))
    ok!(raw.contains("Content-Type: image/png"))

    // the bytes follow the headers of their part, exactly
    var part = raw.find("name=\"img\"");
    ok!(!!part)
    var headersEnd = raw.substr(*part).find("\r\n\r\n");
    ok!(!!headersEnd)
    var bytes = sock.captured.data() + (*part + *headersEnd + 4);
    ok!(memcmp(bytes, ptrof payload.[0], 300) == 0)
    // and a CRLF after them, then the closing boundary ends the body
    ok!(memcmp(bytes + 300, "\r\n--xyz--", 9) == 0)
    ok!(memcmp(sock.captured.data() + (sock.captured.size() - 7), "--xyz--", 7) == 0)
}

test "Form: a part from memory without a content type is application/octet-stream" {
    var payload: [u8, 300] = [];
    fillPayload(ptrof payload.[0])
    var form = Form(String("xyz"))
    form.upload(String("blob"), String("data.bin"), payload, "".s)
    var sock = CaptureSocket();
    ok!(submitForm(form, &sock))
    ok!(sock.captured.s().contains("Content-Type: application/octet-stream"))
}

test "Form: an empty part from memory is a well formed part" {
    var none: ^u8 = null;
    var empty = slice!(none, 0);
    var form = Form(String("xyz"))
    form.upload(String("blob"), String("empty.bin"), empty, "text/plain".s)
    var sock = CaptureSocket();
    ok!(submitForm(form, &sock))

    var raw = sock.captured.s();
    ok!(raw.contains("name=\"blob\"; filename=\"empty.bin\""))
    // the headers end, no bytes, the CRLF that ends the part, the closing boundary
    ok!(raw.contains("\r\n\r\n\r\n--xyz--"))
    var end = raw.find("\r\n\r\n");
    ok!(!!end)
    ok!(sock.captured.size() == *end + 4 + declaredLength(raw))
}

test "Form: a text field can carry a content type" {
    var payload: [u8, 300] = [];
    fillPayload(ptrof payload.[0])

    var form = Form(String("xyz"))
    form.add(String("plain"), String("text"))
    form.add(String("meta"), String("{\"a\":1}"), "application/json".s)
    form.upload(String("img"), String("pic.png"), payload, "image/png".s)
    var sock = CaptureSocket();
    ok!(submitForm(form, &sock))

    var raw = sock.captured.s();
    ok!(raw.contains("name=\"meta\"\r\nContent-Type: application/json\r\n\r\n{\"a\":1}\r\n"))
    // a field without a type has none
    ok!(raw.contains("name=\"plain\"\r\n\r\ntext\r\n"))
    var end = raw.find("\r\n\r\n");
    ok!(!!end)
    ok!(sock.captured.size() == *end + 4 + declaredLength(raw))
}

test "Form: a typed text field makes the form multipart" {
    var form = Form(String("xyz"))
    form.add(String("meta"), String("{}"), "application/json".s)
    var sock = CaptureSocket();
    ok!(submitForm(form, &sock))

    var raw = sock.captured.s();
    ok!(raw.contains("Content-Type: multipart/form-data; boundary=xyz"))
    ok!(raw.contains("name=\"meta\"\r\nContent-Type: application/json"))
    ok!(memcmp(sock.captured.data() + (sock.captured.size() - 7), "--xyz--", 7) == 0)
    var end = raw.find("\r\n\r\n");
    ok!(!!end)
    ok!(sock.captured.size() == *end + 4 + declaredLength(raw))
}

test "Form: a text field with an empty content type is a plain one" {
    var form = Form(String("xyz"))
    form.add(String("k"), String("v"), "".s)
    var sock = CaptureSocket();
    ok!(submitForm(form, &sock))
    ok!(sock.captured.s().contains("application/x-www-form-urlencoded"))
    ok!(!sock.captured.s().contains("multipart"))
}

test "Form: a quote or a line break in a name is escaped, in every kind of part" {
    unistd.unlink("/tmp/cxy-fetch-q\"uote.txt" !: ^const char)
    var out = fcntl.creat("/tmp/cxy-fetch-q\"uote.txt" !: ^const char, 420);
    unistd.write(out, "abc" !: ^const void, 3)
    unistd.close(out)

    var payload: [u8, 300] = [];
    fillPayload(ptrof payload.[0])

    var form = Form(String("xyz"))
    form.add(String("a\"b"), String("value"))
    form.upload(String("c\"d"), Path("/tmp/cxy-fetch-q\"uote.txt"), "text/plain".s)
    form.upload(String("e\r\nf"), String("g\"h\r\ni.bin"), payload, "image/png".s)
    var sock = CaptureSocket();
    ok!(submitForm(form, &sock))
    unistd.unlink("/tmp/cxy-fetch-q\"uote.txt" !: ^const char)

    var raw = sock.captured.s();
    ok!(raw.contains("name=\"a%22b\""))
    ok!(raw.contains("name=\"c%22d\"; filename=\"cxy-fetch-q%22uote.txt\""))
    ok!(raw.contains("name=\"e%0D%0Af\"; filename=\"g%22h%0D%0Ai.bin\""))
    // the sizes of the escaped names are counted
    var end = raw.find("\r\n\r\n");
    ok!(!!end)
    ok!(sock.captured.size() == *end + 4 + declaredLength(raw))
}

test "Session: the protocol does not depend on the url it was read from" {
    var secure = String("https://127.0.0.1:8443");
    var plain = String("http://127.0.0.1:8080");
    var s1 = Session.create(secure.s()) catch {
        ok!(false, "create https raised")
        return
    }
    var s2 = Session.create(plain.s()) catch {
        ok!(false, "create http raised")
        return
    }
    ok!(s1.isHttps())
    ok!(!s2.isHttps())

    // the urls are gone as far as the sessions are concerned: their bytes change
    memset(secure.data() !: ^void, 'x'`i32, secure.size())
    memset(plain.data() !: ^void, 'x'`i32, plain.size())
    ok!(s1.isHttps())
    ok!(!s2.isHttps())
}

test "Session: TLS is not available over a unix socket" {
    var raised = false;
    Session.create("https+unix://%2Ftmp%2Fx.sock") catch {
        raised = true
    }
    ok!(raised)
}
