module fetch

import { Address, Socket, BufferedSocketOutputStream, getRemoteAddress, unixAddress } from "./net.cxy"
import "unistd.h" as unistd
import "fcntl.h" as fcntl
import { TcpSocket, tcpConnect } from "./tcp.cxy"
