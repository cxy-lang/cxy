module thread

import "native/thread/tinythread.h" as tinyThread

@__cc "native/thread/tinythread.c"
@__cc "native/thread/thread.c"

pub exception ThreadError(msg: String) => msg == null? "" : msg.str()

#if (defined MACOS || defined __ALPINE__) {
macro DEFAULT_TID null
}
else #if (defined UNIX) {
macro DEFAULT_TID 0`u64
}

struct Handle {
    - hdl: tinyThread.thrd_t = DEFAULT_TID!;
    - _id = 0`u64;

    func `init`(hdl: tinyThread.thrd_t) {
        this.hdl = hdl
        tinyThread.thrd_id(hdl, ptrof _id)
    }

    @inline
    func id() => _id

    @inline
    const func `==`(other: &const This) => hdl == other.hdl
}

@[__override_builtin("__Thread")]
pub struct Thread {
    - _handle: Handle
    - _joinable = false;

    func `init`(hdl: tinyThread.thrd_t, joinable: bool = true) {
        _handle = Handle(hdl)
        _joinable = joinable
    }

    func join() {
        if (_joinable) {
            tinyThread.thrd_join(_handle.hdl, null)
            _joinable = false
        }
    }

    func id() => _handle.id()

    @[inline, static]
    func current(): Handle {
        return Handle(tinyThread.thrd_current())
    }

    @inline
    func `==`(other: &const This) => _handle == other._handle
}

extern func __cxy_thread_launch(hdl: ^tinyThread.thrd_t, cl: ^void, size: u64): bool

@[__override_builtin("__Thread_launch")]
func thread_launch(@escaping fn: func() -> i32): !Thread {
    var hdl: tinyThread.thrd_t
    var status = __cxy_thread_launch(ptrof hdl, ptrof fn, sizeof!(fn))
    if (!status) {
        // not started: `fn` is still ours and is dropped on the way out
        raise ThreadError("Failed to launch thread")
    }
    // The thread owns its copy of the closure and releases it when it ends,
    // clear ours so it is not released again when this function returns
    zero!(@forced ptrof fn)
    return Thread(hdl, true)
}
