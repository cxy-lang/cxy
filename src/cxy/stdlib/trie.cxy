module trie

import { HashMap } from "stdlib/hash.cxy"
import { Vector } from "stdlib/vector.cxy"

struct TrieNode[T] {
    - children: HashMap[wchar, ^This] = null;
    - tag: char;
    - data: T?;

    func `init`(c: char =  '\0'as char) {
        tag = c
        data = null
        children = HashMap[wchar, ^This]();
    }

    func add(c: wchar) {
        if (var child = children.[c]) {
            return *child
        }

        var node = __calloc(sizeof!(This)) !: ^This;
        node.op__init(c)
        children.[c] = node
        return node
    }

    func `deinit`(): void {
        if children != null {
            var nodes = Vector[^This]()
            for node in children {
                nodes.push(node.1)
            }
            children.clear()

            for node, _ in nodes {
                delete *node
                free(node !: ^void)
            }
        }
    }

    @inline
    func get(c: wchar) => children.[c]
}

pub class Trie[Data] {
    - root: TrieNode[Data];
    - x: i32
    func `init`() {
        root = TrieNode[Data]();
    }

    @inline
    func add(key: string, data: Data) {
        add(key, len!(key), &&data)
    }

    @inline
    func add(key: strview, data: Data) {
        return add(key.str(), key.size(), &&data)
    }

    func find(key: string) : &Data? {
        var size = len!(key);
        var found = find(key, size);
        if (found) {
            var idx, data = *found;
            if (idx == size)
                return data
        }
        return null
    }

    - func add(prefix: string, len: u64, data: Data) : &Data {
        var node = ptrof root;
        for (var i: 0..len) {
            node = node.add(prefix.[i])
        }
        assert!(!node.data)
        node.data = &&data
        return &*node.data
    }

    - func find(prefix: string, len: u64) : (i64, &Data)? {
        var node = ptrof root
        var found: (i64, &Data)? = null
        if node.data {
            found = (0.i64, &*node.data)
        }

        for (var i: 0..len) {
            var child = node.get(prefix.[i])
            if (!child)
                break

            node = *child;
            if (node.data) {
                found = (<i64>(i+1), &*node.data)
            }
        }
        return found
    }
}

test "Trie basic insert and find" {
    var t = Trie[i32]()
    t.add("apple", 100)
    t.add("app", 200)
    t.add("banana", 300)

    var res = t.find("apple")
    ok!(res)
    ok!(*res == 100)

    res = t.find("app")
    ok!(res)
    ok!(*res == 200)

    res = t.find("banana")
    ok!(res)
    ok!(*res == 300)

    res = t.find("ap")
    ok!(!res)

    res = t.find("orange")
    ok!(!res)
}

test "Trie prefix matching" {
    var t = Trie[String]()
    t.add("cat", String("feline"))
    t.add("caterpillar", String("insect"))

    var res = t.find("cat")
    ok!(res)
    ok!(*res == "feline")

    res = t.find("caterpillar")
    ok!(res)
    ok!(*res == "insect")

    res = t.find("cater")
    ok!(!res)
}

test "Trie empty string key" {
    var t = Trie[i32]()
    t.add("", 42)

    var res = t.find("")
    ok!(res)
    ok!(*res == 42)

    res = t.find("nonexistent")
    ok!(!res)
}
