module ws

import { TcpSocket } from "./tcp.cxy"
import { Upgrade, Request, Response, Status } from "./http.cxy"
import { SHA1, SHA1Digest } from "./crypto.cxy"
import { encodeBuffer } from "./base64.cxy"
import { htons, ntohs, htonll, ntohll } from "./endian.cxy"

import "./log.cxy"

const WS_MAGIC_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
const LOG_TAG = "wss"

pub exception WebSocketError(msg: String) => msg == null ? "" : msg.str()

pub enum Opcode : u8 {
    Continuation = 0x0,
    Text         = 0x1,
    Binary       = 0x2,
    Close        = 0x8,
    Ping         = 0x9,
    Pong         = 0xA
}

pub func computeAcceptHeader(key: __string): String {
    var raw = String(key)
    raw << WS_MAGIC_GUID
    var digest = SHA1Digest{}
    SHA1(&digest, raw.data(), raw.size()) catch discard
    return digest.b64()
}

func sendFrame(sock: &TcpSocket, opcode: Opcode, data: ^const void, size: u64): !void {
    var header: [u8, 10] = []
    var op = <u8>opcode
    header.[0] = 0x80.u8 | (op & 0x0F.u8)
    var headerLen = 2.u64
    if size <= 125 {
        header.[1] = <u8>size
    }
    else if size <= 65535 {
        header.[1] = 126.u8
        var len16 = htons(<u16>size)
        memcpy(ptrof header.[2], ptrof len16, 2)
        headerLen = 4
    }
    else {
        header.[1] = 127.u8
        var len64 = htonll(size)
        memcpy(ptrof header.[2], ptrof len64, 8)
        headerLen = 10
    }

    var sent = sock.sendBuffer(ptrof header.[0], headerLen)
    if !sent || *sent != headerLen {
        raise WebSocketError(String("Failed to send frame header"))
    }
    if size > 0 && data != null {
        sent = sock.sendBuffer(data, size)
        if !sent || *sent != size {
            raise WebSocketError(String("Failed to send frame payload"))
        }
    }
}

func readExact(sock: &TcpSocket, buf: ^void, size: u64): bool {
    var ptr = buf !: ^char
    var total = 0.u64
    while total < size {
        var n = sock.receive(ptrof ptr.[total], size - total)
        if !n || *n == 0 {
            return false
        }
        total += *n
    }
    return true
}

pub class WebSocket[Context] {
    - _sock: TcpSocket
    - _context: &Context
    - _closed: bool = false

    func `init`(sock: TcpSocket, context: &Context) {
        _sock = &&sock
        _context = context
    }

    @[prop, inline]
    func context() => _context

    @[prop, inline]
    func socket() => &_sock

    @[prop, inline]
    func isClosed() => _closed

    func send(msg: __string): !void {
        if _closed { return }
        sendFrame(&_sock, Opcode.Text, msg.data(), msg.size())
    }

    func send(msg: String): !void {
        if _closed { return }
        sendFrame(&_sock, Opcode.Text, msg.data(), msg.size())
    }

    func send(msg: string): !void {
        if _closed { return }
        sendFrame(&_sock, Opcode.Text, msg !: ^const void, len!(msg))
    }

    func sendBinary(data: ^const void, size: u64): !void {
        if _closed { return }
        sendFrame(&_sock, Opcode.Binary, data, size)
    }

    func ping(data: __string = "".s): !void {
        if _closed { return }
        sendFrame(&_sock, Opcode.Ping, data.data(), data.size())
    }

    func pong(data: __string = "".s): !void {
        if _closed { return }
        sendFrame(&_sock, Opcode.Pong, data.data(), data.size())
    }

    func close(code: u16 = 1000, reason: string = ""): !void {
        if _closed { return }
        _closed = true
        var payload: [u8, 128] = []
        var len16 = htons(code)
        memcpy(ptrof payload.[0], ptrof len16, 2)
        var reasonLen = len!(reason)
        if reasonLen > 125 { reasonLen = 125 }
        if reasonLen > 0 {
            memcpy(ptrof payload.[2], reason !: ^const void, reasonLen)
        }
        sendFrame(&_sock, Opcode.Close, ptrof payload.[0], 2 + reasonLen) catch discard
        _sock.close()
    }
}

pub class WebSocketServer[Context] : Upgrade {
    _context:   Context
    func `init`(context: Context) {
        _context = &&context
    }

    func upgrade(req: &const Request, resp: &Response): bool {
        var key = req.header(String("Sec-WebSocket-Key"))
        if !key {
            resp.end(Status.BadRequest)
            return false
        }

        var accept = computeAcceptHeader(key&.s())
        resp.header(String("Upgrade"), String("websocket"))
        resp.header(String("Connection"), String("Upgrade"))
        resp.header(String("Sec-WebSocket-Accept"), &&accept)
        resp.upgrade(__copy!(this))
        return true
    }

    @override
    func start(sock: TcpSocket): !void {
        var client = WebSocket[Context](&&sock, &_context)

        #if (has_member!(#Context, "onConnect", #func(_: &WebSocket[Context]) -> bool)) {
            if !_context.onConnect(&client) {
                client.close(1008, "Policy Violation")
                return
            }
        }

        readLoop(&client)
    }

    - func readLoop(client: &WebSocket[Context]): void {
        var msgBuf = String()
        var curOpcode = Opcode.Continuation

        while !client.isClosed() && !!client.socket() {
            var hdr: [u8, 2] = []
            if !readExact(client.socket(), ptrof hdr.[0], 2) {
                break
            }

            var fin = (hdr.[0] & 0x80`u8) != 0
            var op = <Opcode>(hdr.[0] & 0x0F`u8)
            var masked = (hdr.[1] & 0x80`u8) != 0
            var payloadLen = <u64>(hdr.[1] & 0x7F`u8)

            if payloadLen == 126 {
                var lenBuf: [u8, 2] = []
                if !readExact(client.socket(), ptrof lenBuf.[0], 2) {
                    break
                }
                payloadLen = <u64>ntohs(*(ptrof lenBuf.[0] !: ^u16))
            }
            else if payloadLen == 127 {
                var lenBuf: [u8, 8] = []
                if !readExact(client.socket(), ptrof lenBuf.[0], 8) {
                    break
                }
                payloadLen = ntohll(*(ptrof lenBuf.[0] !: ^u64))
            }

            var mask: [u8, 4] = []
            if masked {
                if !readExact(client.socket(), ptrof mask.[0], 4) {
                    break
                }
            }

            var payload: ^char = null
            if payloadLen > 0 {
                msgBuf.reserve(payloadLen)
                payload = msgBuf.data() as ^char
                if !readExact(client.socket(), payload !: ^void, payloadLen) {
                    break
                }

                if masked {
                    var p = payload !: ^u8
                    for (var i: 0..payloadLen) {
                        p.[i] = p.[i] ^ mask.[i % 4]
                    }
                }
            }

            switch op {
                case Opcode.Ping => {
                    sendFrame(client.socket(), Opcode.Pong, payload !: ^const void, payloadLen) catch discard
                }
                case Opcode.Pong => {}
                case Opcode.Close => {
                    var code = 1000`u16
                    @unused var reason = "".s
                    if payloadLen >= 2 {
                        code = ntohs(*(payload !: ^u16))
                        if payloadLen > 2 {
                            reason = __string(ptroff!(payload + 2) !: string, payloadLen - 2)
                        }
                    }
                    #if (has_member!(#Context, "onClose", #func(_: &WebSocket[Context], _: u16, _: __string) -> void)) {
                        _context.onClose(client, code, reason)
                    }
                    client.close(code) catch {
                        ERR!("Failed to close WebSocket: " << ex!.what())
                    }
                    return
                }
                case Opcode.Text, Opcode.Binary => {
                    curOpcode = op
                    if payloadLen > 0 {
                        msgBuf.resize(payloadLen)
                    }
                }
                case Opcode.Continuation => {
                    if payloadLen > 0 {
                        msgBuf.resize(msgBuf.size() + payloadLen)
                    }
                }
                ... => {}
            }

            if fin && curOpcode != Opcode.Continuation {
                if curOpcode == Opcode.Text {
                    #if (has_member!(#Context, "onMessage", #func(_: &WebSocket[Context], _: __string) -> void)) {
                        _context.onMessage(client, msgBuf.__str())
                    }
                }
                else if curOpcode == Opcode.Binary {
                    #if (has_member!(#Context, "onBinary", #func(_: &WebSocket[Context], _: ^const void, _: u64) -> void)) {
                        _context.onBinary(client, msgBuf.data(), msgBuf.size())
                    }
                }
                msgBuf.clear()
                curOpcode = Opcode.Continuation
            }
        }

        if !client.isClosed() {
            #if (has_member!(#Context, "onClose", #func(_: &WebSocket[Context], _: u16, _: __string) -> void)) {
                _context.onClose(client, 1006`u16, "Abnormal Closure".s)
            }
            client.close(1006) catch {
                ERR!("Failed to close WebSocket: " << ex!.what())
            }
        }
    }
}
