module ws

import { TcpSocket } from "./tcp.cxy"
import { getRemoteAddress, Socket } from "./net.cxy"
import { Upgrade, Request, Response, Status } from "./http.cxy"
import { Session } from "./fetch.cxy"
import { Method } from "./http.cxy"
import { SHA1, SHA1Digest } from "./crypto.cxy"
import { encodeBuffer } from "./base64.cxy"
import { htons, ntohs, htonll, ntohll } from "./endian.cxy"

import "openssl/rand.h" as OpenSSLRand
import "./log.cxy"

const WS_MAGIC_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
const LOG_TAG = "wss"

pub exception WebSocketError(msg: String) => msg == null ? "" : msg.str()

pub enum Opcode : u8 {
    Continuation = 0x0,
    Text         = 0x1,
    Binary       = 0x2,
    Close        = 0x8,
    Ping         = 0x9,
    Pong         = 0xA
}

pub func computeAcceptHeader(key: strview): String {
    var raw = String(key)
    raw << WS_MAGIC_GUID
    var digest = SHA1Digest{}
    SHA1(&digest, raw.data(), raw.size()) catch discard
    return digest.b64()
}

func sendFrame(sock: &Socket, opcode: Opcode, data: ^const void, size: u64, mask: bool = false): !void {
    var header: [u8, 14] = []
    var op = <u8>opcode
    header.[0] = 0x80.u8 | (op & 0x0F.u8)
    var headerLen = 2.u64
    var maskBit = mask ? 0x80.u8 : 0x00.u8

    if size <= 125 {
        header.[1] = maskBit | <u8>size
    }
    else if size <= 65535 {
        header.[1] = maskBit | 126.u8
        var len16 = htons(<u16>size)
        memcpy(ptrof header.[2], ptrof len16, 2)
        headerLen = 4
    }
    else {
        header.[1] = maskBit | 127.u8
        var len64 = htonll(size)
        memcpy(ptrof header.[2], ptrof len64, 8)
        headerLen = 10
    }

    if mask {
        var maskKey: [u8, 4] = []
        OpenSSLRand.RAND_bytes(ptrof maskKey.[0], 4)
        memcpy(ptrof header.[headerLen], ptrof maskKey.[0], 4)
        headerLen += 4

        var sent = sock.sendBuffer(ptrof header.[0], headerLen)
        if !sent || *sent != headerLen {
            raise WebSocketError(String("Failed to send frame header"))
        }

        if size > 0 && data != null {
            var maskedBuf: ^u8 = malloc(size) !: ^u8
            defer free(maskedBuf !: ^void)
            var src = data !: ^const u8
            for (var i: 0.u64..size) {
                maskedBuf.[i] = src.[i] ^ maskKey.[i % 4]
            }
            sent = sock.sendBuffer(maskedBuf !: ^const void, size)
            if !sent || *sent != size {
                raise WebSocketError(String("Failed to send frame payload"))
            }
        }
    }
    else {
        var sent = sock.sendBuffer(ptrof header.[0], headerLen)
        if !sent || *sent != headerLen {
            raise WebSocketError(String("Failed to send frame header"))
        }
        if size > 0 && data != null {
            sent = sock.sendBuffer(data, size)
            if !sent || *sent != size {
                raise WebSocketError(String("Failed to send frame payload"))
            }
        }
    }
}

func readExact(sock: &Socket, buf: ^void, size: u64): bool {
    var ptr = buf !: ^char
    var total = 0.u64
    while total < size {
        var n = sock.receive(ptrof ptr.[total], size - total)
        if !n || *n == 0 {
            return false
        }
        total += *n
    }
    return true
}

pub class WebSocket[Context] {
    _sock: Socket
    _context: &Context
    _closed: bool = false
    _isClient: bool = false

    func `init`(sock: Socket, context: &Context, isClient: bool = false) {
        _sock = &&sock
        _context = context
        _isClient = isClient
    }

    @[prop, inline]
    func context() => _context

    @[prop, inline]
    func socket() => &_sock

    @[prop, inline]
    func isClosed() => _closed

    func send(msg: strview): !void {
        if _closed { return }
        sendFrame(&_sock, Opcode.Text, msg.data(), msg.size(), _isClient)
    }

    func send(msg: String): !void {
        if _closed { return }
        sendFrame(&_sock, Opcode.Text, msg.data(), msg.size(), _isClient)
    }

    func send(msg: string): !void {
        if _closed { return }
        sendFrame(&_sock, Opcode.Text, msg !: ^const void, len!(msg), _isClient)
    }

    func sendBinary(data: ^const void, size: u64): !void {
        if _closed { return }
        sendFrame(&_sock, Opcode.Binary, data, size, _isClient)
    }

    func ping(data: strview = "".s): !void {
        if _closed { return }
        sendFrame(&_sock, Opcode.Ping, data.data(), data.size(), _isClient)
    }

    func pong(data: strview = "".s): !void {
        if _closed { return }
        sendFrame(&_sock, Opcode.Pong, data.data(), data.size(), _isClient)
    }

    func close(code: u16 = 1000, reason: string = ""): !void {
        if _closed { return }
        _closed = true
        var payload: [u8, 128] = []
        var len16 = htons(code)
        memcpy(ptrof payload.[0], ptrof len16, 2)
        var reasonLen = len!(reason)
        if reasonLen > 125 { reasonLen = 125 }
        if reasonLen > 0 {
            memcpy(ptrof payload.[2], reason !: ^const void, reasonLen)
        }
        sendFrame(&_sock, Opcode.Close, ptrof payload.[0], 2 + reasonLen, _isClient) catch discard
        _sock.close()
    }
}

class WebSocketConnection[Application, Context]: Upgrade {
    require!(Application.isClass, "Application must be a class type")
    _app: &Application
    _ctx: Context

    func `init`(app: &Application, ctx: Context) {
        _app = app
        _ctx = ctx
    }

    @override
    func start(sock: TcpSocket): !void {
        var client = WebSocket[Context](&&sock, &_ctx, false)

        #if (has_member!(#Application, "onOpen", #func(_: &WebSocket[Context]) -> bool)) {
            if !_app.onOpen(&client) {
                client.close(1008, "Policy Violation")
                return
            }
        }
        #if (has_member!(#Application, "onConnect", #func(_: &WebSocket[Context]) -> bool)) {
            if !_app.onConnect(&client) {
                client.close(1008, "Policy Violation")
                return
            }
        }

        readLoop(&client)
    }

    - func readLoop(client: &WebSocket[Context]): void {
        var msgBuf = String()
        var curOpcode = Opcode.Continuation

        while !client.isClosed() && !!client.socket() {
            var hdr: [u8, 2] = []
            if !readExact(client.socket(), ptrof hdr.[0], 2) {
                break
            }

            var fin = (hdr.[0] & 0x80.u8) != 0
            var op = <Opcode>(hdr.[0] & 0x0F.u8)
            var masked = (hdr.[1] & 0x80.u8) != 0
            var payloadLen = <u64>(hdr.[1] & 0x7F`u8)

            if payloadLen == 126 {
                var lenBuf: [u8, 2] = []
                if !readExact(client.socket(), ptrof lenBuf.[0], 2) {
                    break
                }
                payloadLen = <u64>ntohs(*(ptrof lenBuf.[0] !: ^u16))
            }
            else if payloadLen == 127 {
                var lenBuf: [u8, 8] = []
                if !readExact(client.socket(), ptrof lenBuf.[0], 8) {
                    break
                }
                payloadLen = ntohll(*(ptrof lenBuf.[0] !: ^u64))
            }

            var mask: [u8, 4] = []
            if masked {
                if !readExact(client.socket(), ptrof mask.[0], 4) {
                    break
                }
            }

            var payload: ^char = null
            if payloadLen > 0 {
                msgBuf.reserve(payloadLen)
                payload = msgBuf.data() as ^char
                if !readExact(client.socket(), payload !: ^void, payloadLen) {
                    break
                }

                if masked {
                    var p = payload !: ^u8
                    for (var i: 0..payloadLen) {
                        p.[i] = p.[i] ^ mask.[i % 4]
                    }
                }
            }

            switch op {
                case Opcode.Ping => {
                    sendFrame(client.socket(), Opcode.Pong, payload !: ^const void, payloadLen, false) catch discard
                }
                case Opcode.Pong => {}
                case Opcode.Close => {
                    var code = 1000`u16
                    @unused var reason = "".s
                    if payloadLen >= 2 {
                        code = ntohs(*(payload !: ^u16))
                        if payloadLen > 2 {
                            reason = strview(ptroff!(payload + 2) !: string, payloadLen - 2)
                        }
                    }
                    #if (has_member!(#Application, "onClose", #func(_: &WebSocket[Context], _: u16, _: strview) -> void)) {
                        _app.onClose(client, code, reason)
                    }
                    client.close(code) catch {
                        ERR!("Failed to close WebSocket: " << ex!.what())
                    }
                    return
                }
                case Opcode.Text, Opcode.Binary => {
                    curOpcode = op
                    if payloadLen > 0 {
                        msgBuf.resize(payloadLen)
                    }
                }
                case Opcode.Continuation => {
                    if payloadLen > 0 {
                        msgBuf.resize(msgBuf.size() + payloadLen)
                    }
                }
                ... => {}
            }

            if fin && curOpcode != Opcode.Continuation {
                if curOpcode == Opcode.Text {
                    #if (has_member!(#Application, "onMessage", #func(_: &WebSocket[Context], _: strview) -> void)) {
                        _app.onMessage(client, msgBuf.s())
                    }
                }
                else if curOpcode == Opcode.Binary {
                    #if (has_member!(#Application, "onBinary", #func(_: &WebSocket[Context], _: ^const void, _: u64) -> void)) {
                        _app.onBinary(client, msgBuf.data(), msgBuf.size())
                    }
                }
                msgBuf.clear()
                curOpcode = Opcode.Continuation
            }
        }

        if !client.isClosed() {
            #if (has_member!(#Application, "onClose", #func(_: &WebSocket[Context], _: u16, _: strview) -> void)) {
                _app.onClose(client, 1006`u16, "Abnormal Closure".s)
            }
            client.close(1006) catch {
                ERR!("Failed to close WebSocket: " << ex!.what())
            }
        }
    }
}

pub func wssUpgrade[Application, Context](
    req: &const Request,
    resp: &Response,
    app:  &Application,
    ctx:  Context
): bool {
    var key = req.header(String("Sec-WebSocket-Key"))
    if !key {
        resp.end(Status.BadRequest)
        return false
    }
    var accept = computeAcceptHeader(key&.s())
    resp.header(String("Upgrade"), String("websocket"))
    resp.header(String("Connection"), String("Upgrade"))
    resp.header(String("Sec-WebSocket-Accept"), &&accept)

    resp.upgrade(WebSocketConnection[Application, Context](app, &&ctx))
    return true
}

pub class WebSocketClient {
    _sock: Socket = null
    _closed: bool = false

    func `init`(sock: Socket) {
        _sock = &&sock
    }

    @[prop, inline]
    func socket() => &_sock

    @[prop, inline]
    func isClosed() => _closed || _sock == null || !_sock

    func send(msg: strview): !void {
        if isClosed() { return }
        sendFrame(&_sock, Opcode.Text, msg.data(), msg.size(), true)
    }

    func send(msg: String): !void {
        if isClosed() { return }
        sendFrame(&_sock, Opcode.Text, msg.data(), msg.size(), true)
    }

    func send(msg: string): !void {
        if isClosed() { return }
        sendFrame(&_sock, Opcode.Text, msg !: ^const void, len!(msg), true)
    }

    func sendBinary(data: ^const void, size: u64): !void {
        if isClosed() { return }
        sendFrame(&_sock, Opcode.Binary, data, size, true)
    }

    func ping(data: strview = "".s): !void {
        if isClosed() { return }
        sendFrame(&_sock, Opcode.Ping, data.data(), data.size(), true)
    }

    func pong(data: strview = "".s): !void {
        if isClosed() { return }
        sendFrame(&_sock, Opcode.Pong, data.data(), data.size(), true)
    }

    func close(code: u16 = 1000, reason: string = ""): !void {
        if isClosed() { return }
        _closed = true
        var payload: [u8, 128] = []
        var len16 = htons(code)
        memcpy(ptrof payload.[0], ptrof len16, 2)
        var reasonLen = len!(reason)
        if reasonLen > 125 { reasonLen = 125 }
        if reasonLen > 0 {
            memcpy(ptrof payload.[2], reason !: ^const void, reasonLen)
        }
        sendFrame(&_sock, Opcode.Close, ptrof payload.[0], 2 + reasonLen, true) catch discard
        _sock.close()
    }

    virtual func listen(): void
}

class WebSocketStream[Application]: WebSocketClient {
    require!(Application.isClass, "Application must be a class")
    _app: Application

    func `init`(sock: Socket, app: Application) {
        super(&&sock)
        _app = &&app
    }

    @static
    func connect(url: strview, app: Application): !This {
        var sock = _connect(url, app)
        var client = This(&&sock, app)

        #if (has_member!(#Application, "onOpen", #func(_: WebSocketClient) -> bool)) {
            if !app.onOpen(client) {
                client.close(1008, "Policy Violation")
                return null as This
            }
        }
        #if (has_member!(#Application, "onConnect", #func() -> bool)) {
            if !app.onConnect() {
                client.close(1008, "Policy Violation")
                return null as This
            }
        }
        return &&client
    }

    @static
    func _connect(url: strview, @unused app: Application): !Socket {
        var sessUrl: String = null
        if (url.startswith("ws://".s)) {
            sessUrl = String("http://")
            sessUrl << url.substr(5)
        }
        else if (url.startswith("wss://".s)) {
            sessUrl = "https://".S
            sessUrl << url.substr(6)
        }
        else {
            sessUrl = String(url)
        }

        var sess = Session.create(sessUrl.s())
        var path = "/".s
        var idx = sessUrl.find("://")
        if (idx) {
            var hostAndPath = sessUrl.substr(*idx + 3)
            var slashIdx = hostAndPath.find("/".s)
            if (slashIdx) {
                path = hostAndPath.substr(*slashIdx)
            }
        }

        var rawKey: [u8, 16] = []
        OpenSSLRand.RAND_bytes(ptrof rawKey.[0], 16)
        var keyStr = String()
        encodeBuffer(&keyStr, ptrof rawKey.[0], 16)

        sess.header("Upgrade".S, "websocket".S)
        sess.header("Connection".S, "Upgrade".S)
        sess.header("Sec-WebSocket-Key".S, keyStr)
        sess.header("Sec-WebSocket-Version".S, "13".S)

        #if (has_member!(#Application, "configureSession", #func(_: &Session) -> void)) {
            app.configureSession(&sess)
        }

        println("WebSocketClient connecting to ", path)
        var resp = sess.perform(Method.Get, path)
        if (resp.status() != .SwitchingProtocols) {
            raise WebSocketError(f"WebSocket handshake failed: {resp.statusCode()}")
        }

        var expectedAccept = computeAcceptHeader(keyStr.s())
        var acceptHeader = resp.header("Sec-WebSocket-Accept".S)
        if (!acceptHeader || *acceptHeader != expectedAccept) {
            raise WebSocketError("Invalid Sec-WebSocket-Accept received from server")
        }

        return sess.takeSocket()
    }

    func listen(): void {
        if _closed {
            return
        }

        var msgBuf = String()
        var curOpcode = Opcode.Continuation

        while !isClosed() {
            var hdr: [u8, 2] = []
            if !readExact(_sock, ptrof hdr.[0], 2) {
                break
            }

            var fin = (hdr.[0] & 0x80`u8) != 0
            var op = <Opcode>(hdr.[0] & 0x0F`u8)
            var masked = (hdr.[1] & 0x80`u8) != 0
            var payloadLen = <u64>(hdr.[1] & 0x7F`u8)

            if payloadLen == 126 {
                var lenBuf: [u8, 2] = []
                if !readExact(_sock, ptrof lenBuf.[0], 2) {
                    break
                }
                payloadLen = <u64>ntohs(*(ptrof lenBuf.[0] !: ^u16))
            }
            else if payloadLen == 127 {
                var lenBuf: [u8, 8] = []
                if !readExact(_sock, ptrof lenBuf.[0], 8) {
                    break
                }
                payloadLen = ntohll(*(ptrof lenBuf.[0] !: ^u64))
            }

            var mask: [u8, 4] = []
            if masked {
                if !readExact(_sock, ptrof mask.[0], 4) {
                    break
                }
            }

            var payload: ^char = null
            if payloadLen > 0 {
                msgBuf.reserve(payloadLen)
                payload = msgBuf.data() as ^char
                if !readExact(_sock, payload !: ^void, payloadLen) {
                    break
                }

                if masked {
                    var p = payload !: ^u8
                    for (var i: 0..payloadLen) {
                        p.[i] = p.[i] ^ mask.[i % 4]
                    }
                }
            }

            switch op {
                case Opcode.Ping => {
                    sendFrame(_sock, Opcode.Pong, payload !: ^const void, payloadLen, true) catch discard
                }
                case Opcode.Pong => {
                    #if (has_member!(#Application, "onPong", #func(_: strview) -> void)) {
                        _app.onPong(strview(payload !: string, payloadLen))
                    }
                }
                case Opcode.Close => {
                    var code = 1000`u16
                    @unused var reason = "".s
                    if payloadLen >= 2 {
                        code = ntohs(*(payload !: ^u16))
                        if payloadLen > 2 {
                            reason = strview(ptroff!(payload + 2) !: string, payloadLen - 2)
                        }
                    }
                    #if (has_member!(#Application, "onClose", #func(_: u16, _: strview) -> void)) {
                        _app.onClose(code, reason)
                    }

                    close(code) catch {
                        ERR!("Failed to close WebSocket: " << ex!.what())
                    }
                    return
                }
                case Opcode.Text, Opcode.Binary => {
                    curOpcode = op
                    if payloadLen > 0 {
                        msgBuf.resize(payloadLen)
                    }
                }
                case Opcode.Continuation => {
                    if payloadLen > 0 {
                        msgBuf.resize(msgBuf.size() + payloadLen)
                    }
                }
                ... => {}
            }

            if fin && curOpcode != Opcode.Continuation {
                if curOpcode == Opcode.Text {
                    #if (has_member!(#Application, "onMessage", #func(_: strview) -> void)) {
                        _app.onMessage(msgBuf.s())
                    }
                }
                else if curOpcode == Opcode.Binary {
                    #if (has_member!(#Application, "onBinary", #func(_: strview) -> void)) {
                        _app.onBinary(msgBuf.data(), msgBuf.size())
                    }
                }
                msgBuf.clear()
                curOpcode = Opcode.Continuation
            }
        }

        if !isClosed() {
            #if (has_member!(#Application, "onClose", #func(_: u16, _: strview) -> void)) {
                _app.onClose(1006`u16, "Abnormal Closure".s)
            }
            close(1006) catch {
                ERR!("Failed to close WebSocket: " << ex!.what())
            }
        }
    }
}

@inline
pub func wsConnect[Application](url: strview, app: Application): !WebSocketClient {
    var stream: WebSocketClient = WebSocketStream[Application].connect(url, &&app)
    return &&stream
}
