module sort

import { Vector } from "./vector.cxy"

// Moves the median of the first, middle and last element of [lo, hi] to `lo`
func medianToFront[T](v: &Vector[T], lo: i32, hi: i32): void {
    const mid = lo + (hi - lo) / 2
    if v.[mid] < v.[lo] {
        v.swap(mid, lo)
    }
    if v.[hi] < v.[lo] {
        v.swap(hi, lo)
    }
    if v.[hi] < v.[mid] {
        v.swap(hi, mid)
    }
    if mid != lo {
        v.swap(lo, mid)
    }
}

// Quicksort of [lo, hi] with a three way partition, so that many equal elements
// are cheap. It recurses into the smaller part and loops on the larger one, which
// bounds the stack depth by log2(n).
func quicksort[T](v: &Vector[T], lo: i32, hi: i32): void {
    var low = lo
    var high = hi
    while low < high {
        medianToFront[T](v, low, high)

        // [low, lt) < pivot, [lt, i) == pivot, (gt, high] > pivot
        var lt = low
        var gt = high
        var i = low + 1
        while i <= gt {
            if v.[i] < v.[lt] {
                v.swap(lt, i)
                lt++
                i++
            } else if v.[lt] < v.[i] {
                if i != gt {
                    v.swap(i, gt)
                }
                gt--
            } else {
                i++
            }
        }

        if lt - low < high - gt {
            quicksort[T](v, low, lt - 1)
            low = gt + 1
        } else {
            quicksort[T](v, gt + 1, high)
            high = lt - 1
        }
    }
}

// Sorts `v` in place, smallest first. `T` must support `<`.
pub func sortInPlace[T](v: &Vector[T]): void {
    quicksort[T](v, 0, <i32>v.size() - 1)
}

// A sorted copy of `items`, smallest first. `T` must support `<`.
pub func sort[T](items: [T]): Vector[T] {
    const count = <i32>len!(items)
    // Vector cannot grow from a capacity of 1
    var capacity: u64 = 2
    if count > 2 {
        capacity = <u64>count
    }
    var result = Vector[T](capacity)
    for (const i: 0..count) {
        result.push(@copy items.[i])
    }
    sortInPlace[T](&result)
    return &&result
}

test "sort[i32]: orders numbers" {
    var sorted = sort[i32]([5`i32, 3`i32, 9`i32, 1`i32, 7`i32, 3`i32])
    ok!(sorted.size() == 6)
    ok!(sorted.[0] == 1)
    ok!(sorted.[1] == 3)
    ok!(sorted.[2] == 3)
    ok!(sorted.[3] == 5)
    ok!(sorted.[4] == 7)
    ok!(sorted.[5] == 9)
}

test "sort[i32]: a single element" {
    var one = sort[i32]([42`i32])
    ok!(one.size() == 1)
    ok!(one.[0] == 42)
}

test "sort[i32]: duplicates, sorted and reversed input" {
    var same = sort[i32]([7`i32, 7`i32, 7`i32, 7`i32, 7`i32])
    ok!(same.size() == 5)
    ok!(same.[0] == 7 && same.[4] == 7)

    var up = sort[i32]([1`i32, 2`i32, 3`i32, 4`i32, 5`i32, 6`i32])
    var down = sort[i32]([6`i32, 5`i32, 4`i32, 3`i32, 2`i32, 1`i32])
    for (const i: 0..6) {
        ok!(up.[i] == i + 1)
        ok!(down.[i] == i + 1)
    }

    var mixed = sort[i32]([2`i32, 1`i32, 2`i32, 1`i32, 2`i32, 1`i32, 3`i32, 3`i32])
    ok!(mixed.[0] == 1 && mixed.[2] == 1)
    ok!(mixed.[3] == 2 && mixed.[5] == 2)
    ok!(mixed.[6] == 3 && mixed.[7] == 3)
}

test "sort[i32]: the input is left as it was" {
    var data = [3`i32, 1`i32, 2`i32]
    var sorted = sort[i32](data)
    ok!(data.[0] == 3 && data.[1] == 1 && data.[2] == 2)
    ok!(sorted.[0] == 1 && sorted.[1] == 2 && sorted.[2] == 3)
}

test "sort[i32]: a large pseudo random input" {
    var sorted = Vector[i32]()
    var seed: u32 = 12345
    for (const i: 0..5000) {
        seed = seed * 1103515245 + 12345
        sorted.push(<i32>((seed >> 8) % 1000))
    }
    sortInPlace[i32](&sorted)
    ok!(sorted.size() == 5000)
    for (const i: 1..5000) {
        ok!(sorted.[i - 1] <= sorted.[i])
    }
}

test "sort[f64]: orders floats" {
    var sorted = sort[f64]([2.5`f64, -1.0`f64, 9.75`f64, 0.0`f64])
    ok!(sorted.[0] == -1.0 && sorted.[1] == 0.0)
    ok!(sorted.[2] == 2.5 && sorted.[3] == 9.75)
}

test "sortInPlace: an empty vector" {
    var empty = Vector[i32]()
    sortInPlace[i32](&empty)
    ok!(empty.size() == 0)
}

class Item {
    id: i32
    func `init`(id: i32) { this.id = id }
    const func `<`(other: &const This) => id < other.id
}

test "sort[T]: orders classes by their own `<`" {
    var items = [Item(3), Item(1), Item(2)]
    var sorted = sort[Item](items)
    ok!(sorted.size() == 3)
    ok!(sorted.[0].id == 1)
    ok!(sorted.[1].id == 2)
    ok!(sorted.[2].id == 3)
    ok!(items.[0].id == 3)
}

test "sort[String]: orders strings alphabetically, not by length" {
    var names = [String("zeta"), String("beta"), String("alpha"), String("abc"), String("ab"), String("b")]
    var sorted = sort[String](names)
    ok!(sorted.[0] == "ab")
    ok!(sorted.[1] == "abc")
    ok!(sorted.[2] == "alpha")
    ok!(sorted.[3] == "b")
    ok!(sorted.[4] == "beta")
    ok!(sorted.[5] == "zeta")
}
