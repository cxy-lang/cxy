module yaml

import { Value } from "stdlib/value.cxy"
import { Vector } from "stdlib/vector.cxy"
import { YamlParser } from "./yaml/parser.cxy"
import { YamlSerializer } from "./yaml/serializer.cxy"
import { YamlError as _YamlError } from "./yaml/common.cxy"

// Re-export common types for user convenience
pub type YamlError = _YamlError

/*
 * Parse a YAML string into a Value
 *
 * The stream must hold exactly one document, use parseAll() for several.
 *
 * Example:
 *   var data = parse("name: John\nage: 30")
 *   var name = data.["name"]
 *
 * Throws YamlError on parse errors
 */
pub func parse(str: strview): !Value {
    var parser = YamlParser(str)
    return parser.parse()
}

/*
 * Parse a YAML stream into one Value per document
 */
pub func parseAll(str: strview): !Vector[Value] {
    var parser = YamlParser(str)
    return parser.parseAll()
}

/*
 * Parse a YAML string and cast to a specific type
 *
 * Similar to fromJson, parses YAML and casts the result to type T
 *
 * Example:
 *   struct Config { name: String, port: i64 }
 *   var config = fromYaml[Config]("name: MyApp\nport: 8080")
 *
 * Throws YamlError on parse errors or cast errors
 */
pub func fromYaml[T](str: strview, b64: bool = true): !T {
    var value = parse(str)
    #if #T == #Value {
        return &&value
    }
    else {
        return value.cast[T](b64)
    }
}

/*
 * Serialize a Value to YAML, writing to an OutputStream
 *
 * Parameters:
 *   os: Output stream to write YAML to
 *   value: The Value to serialize
 *   indent: Number of spaces per indentation level (default: 2)
 *
 * Example:
 *   var data = Value.Object()
 *   data.["name"] = Value("MyApp")
 *   dump(&stdout, &data)
 *   // Output: name: MyApp
 */
pub func dump(os: &OutputStream, value: &const Value, indent: u32 = 2) {
    var serializer = YamlSerializer(os, indent)
    serializer.serialize(value)
}

/*
 * Serialize a Value to YAML string
 *
 * Convenience wrapper around dump() that returns a String
 *
 * Parameters:
 *   value: The Value to serialize
 *   indent: Number of spaces per indentation level (default: 2)
 *
 * Returns: YAML string representation
 *
 * Example:
 *   var data = Value.Object()
 *   data.["name"] = Value("MyApp")
 *   var yaml = stringify(&data)
 *   // Output: name: MyApp
 */
pub func stringify(value: &const Value, indent: u32 = 2): String {
    var output = String()
    dump(&output, value, indent)
    return &&output
}

/*
 * Serialize a native type to YAML
 *
 * Parameters:
 *   os: Output stream to write to
 *   it: The value to serialize
 *   indent: Indentation size (default: 2)
 */
pub func toYaml[T](os: &OutputStream, it: &const T, indent: u32 = 2) : void {
    var serializer = YamlSerializer(os, indent)
    serializer.toYaml[T](it)
}

// Tests

test {
    struct Person {
        func `init`(){}
        name: String = null
        age: i64 = 0
    }

    struct Config {
        func `init`(){}

        name: String = null
        debug: bool = false
        port: i64 = 0
    }

    struct App {
        func `init`(){}
        version: String = null
        config = Config()
    }
}

test "parse - multiple documents" {
    var input = """
---
name: First
---
name: Second
"""
    var result = parseAll(input)
    ok!(result.size() == 2)

    var doc0 = result.[0]
    ok!(doc0.isObject())
    var name0 = doc0.get("name")
    ok!(!!name0 && name0&.asString() == "First")

    var doc1 = result.[1]
    ok!(doc1.isObject())
    var name1 = doc1.get("name")
    ok!(!!name1 && name1&.asString() == "Second")
}

test "fromYaml - struct casting" {
    var person = fromYaml[Person]("name: John\nage: 30")
    ok!(person.name == "John")
    ok!(person.age == 30)
}

test "fromYaml - nested struct" {
    var input = """
version: '1.0'
config:
  name: MyApp
  debug: true
  port: 8080
"""

    var app = fromYaml[App](input)
    ok!(app.version == "1.0")
    ok!(app.config.name == "MyApp")
    ok!(app.config.debug == true)
    ok!(app.config.port == 8080)
}

test "parse - complex pipeline with nested list mappings" {
    var input = """
cache:
  key: "app-build-cache-v1"
  paths:
    - .cache/build

artifacts:
  - name: "app-binaries"
    when: on_success
    paths:
      - bin
  - name: dist-bundle
    when: always
    paths:
      - dist

steps:
  - name: Run Build Script
    run: ./build.sh
  - name: Verify Binary
    run: ./bin/app
"""
    var result = parse(input)
    ok!(result.isObject())

    var artifacts = result.["artifacts"]
    ok!(!!artifacts && artifacts&.isArray())
    ok!(artifacts&.size() == 2)

    var steps = result.["steps"]
    ok!(!!steps && steps&.isArray())
    ok!(steps&.size() == 2)
}

test "stringify - simple scalar" {
    var value = Value("hello")
    var yaml = stringify(&value)
    ok!(yaml == "hello")
}

test "stringify - simple object" {
    var obj = Value.Object()
    obj.["name"] = Value("MyApp")
    obj.["version"] = Value(1.0)

    var yaml = stringify(&obj)
    ok!(yaml.contains("name: MyApp"))
    ok!(yaml.contains("version: 1"))
}

test "stringify - reserved words get quoted" {
    var obj = Value.Object()
    obj.["value"] = Value("true")

    var yaml = stringify(&obj)
    ok!(yaml.contains("value: \"true\""))
}

test "dump - writes to output stream" {
    var value = Value("test")
    var output = String()
    dump(&output, &value)
    ok!(output == "test")
}
