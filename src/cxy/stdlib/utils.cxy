module utils

import Vector from "./vector.cxy"

func _hexCharToValue(c: char): i8 {
    if (c >= '0' && c <= '9') {
        return (c - '0') as i8
    } else if (c >= 'a' && c <= 'f') {
        return (c - 'a' + 10) as i8
    } else if (c >= 'A' && c <= 'F') {
        return (c - 'A' + 10) as i8
    }
    return -1
}

/*
 * Read a hexadecimal escape sequence from a string
 *
 * Parameters:
 *   s: string to read from
 *   start: starting position in the string
 *   digits: number of hex digits to read (e.g., 2 for \xNN, 4 for \uNNNN)
 *
 * Returns: (value, newPosition) where value is the parsed hex value
 *          and newPosition is the position after the hex digits
 *
 * Throws: InvalidArgumentError if invalid hex digit or not enough digits
 */
pub func readHexEscape(s: strview, start: u64, digits: u32): !(u32, u64) {
    var value: u32 = 0
    var end = start + digits

    for pos: start..end {
        if pos >= s.size() {
            raise InvalidArgumentError("Incomplete hex escape sequence")
        }

        var c = s.[pos]
        var hexDigit = _hexCharToValue(c)

        if hexDigit < 0 {
            raise InvalidArgumentError("Invalid hex digit in escape sequence")
        }

        value = (value << 4) | <u32>hexDigit
    }

    return (value, end)
}



func fromHex(hexStr: strview, data: ^void, len: u64): !void {
    var p = data !: ^u8
    var size = hexStr.size()

    // Hex string must have even length
    if size % 2 != 0 {
        raise InvalidArgumentError("Invalid hex string: odd length")
    }

    if len < size/2 {
        raise InvalidArgumentError("Output buffer too small")
    }

    for i: 0..size {
        if i % 2 == 0 {
            var high = _hexCharToValue(hexStr.[i])
            var low = _hexCharToValue(hexStr.[i + 1])

            if high < 0 || low < 0 {
                raise InvalidArgumentError("Invalid hex character")
            }

            var byte = <u8>((high << 4) | low)
            p.[i/2] = byte;
        }
    }
}

pub func split(s: strview, delims: strview): Vector[strview] {
    var parts = Vector[strview]()
    var start = 0 as i64
    var len = s.size() as i64
    for i: 0..len {
        if delims.contains(s.[i]) {
            if start <= i {
                parts.push(s.substr(start, i - start))
            }
            start = i + 1
        }
    }

    if start < len {
        parts.push(s.substr(start, len - start))
    }

    return parts
}

pub func toLower(s: strview): String {
    var result = String()
    for c, _ in s {
        if c >= 'A' && c <= 'Z' {
            result << <char>(c + ('a' - 'A'))
        } else {
            result << c
        }
    }
    return &&result
}

pub func toUpper(s: strview): String {
    var result = String()
    for c, _ in s {
        if c >= 'a' && c <= 'z' {
            result << <char>(c - ('a' - 'A'))
        } else {
            result << c
        }
    }
    return &&result
}

pub func escapeHtml(os: &OutputStream, s: strview) {
    for i in 0..s.size() {
        var c = s.[i]
        switch (c) {
            case '&'  as char => os << "&amp;"
            case '<'  as char => os << "&lt;"
            case '>'  as char => os << "&gt;"
            case '"'  as char => os << "&quot;"
            case '\'' as char => os << "&#39;"
            ...           => os << c
        }
    }
}

test "readHexEscape valid" {
    var val = readHexEscape("1A", 0, 2)
    ok!(val.0 == 0x1A)
    ok!(val.1 == 2)

    val = readHexEscape("00FF", 0, 4)
    ok!(val.0 == 0xFF)
    ok!(val.1 == 4)

    val = readHexEscape("prefixA5suffix", 6, 2)
    ok!(val.0 == 0xA5)
    ok!(val.1 == 8)
}

test "readHexEscape invalid" {
    var failed = false
    readHexEscape("1G", 0, 2) catch {
        failed = true
    }
    ok!(failed)

    failed = false
    readHexEscape("1", 0, 2) catch {
        failed = true
    }
    ok!(failed)
}

test "fromHex valid" {
    var buf: [u8, 3]
    fromHex("01aBff", ptrof buf, 3)
    ok!(buf.[0] == 0x01)
    ok!(buf.[1] == 0xAB)
    ok!(buf.[2] == 0xFF)
}

test "fromHex invalid" {
    var buf: [u8, 2]
    var failed = false
    fromHex("abc", ptrof buf, 2) catch {
        failed = true
    }
    ok!(failed)

    failed = false
    fromHex("abcd", ptrof buf, 1) catch {
        failed = true
    }
    ok!(failed)

    failed = false
    fromHex("zz", ptrof buf, 2) catch {
        failed = true
    }
    ok!(failed)
}

test "split string" {
    var parts = split("a,b,c", ",")
    ok!(parts.size() == 3)
    ok!(parts.[0] == "a")
    ok!(parts.[1] == "b")
    ok!(parts.[2] == "c")

    parts = split("hello world foo", " ")
    ok!(parts.size() == 3)
    ok!(parts.[0] == "hello")
    ok!(parts.[1] == "world")
    ok!(parts.[2] == "foo")

    parts = split("one;two,three", ",;")
    ok!(parts.size() == 3)
    ok!(parts.[0] == "one")
    ok!(parts.[1] == "two")
    ok!(parts.[2] == "three")
}

test "toLower and toUpper" {
    var lower = toLower("Hello, WORLD 123!")
    ok!(lower == "hello, world 123!")

    var upper = toUpper("Hello, world 123!")
    ok!(upper == "HELLO, WORLD 123!")
}

test "escapeHtml" {
    var os = String()
    escapeHtml(&os, "<a href=\"test\" data='val'>Tom & Jerry</a>")
    ok!(os == "&lt;a href=&quot;test&quot; data=&#39;val&#39;&gt;Tom &amp; Jerry&lt;/a&gt;")
}
