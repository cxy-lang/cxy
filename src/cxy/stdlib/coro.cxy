module coro

import "unistd.h" as unistd
import "sys/mman.h" as vmem
import "native/evloop/ae.h" as ae

##if (defined __CXY_THREADS_ENABLED__) {
    import "native/thread/tinythread.h" as tinyThread
    __cc "native/thread/tinythread.c"
}

import { Atomic } from "./atomic.cxy"
import { List } from "./list.cxy"
import { CircularBuffer } from "./buffer.cxy"

@__cc "native/evloop/ae.c"

type Stack = ^void

pub type State = ae.State

#if (defined __x86_64) {
    // rbx, rbp, r12-r15, rsp, rip
    macro CXY_CTX_SIZE 8

    macro __cxy_coro_setjmp(ctx) =({
        @volatile var ret: i32 = 0;
        @volatile asm("""
            lea LJMPRET$=(%rip), %rcx
            xor $0, $0
            movq %rbx,   ($1)
            movq %rbp,  8($1)
            movq %r12, 16($1)
            movq %r13, 24($1)
            movq %r14, 32($1)
            movq %r15, 40($1)
            movq %rsp, 48($1)
            movq %rcx, 56($1)
            LJMPRET$=:
            """ :
            "=&r"(ret) :
            "r" (ctx!) :
            "memory", "rcx", "rsi", "rdi", "r8", "r9", "r10", "r11", "cc"
        )
        ret;
    })

    macro __cxy_coro_longjmp(ctx) {
        @volatile asm("""
            movq    $$1, %rdx
            movq 56($0), %rcx
            movq 48($0), %rsp
            movq 40($0), %r15
            movq 32($0), %r14
            movq 24($0), %r13
            movq 16($0), %r12
            movq  8($0), %rbp
            movq   ($0), %rbx
            .cfi_def_cfa %rdx, 0
            .cfi_offset %rbx, 0
            .cfi_offset %rbp, 8
            .cfi_offset %r12, 16
            .cfi_offset %r13, 24
            .cfi_offset %r14, 32
            .cfi_offset %r15, 40
            .cfi_offset %rsp, 48
            .cfi_offset %rip, 56
            jmp    *%rcx
            """ : :
            "r"(ctx!) :
            "rdx"
        )
    }

    macro __cxy_coro_setsp(x) {
        @volatile asm("": :"r"(alloca!(#u64)))
        @volatile asm("leaq (%rax), %rsp" : : "rax"(x!))
    }

}
else #if (defined __aarch64__) {
    // sp, lr(PC), x19-x29 (11 regs), d8-d15 (8 FP regs) = 22 slots
    macro CXY_CTX_SIZE 22

    macro __cxy_coro_setjmp(ctx) =({
        @[volatile, register("x0")] var ret: i64 = 0
        @volatile asm("""
            adr x17, LJMPRET$=
            mov $0, #0
            mov x16, $1
            mov x2, sp
            stp x17, x2, [x16]
            stp x19, x20, [x16, #16]
            stp x21, x22, [x16, #32]
            stp x23, x24, [x16, #48]
            stp x25, x26, [x16, #64]
            stp x27, x28, [x16, #80]
            stp x29, x30, [x16, #96]
            stp d8,  d9,  [x16, #112]
            stp d10, d11, [x16, #128]
            stp d12, d13, [x16, #144]
            stp d14, d15, [x16, #160]
            LJMPRET$=:
            """ :
            "=&r"(ret) :
            "r"(ctx!) :
            "memory", "x16", "x17", "x2"
        )
        ret;
    })

    macro __cxy_coro_longjmp(ctx) {
        @volatile asm("""
            mov x16, $0
            ldp x17, x2, [x16]
            mov sp, x2
            ldp x19, x20, [x16, #16]
            ldp x21, x22, [x16, #32]
            ldp x23, x24, [x16, #48]
            ldp x25, x26, [x16, #64]
            ldp x27, x28, [x16, #80]
            ldp x29, x30, [x16, #96]
            ldp d8,  d9,  [x16, #112]
            ldp d10, d11, [x16, #128]
            ldp d12, d13, [x16, #144]
            ldp d14, d15, [x16, #160]
            mov x0, #1
            br x17
            """ : :
            "r"(ctx!) :
            "memory"
        )
    }

    macro __cxy_coro_setsp(x) {
        @volatile asm("": :"r"(alloca!(#u64)))
        @volatile asm("mov sp, $0" : : "r"(x!))
    }

}
else #if (defined __arm__) {
    // r4-r11 (8 regs), sp, lr = 10 slots (32-bit values in u64 array)
    macro CXY_CTX_SIZE 10

    #const _ = warn!("arm32 coroutine inline asm is untested - proceed with caution")

    macro __cxy_coro_setjmp(ctx) =({
        @volatile var ret: i32 = 0;
        @volatile asm("""
            adr r2, LJMPRET$=
            mov $0, #0
            mov r3, $1
            str r2, [r3, #0]
            str sp, [r3, #8]
            str lr, [r3, #16]
            str r4, [r3, #24]
            str r5, [r3, #32]
            str r6, [r3, #40]
            str r7, [r3, #48]
            str r8, [r3, #56]
            str r9, [r3, #64]
            str r10, [r3, #72]
            str r11, [r3, #80]
            LJMPRET$=:
            """ :
            "=&r"(ret) :
            "r"(ctx!) :
            "memory", "r2", "r3"
        )
        ret;
    })

    macro __cxy_coro_longjmp(ctx) {
        @volatile asm("""
            mov r3, $0
            ldr r2, [r3, #0]
            ldr sp, [r3, #8]
            ldr lr, [r3, #16]
            ldr r4, [r3, #24]
            ldr r5, [r3, #32]
            ldr r6, [r3, #40]
            ldr r7, [r3, #48]
            ldr r8, [r3, #56]
            ldr r9, [r3, #64]
            ldr r10, [r3, #72]
            ldr r11, [r3, #80]
            mov r0, #1
            bx r2
            """ : :
            "r"(ctx!) :
            "memory"
        )
    }

    macro __cxy_coro_setsp(x) {
        @volatile asm("": :"r"(alloca!(#u64)))
        @volatile asm("mov sp, $0" : : "r"(x!))
    }

}
else #if (defined __powerpc64__) {
    // r1(sp), lr, r14-r31 (18 regs), f14-f31 (18 FP regs) = 38 slots
    // + 2 for alignment/padding = 40 slots
    macro CXY_CTX_SIZE 40

    #const _ = warn!("ppc64v2 coroutine inline asm is untested - proceed with caution")

    macro __cxy_coro_setjmp(ctx) =({
        @volatile var ret: i64 = 0;
        @volatile asm("""
            mflr 0
            std 0, 0($1)
            std 1, 8($1)
            li $0, 0
            std 14, 16($1)
            std 15, 24($1)
            std 16, 32($1)
            std 17, 40($1)
            std 18, 48($1)
            std 19, 56($1)
            std 20, 64($1)
            std 21, 72($1)
            std 22, 80($1)
            std 23, 88($1)
            std 24, 96($1)
            std 25, 104($1)
            std 26, 112($1)
            std 27, 120($1)
            std 28, 128($1)
            std 29, 136($1)
            std 30, 144($1)
            std 31, 152($1)
            stfd 14, 160($1)
            stfd 15, 168($1)
            stfd 16, 176($1)
            stfd 17, 184($1)
            stfd 18, 192($1)
            stfd 19, 200($1)
            stfd 20, 208($1)
            stfd 21, 216($1)
            stfd 22, 224($1)
            stfd 23, 232($1)
            stfd 24, 240($1)
            stfd 25, 248($1)
            stfd 26, 256($1)
            stfd 27, 264($1)
            stfd 28, 272($1)
            stfd 29, 280($1)
            stfd 30, 288($1)
            stfd 31, 296($1)
            """ :
            "=&r"(ret) :
            "b"(ctx!) :
            "memory", "0"
        )
        ret;
    })

    macro __cxy_coro_longjmp(ctx) {
        @volatile asm("""
            ld 0, 0($0)
            ld 1, 8($0)
            ld 14, 16($0)
            ld 15, 24($0)
            ld 16, 32($0)
            ld 17, 40($0)
            ld 18, 48($0)
            ld 19, 56($0)
            ld 20, 64($0)
            ld 21, 72($0)
            ld 22, 80($0)
            ld 23, 88($0)
            ld 24, 96($0)
            ld 25, 104($0)
            ld 26, 112($0)
            ld 27, 120($0)
            ld 28, 128($0)
            ld 29, 136($0)
            ld 30, 144($0)
            ld 31, 152($0)
            lfd 14, 160($0)
            lfd 15, 168($0)
            lfd 16, 176($0)
            lfd 17, 184($0)
            lfd 18, 192($0)
            lfd 19, 200($0)
            lfd 20, 208($0)
            lfd 21, 216($0)
            lfd 22, 224($0)
            lfd 23, 232($0)
            lfd 24, 240($0)
            lfd 25, 248($0)
            lfd 26, 256($0)
            lfd 27, 264($0)
            lfd 28, 272($0)
            lfd 29, 280($0)
            lfd 30, 288($0)
            lfd 31, 296($0)
            mtlr 0
            li 3, 1
            blr
            """ : :
            "b"(ctx!) :
            "memory"
        )
    }

    macro __cxy_coro_setsp(x) {
        @volatile asm("": :"r"(alloca!(#u64)))
        @volatile asm("mr 1, $0" : : "r"(x!))
    }

}
else {
    #const _ = error!("Unsupported platform for coroutine context switching - supported architectures: x86_64, aarch64, arm32, ppc64v2")
}

#if (defined __DEBUG && defined TRACE_CORO) {
    @[pure, linkage("External")]
    func __trace_coro_stdout(
        tag: string,
        path: string,
        line: u64,
        coro_name: string,
        coro_id: i32,
        sched_id: i32,
        coro_ptr: ^void,
        origin_file: string,
        origin_line: u64,
        tid: u64
    ) {
        if (coro_ptr != null) {
            printf(" coro(%-7.7s: [tid=%llu] [sched=%d] '%s':%d at %p origin=%s:%llu) @ %s:%llu\n",
                tag, tid, sched_id, (coro_name != null ? coro_name : "anon"), coro_id, coro_ptr,
                (origin_file != null ? origin_file : "unknown"), origin_line, path, line)
        } else {
            printf(" coro(%-7.7s: (null)) @ %s:%llu\n", tag, path, line)
        }
    }

    pub extern func __trace_coro_custom(
        tag: string,
        path: string,
        line: u64,
        coro_name: string,
        coro_id: i32,
        sched_id: i32,
        coro_ptr: ^void,
        origin_file: string,
        origin_line: u64,
        tid: u64
    ): void
}

@align(16)
pub struct Coroutine {
    link: ^This = null;
    scheduler: ^void = null;
    id: i32 = -1;
    result: i32 = 0;
    /* When the coroutine is suspended 'ctx' holds the context (registers and such).*/
    ctx: [u64, CXY_CTX_SIZE!]
    ready : bool = false; /* Set when the coroutine has finished its execution. */
    promise: ^void = null
    name: string = null
    file: string = null
    line: u64 = 0
    schedId: i32 = -1
    /* Owning task, null when spawned without one */
    task: ^void = null
    /* Set only while blocked in a wait that cancel() may interrupt */
    interruptible: bool = false
    #if (defined __CXY_THREADS_ENABLED__) {
        tid: u64 = 0;
    }

    #if (defined CORO_VALGRIND) {
        /*
         * Valgrind stack identifier. This way, valgrind knows which areas of
         * memory are used as stacks, and so it doesn't produce spurious warnings.
         * Well, sort of. The mechanism is not perfect, but it's still better
         * than nothing.
         */
        sid: i32 = -1;
    }

    func `init`(name: string = null, id: i32 = -1) {
        this.name = name
        this.id = id
    }
}

#if (defined __DEBUG && defined TRACE_CORO) {
    @inline
    func __trace_coro_fwd(tag: string, cr: ^Coroutine, path: string, line: u64) {
        if (cr != null) {
            // `tid` only exists when threads are enabled
            var tid = 0`u64
            #if (defined __CXY_THREADS_ENABLED__) {
                tid = cr.tid
            }
            (TRACE_CORO!)(tag, path, line, cr.name, cr.id, cr.schedId, cr !: ^void, cr.file, cr.line, tid)
        } else {
            (TRACE_CORO!)(tag, path, line, null, -1, -1, null, null, 0`u64, 0`u64)
        }
    }
    macro __TRACE_CORO(TAG, CR, FILE, LINE) __trace_coro_fwd(TAG!, CR!, FILE!, LINE!)
} else {
    macro __TRACE_CORO(TAG, CR, FILE, LINE) {}
}

@inline
func stackAlign(size: u64, align: u64) =>
    ((size + (align - 1)) & ~(align - 1)) + align

#if (! defined CORO_STACK_SIZE) {
    // 256kb stack by default
    macro CORO_STACK_SIZE() 1024`u64 * 1024`u64
}

var stackSize = stackAlign(CORO_STACK_SIZE!, SysConfPageSize);

var __cxy_coro_sched_id_gen = Atomic[i32]();

struct CachedStack {
    link: ^This
}

macro MAX_CACHED_STACKS 32`u64

class CoroutineScheduler {
    id: i32 = 0;
    running: ^Coroutine = null; /* Currently running coroutine. */
    /* List of coroutines ready for execution. */
    - ready = List[Coroutine]{};
    #if (defined __CXY_THREADS_ENABLED__) {
        - pending = List[Coroutine]{};
        - pendingMtx = tinyThread.mtx_t{};
    }
    - mainName: [char, 32];
    /* Coroutine that we don't launch */
    - main = Coroutine(null, 0);
    /* Cache some stacks */
    - stacks = List[CachedStack]{};
    /* Coroutine ID generator */
    - idGenerator: i32 = 1;
    /* Counter used in rescheduling coroutines */
    - counter : i32 = 0;
    /* Event loop for handling IO events */
    eventLoop : ^ae.aeEventLoop = null;
    #if (defined __CXY_THREADS_ENABLED__) {
        threadId: u64 = 0;
    }

    func `init`() {
        this.id = __cxy_coro_sched_id_gen.fetchAdd(1)
        sprintf(ptrof mainName.[0] !: ^char, "main-%d", this.id)
        main.name = ptrof mainName.[0] !: string
        main.id = 0
        main.schedId = this.id
        main.scheduler = (this !: ^void);
        running = ptrof main
        eventLoop = ae.aeCreateEventLoop(this !: ^void, 1024);
        #if (defined __CXY_THREADS_ENABLED__) {
            tinyThread.mtx_init(ptrof pendingMtx, mtx_plain!);
            tinyThread.thrd_id(tinyThread.thrd_current(), ptrof threadId);
            main.tid = threadId;
        }
    }

    - func allocStack() {
        var ptr: ^void = null;
        var stack = stacks.pop();
        if (stack != null) {
            ptr = (stack !: ^void);
        }
        else {
            ptr = vmem.mmap(
                null,
                stackSize,
                PROT_READ! | PROT_WRITE!,
                MAP_PRIVATE! | MAP_ANONYMOUS!,
                -1,
                0
            );
        }
        var top = (ptr !: ^u8) + stackSize;
        return top !: ^void
    }

    - func freeStack(ptr: ^void) {
        if (stacks.count >= MAX_CACHED_STACKS!) {
            // delete the oldest stack
            var stack = stacks.pop();
            vmem.munmap(stack !: ^void, stackSize)
        }
        else {
            // cache the stack
            var base = (ptr !: ^u8) + (-stackSize);
            stacks.push(base !: ^CachedStack);
        }
    }

    @inline
    - func eventLoopWait(timeout: i64 = -1) {
        ae.aeProcessEvents(
            eventLoop,
            ae.Flags.AE_FILE_EVENTS | ae.Flags.AE_TIME_EVENTS,
            timeout
        )
    }

    @private
    func processPending() {
        #if (defined __CXY_THREADS_ENABLED__) {
            // Fast path: check without locking
            if pending.empty() {
                return
            }

            // Lock and drain the queue
            tinyThread.mtx_lock(ptrof pendingMtx)
            defer tinyThread.mtx_unlock(ptrof pendingMtx)

            while {
                var coro = pending.pop()
                if (coro == null)
                    break

                // Move to ready queue (Coroutine.link reused!)
                coro.ready = true
                ready.push(coro)
            }
        }
        // noop if threads are disabled
    }

    @[static]
    func eventLoopCallback(loop: ^ae.aeEventLoop, @unused fd: i32, arg: ^void, mask: i32) {
        // resume the coroutine waiting for the event
        var scheduler = &(loop.context !: This)
        var cr = arg !: ^Coroutine;
        // printf("    fev(%p, %s:%p)\n", scheduler.running, cr.name, cr)
        scheduler.resume(cr, mask)
    }

    @[static]
    func eventLoopTimerFired(loop: ^ae.aeEventLoop, id: i64, arg: ^void): ae.Status {
        // resume the coroutine waiting for the timer
        var scheduler = &(loop.context !: This)
        var cr = arg !: ^Coroutine;
        scheduler.resume(cr, <i32>id)
        return ae.Status.AE_NO_MORE;
    }

    func suspend() : i32 {
        #if (defined __CXY_THREADS_ENABLED__) {
            processPending()
        }

        if(counter >= 103) {
            eventLoopWait(0)
            counter = 0
        }

        if (running != null) {
            __TRACE_CORO!("suspend", running, file!, line!)
            if (__cxy_coro_setjmp!(ptrof this.running.ctx)) {
                return running.result
            }
        }

        while {
            #if (defined __CXY_THREADS_ENABLED__) {
                processPending()
            }
            var coro = ready.pop();
            if (coro != null) {
                counter++;
                assert!(coro.ready)
                coro.ready = false
                __TRACE_CORO!("switch", coro, file!, line!)
                running = coro
                __cxy_coro_longjmp!(ptrof coro.ctx)
            }

            eventLoopWait();
            counter = 0;
        }
        return 0;
    }

    /* Like suspend() but a cancel may resume the coroutine early */
    func suspendInterruptible(): i32 {
        var cr = running
        cr.interruptible = true
        var result = suspend()
        cr.interruptible = false
        return result
    }

    func resume(cr: ^Coroutine, res: i32): void {
        #if (defined __CXY_THREADS_ENABLED__) {
            assert!((cr.scheduler !: ^void) == (this !: ^void))
        }
        // already queued, a second push would corrupt the ready list
        if (cr.ready)
            return
        __TRACE_CORO!("resume", cr, file!, line!)
        cr.ready = true;
        cr.result = res
        ready.push(cr)
    }

    /* A queued coroutine keeps its place, only its result is replaced */
    func resumeCancel(cr: ^Coroutine): void {
        if (cr.ready) {
            cr.result = <i32>ae.Status.AE_CANCELLED
            return
        }
        resume(cr, <i32>ae.Status.AE_CANCELLED)
    }

    #if (defined __CXY_THREADS_ENABLED__) {
        func resumeAndWake(cr: ^Coroutine, res: i32): void {
            __TRACE_CORO!("wake", cr, file!, line!)

            // Add to pending queue (thread-safe), once
            tinyThread.mtx_lock(ptrof pendingMtx)
            if (!cr.ready) {
                cr.ready = true;
                cr.result = res
                pending.push(cr)
            }
            tinyThread.mtx_unlock(ptrof pendingMtx)

            // Wake up the event loop
            ae.aeWakeup(eventLoop)
        }
    }

    func yld() {
        resume(running, 0)
        suspend()
    }

    func prologue(name: string, file: string, line: u64) {
        var stack = allocStack();
        var cr = ptroff!((stack !: ^Coroutine) + (-1));
        cr.link = null
        cr.scheduler = (this !: ^void);
        cr.schedId = this.id
        cr.id = idGenerator++
        cr.ready = false;
        cr.task = null
        cr.interruptible = false
        cr.name = name
        cr.file = file
        cr.line = line
        #if (defined __CXY_THREADS_ENABLED__) {
            cr.tid = threadId;
        }
        __TRACE_CORO!("spawn", cr, file, line)
        resume(running, 0)
        running = cr
        return cr
    }

    func epilogue() {
        var cr = running;
        var sp = ptroff!(cr + 1);
        __TRACE_CORO!("exit", cr, file!, line!)
        running = null
        freeStack(sp !: ^void)

        suspend()
    }

    func fdWaitWrite(fd: i32, timeout: u64) {
        var status = ae.aeCreateFileEvent(
            eventLoop,
            fd,
            ae.State.AE_WRITABLE,
            eventLoopCallback,
            running !: ^void,
            timeout
        );
        if (status == ae.Status.AE_OK) {
            // suspend the current coroutine
            var result = suspendInterruptible();
            ae.aeDeleteFileEvent(eventLoop, fd, ae.State.AE_WRITABLE)
            return result
        }
        return status
    }

    func fdWaitRead(fd: i32, timeout: u64) {
        var status = ae.aeCreateFileEvent(
            eventLoop,
            fd,
            ae.State.AE_READABLE,
            eventLoopCallback,
            running !: ^void,
            timeout
        );
        if (status == .AE_OK) {
            // suspend the current coroutine
            var result = suspendInterruptible();
            ae.aeDeleteFileEvent(eventLoop, fd, ae.State.AE_READABLE)
            return result
        }
        return status
    }

    // Waits for `pid` to exit through an fd that turns readable on exit
    func pidWait(pid: i32, timeout: u64 = 0) {
        var fd = ae.aeOpenPidFd(pid)
        if (fd < 0)
            return ae.Status.AE_ERR
        var result = fdWaitRead(fd, timeout)
        unistd.close(fd)
        return result
    }

    func sleep(ms: i64) {
        if (ms > 0) {
            @unused var status = ae.aeCreateTimeEvent(
                eventLoop,
                ms,
                eventLoopTimerFired,
                running !: ^void,
                null
            );
            assert!(status != .AE_ERR)
            suspendInterruptible()
            // an early wake must not leave the timer armed
            ae.aeDeleteTimeEvent(eventLoop, status)
        }
    }

    /* `interruptible` must be false while queued on a waiter list */
    func timeout(ms: i64, interruptible: bool = true) {
        if (ms > 0) {
            @unused var status = ae.aeCreateTimeEvent(
                eventLoop,
                ms,
                eventLoopTimerFired,
                running !: ^void,
                null
            );
            assert!(status != .AE_ERR)
            var by = interruptible ? suspendInterruptible() : suspend()
            ae.aeDeleteTimeEvent(eventLoop, status)
            if (by == <i32>ae.Status.AE_CANCELLED)
                return false
            return by == status
        }
        else {
            if (interruptible) {
                suspendInterruptible()
            } else {
                suspend()
            }
            return false
        }
    }

    func `deinit`() {
        #if (defined __CXY_THREADS_ENABLED__) {
            tinyThread.mtx_destroy(ptrof pendingMtx)
        }
    }
}

// @global installs the variable into the global scope
@[thread, linkage("External")]
var __cxy_coro_scheduler: CoroutineScheduler = null;

@[inline]
func __get_scheduler() {
    @unlikely if (__cxy_coro_scheduler == null) __cxy_coro_scheduler = CoroutineScheduler()
    return &__cxy_coro_scheduler
}

@inline
pub func suspend() => __get_scheduler().suspend()
@inline
pub func resume(co:  ^Coroutine, res: i32) { __get_scheduler().resume(co, res) }
@inline
pub func yld() { __get_scheduler().yld() }
@inline
pub func suspendInterruptible() => __get_scheduler().suspendInterruptible()

/* True when the wait that just returned was interrupted by cancel */
@inline
pub func wasCancelled() => __get_scheduler().running.result == (<i32>ae.Status.AE_CANCELLED)

/* Interrupts `cr` if it is blocked in a cancel-safe wait, otherwise a no-op */
pub func cancelCoroutine(cr: ^Coroutine) {
    if (cr == null || !cr.interruptible)
        return
    #if (defined __CXY_THREADS_ENABLED__) {
        var owner = &(cr.scheduler !: CoroutineScheduler)
        if (owner.id != __get_scheduler().id) {
            owner.resumeAndWake(cr, <i32>ae.Status.AE_CANCELLED)
            return
        }
    }
    __get_scheduler().resumeCancel(cr)
}
@inline
pub func running() => __get_scheduler().running

@inline
pub func id() => __get_scheduler().running.id

// Exits the running coroutine. Called as a plain argument-less call by the
// spawn macros so no compiler temporary of the spawning function is used after
// the stack switch, the spawning function may have returned by then.
pub func __coro_exit(): void {
    __get_scheduler().epilogue()
}

macro __async(CALL, NAME) {
    // Only create the scheduler when it's needed
    var __sched = module.__get_scheduler();
    if (__cxy_coro_setjmp!(ptrof __sched.running.ctx) == 0) {
        var cr = __sched.prologue(NAME!, file!, line!);
        __cxy_coro_setsp!(cr !: ^void)
        CALL!
        module.__coro_exit()
    }
}

@[inline, __override_builtin("timestamp")]
func __now() => ae.aeOsTime()

@[inline, __override_builtin("fdWaitRead")]
func __fdWaitRead(fd: i32, timeout: u64 = 0) => __get_scheduler().fdWaitRead(fd, timeout)

@[inline, __override_builtin("pidWait")]
func __pidWait(pid: i32, timeout: u64 = 0) => __get_scheduler().pidWait(pid, timeout)

@[inline, __override_builtin("fdWaitWrite")]
func __fdWaitWrite(fd: i32, timeout: u64 = 0) => __get_scheduler().fdWaitWrite(fd, timeout)

@[inline, __override_builtin("sleepAsync")]
func __sleep(ms: i64) { __get_scheduler().sleep(ms) }

@[inline, __override_builtin("timeout")]
func __timeout(ms: i64) => __get_scheduler().timeout(ms)

// Resume `cr` on the scheduler that owns it
func resumeCoroutine(cr: ^Coroutine, res: i32) {
    #if (defined __CXY_THREADS_ENABLED__) {
        var owner = &(cr.scheduler !: CoroutineScheduler)
        if (owner.id != __get_scheduler().id) {
            owner.resumeAndWake(cr, res)
            return
        }
    }
    __get_scheduler().resume(cr, res)
}

/*
 * Handle of a coroutine started with `__async_task*`. Members prefixed with `_`
 * are used by the spawn macros. The coroutine keeps the task alive through
 * `_self` until it finishes.
 */
@nodiscard
pub class Task[T] {
    _cr: ^Coroutine = null
    _self: This = null
    _cancelled = false
    _permit = false
    _parked = false
    _done = false
    _joiners = List[Coroutine]{}
    _error: Exception = null
    #if (#T != #void) {
        _value: T? = null
    }
    // Guards the fields above and the joiners against other threads. Never held
    // while suspending.
    #if (defined __CXY_THREADS_ENABLED__) {
        _mtx = tinyThread.mtx_t{}
    }

    func `init`() {
        #if (defined __CXY_THREADS_ENABLED__) {
            tinyThread.mtx_init(ptrof _mtx, mtx_plain!)
        }
    }

    #if (defined __CXY_THREADS_ENABLED__) {
        func `deinit`() {
            tinyThread.mtx_destroy(ptrof _mtx)
        }
    }

    @inline
    - func lock() {
        #if (defined __CXY_THREADS_ENABLED__) {
            tinyThread.mtx_lock(ptrof _mtx)
        }
    }

    @inline
    - func unlock() {
        #if (defined __CXY_THREADS_ENABLED__) {
            tinyThread.mtx_unlock(ptrof _mtx)
        }
    }

    // false => cancelled. `ms == 0` parks until woken or cancelled
    func park(ms: i64 = 0): bool {
        lock()
        if (_cancelled) {
            unlock()
            return false
        }
        if (_permit) {
            _permit = false
            unlock()
            return true
        }
        _parked = true
        unlock()

        // the timer claims `_parked` like wake and cancel do
        var loop = __get_scheduler().eventLoop
        var timer = ae.Status.AE_ERR
        if (ms > 0) {
            timer = ae.aeCreateTimeEvent(
                loop, ms, _parkTimeout, this !: ^void, null)
        }
        suspendInterruptible()
        if (ms > 0)
            ae.aeDeleteTimeEvent(loop, timer)

        lock()
        _parked = false
        var stop = _cancelled
        unlock()
        return !stop
    }

    // Resume a parked task, or remember the wake for the next park(). With
    // `yieldNow` the caller also yields when it resumed a task that belongs to
    // its own scheduler, so the woken task runs promptly. Never yields otherwise
    // (permit, other thread), so it must only be set from a coroutine.
    func wake(yieldNow: bool = false) {
        var sameScheduler = false
        lock()
        if (_done) {
            unlock()
            return
        }
        if (!_parked || _cr == null) {
            _permit = true
        } else {
            // resumed under the lock, `_finish` can't recycle `_cr` meanwhile
            _parked = false
            sameScheduler = (_cr.scheduler !: ^void) ==
                (__get_scheduler() !: ^void)
            resumeCoroutine(_cr, 0)
        }
        unlock()

        if (yieldNow && sameScheduler)
            module.yld()
    }

    // Yields like the module level yld(), returns false once cancelled. A cancel
    // that arrives while the task is queued only sets the flag, seen here.
    func yld(): bool {
        if (this.cancelled())
            return false
        module.yld()
        return !this.cancelled()
    }

    // Cooperative: sets the flag and interrupts a cancel-safe wait
    func cancel() {
        lock()
        _cancelled = true
        if (_cr != null) {
            if (_parked) {
                _parked = false
                resumeCoroutine(_cr, <i32>ae.Status.AE_CANCELLED)
            } else {
                cancelCoroutine(_cr)
            }
        }
        unlock()
    }

    // Park timeout, runs in the event loop of the task's thread
    @static
    func _parkTimeout(loop: ^ae.aeEventLoop, id: i64, arg: ^void): ae.Status {
        var t = &(arg !: This)
        t.lock()
        if (t._parked && t._cr != null) {
            t._parked = false
            resumeCoroutine(t._cr, <i32>id)
        }
        t.unlock()
        return ae.Status.AE_NO_MORE
    }

    func done(): bool {
        lock()
        var res = _done
        unlock()
        return res
    }

    func cancelled(): bool {
        lock()
        var res = _cancelled
        unlock()
        return res
    }

    - func wait() {
        lock()
        if (_done) {
            unlock()
            return
        }
        _joiners.push(running())
        unlock()
        suspend()
    }

    #if (#T != #void) {
        func join(): !T {
            this.wait()
            if (this._error != null)
                raise this._error
            return &&*this._value
        }

        // Records the value, the spawn macro calls _finish() afterwards
        func _set(value: T) {
            this._value = &&value
        }
    } else {
        func join(): !void {
            this.wait()
            if (this._error != null)
                raise this._error
        }
    }

    // Records the error join() raises, the first one wins. The task keeps
    // running until its function returns.
    func throw(ex: Exception) {
        if (_error == null)
            _error = &&ex
    }

    // Called on the spawning side right after prologue()
    func _attach(cr: ^Coroutine) {
        _cr = cr
        cr.task = (this !: ^void)
        _self = __copy!(this)
    }

    // Runs once on the child stack, after the task function and its wrapper
    // returned and before epilogue() returns the stack to the pool
    func _finish(): void {
        lock()
        _done = true
        if (_cr != null) {
            _cr.task = null
            _cr = null
        }
        var joiners = List[Coroutine]{}
        while !_joiners.empty() {
            joiners.push(_joiners.pop())
        }
        unlock()

        while !joiners.empty() {
            resumeCoroutine(joiners.pop(), 0)
        }
        // may destroy the task, nothing may touch `this` afterwards
        _self = null
    }
}

@[inline, __override_builtin("__currentTask")]
pub func __currentTask[T](): &Task[T] => &(__get_scheduler().running.task !: Task[T])

/*
 * Runs on the child stack once the task body is done. The spawning function may
 * have returned by now (a task can outlive it), so nothing after the body in
 * the spawn macro may use its locals or compiler temporaries: the stack frame
 * is gone and stores to it corrupt whatever lives there now. This is a plain
 * call with no arguments for that reason.
 */
pub func __task_done[T](): void {
    __currentTask[T]()._finish()
    __get_scheduler().epilogue()
}

/*
 * Runs `BODY` on a new coroutine and returns its `Task[R]`. `BODY` records the
 * outcome on the running task (`_set`, `throw`), `_finish()` runs after it.
 * `__task` is created before setjmp: a value assigned between setjmp and the
 * second return may be a stale register copy. The child reaches its task
 * through the coroutine header, never through locals of the parent.
 */
macro __task_spawn(R, BODY, NAME) =({
    var __task = module.Task[R!]()
    var __sched = module.__get_scheduler()
    if (__cxy_coro_setjmp!(ptrof __sched.running.ctx) == 0) {
        var cr = __sched.prologue(NAME!, file!, line!)
        __task._attach(cr)
        __cxy_coro_setsp!(cr !: ^void)
        BODY!
        module.__task_done[R!]()
    }
    &&__task
})

/*
 * `@async f(args)`: the parser passes a clone of the callee (`_CALLEE`), the call
 * to the synthesized wrapper `_task_f(args)` and the optional name. `R` is the
 * unwrapped return type of `f`.
 */
macro __async_task(_CALLEE, CALL, NAME) =({
    #const Callee = typeof!(_CALLEE!)
    require!(!!Callee.attributes.[:task], "@async requires a function marked @task")
    #if (Callee.returnType.isResultType) {
        module.__task_spawn!(Callee.returnType.targetType, CALL!, NAME!)
    } else {
        module.__task_spawn!(Callee.returnType, CALL!, NAME!)
    }
})

pub struct Channel[T] {
    _buffer: CircularBuffer[T]
    _in: ^Coroutine = null
    _out: ^Coroutine = null

    func `init`(capacity: i32 = 1) {
        _buffer = CircularBuffer[T](capacity)
    }

    func send(x: T, dd: i64 = 0) {
        if _buffer.full() {
            // Buffer is full, wait for receive to consume
            _in = running()
            if timeout(dd) {
                _in = null
                return
            }
            _in = null
            // cancelled while waiting: the buffer is still full
            if wasCancelled() {
                return
            }
        }

        _buffer.push(&&x) catch discard  // We will get here if there is room
        if _out != null {
            // There is a receive waiting for data, resume it some it
            // consume the data
            resume(_out, 0)
        }
    }

    func receive(dd: i64 = 0): T? {
        if _buffer.empty() {
            // Buffer is empty, wait for sender to send
            _out = running()
            if timeout(dd) {
                _out = null
                // we timed out waiting for message to receive
                return null
            }
            _out = null
            if wasCancelled() {
                return null
            }
        }

        if _in != null {
            // there is a sender waiting to send, resuming them
            // makes the buffer fill up
            resume(_in, 0)
        }

        return _buffer.pop() catch {
            // We should never get here
            return null
        }
    }
}

pub struct CoWaitGroup {
    _name: string
    _count = Atomic[i32]()
    _waiters = List[Coroutine]{}

    func `init`(name: string = "unamed") {
        _name = name
        _count.store(0)
    }

    func add() {
        _count.fetchAdd(1)
    }

    func done() {
        var remaining = _count.fetchSub(1)
        if (remaining == 1) {
            while !_waiters.empty() {
                var waiter = _waiters.pop()
                resume(waiter, 0)
            }
        } else if (remaining < 0) {
            _count.store(0)
        }
    }

    func wait() {
        if (_count.load() != 0) {
            _waiters.push(running())
            suspend()
        }
    }
}


#if (defined __CXY_THREADS_ENABLED__) {
    pub class Mutex {
        _osMutex = tinyThread.mtx_t{}      // Protects waiters list
        _locked = Atomic[bool]()                 // Lock state
        _holder: ^Coroutine = null             // Current lock holder
        _waiters = List[Coroutine]{}       // FIFO queue of waiting coroutines

        func `init`() {
            tinyThread.mtx_init(ptrof _osMutex, mtx_plain!)
            _locked.store(false)
        }

        func lock() {
            if (_locked.compareAndSwap(false, true)) {
                _holder = running()
                return
            }
            tinyThread.mtx_lock(ptrof _osMutex)
            _waiters.push(running())
            tinyThread.mtx_unlock(ptrof _osMutex)
            suspend()
        }

        func tryLock() {
            if (_locked.compareAndSwap(false, true)) {
                _holder = running()
                return true
            }
            return false
        }

        func unlock() {
            // Must hold OS mutex to check/modify waiters list
            tinyThread.mtx_lock(ptrof _osMutex)
            var waiter = _waiters.pop()     // Protected by OS mutex

            if (waiter == null) {
                // No waiters, release lock completely
                _locked.store(false)
                _holder = null
                tinyThread.mtx_unlock(ptrof _osMutex)
                return
            }
            // Transfer lock to waiter
            _holder = waiter
            tinyThread.mtx_unlock(ptrof _osMutex)

            // Wake the waiter (lock stays held by them)
            var waiterScheduler = &(waiter.scheduler !: CoroutineScheduler)
            var currentScheduler = __get_scheduler()
            if (waiterScheduler.id == currentScheduler.id) {
                // Same thread - direct resume
                waiterScheduler.resume(waiter, 0)
            } else {
                // Different thread - use pending queue and wake event loop
                waiterScheduler.resumeAndWake(waiter, 0)
            }
        }
    }

    // Helper function for cross-thread aware coroutine resumption
    @inline
    func resumeWaiter(waiter: ^Coroutine) {
        var waiterScheduler = &(waiter.scheduler !: CoroutineScheduler)
        var currentScheduler = __get_scheduler()
        if (waiterScheduler.id == currentScheduler.id) {
            // Same thread - direct resume
            waiterScheduler.resume(waiter, 0)
        } else {
            // Different thread - use pending queue and wake event loop
            waiterScheduler.resumeAndWake(waiter, 0)
        }
    }

    pub class ConditionVariable {
        _waiters = List[Coroutine]{}
        _osMutex = tinyThread.mtx_t{}

        func `init`() {
            tinyThread.mtx_init(ptrof _osMutex, mtx_plain!)
        }

        // Wait for condition (must hold mutex when calling)
        func wait(mutex: &Mutex) {
            // Add current coroutine to waiters
            tinyThread.mtx_lock(ptrof _osMutex)
            _waiters.push(running())
            tinyThread.mtx_unlock(ptrof _osMutex)

            // Unlock user mutex and suspend
            mutex.unlock()
            suspend()

            // Reacquire mutex before returning
            mutex.lock()
        }

        // Wait with timeout (returns true if notified, false if timeout)
        func waitTimeout(mutex: &Mutex, ms: i64): bool {
            tinyThread.mtx_lock(ptrof _osMutex)
            _waiters.push(running())
            tinyThread.mtx_unlock(ptrof _osMutex)

            mutex.unlock()
            var timedOut = __get_scheduler().timeout(ms, false)

            // Note: If timeout occurs, waiter remains in list but won't be resumed
            // This is acceptable as notify() will wake a potentially timed-out waiter

            mutex.lock()
            return !timedOut
        }

        // Wake one waiting coroutine
        func notify() {
            tinyThread.mtx_lock(ptrof _osMutex)
            var waiter = _waiters.pop()
            tinyThread.mtx_unlock(ptrof _osMutex)

            if (waiter != null) {
                resumeWaiter(waiter)
            }
        }

        // Wake all waiting coroutines
        func notifyAll() {
            tinyThread.mtx_lock(ptrof _osMutex)
            var toWake = List[Coroutine]{}
            while {
                var w = _waiters.pop()
                if (w == null) break
                toWake.push(w)
            }
            tinyThread.mtx_unlock(ptrof _osMutex)

            // Resume all waiters (pop to clear link field)
            while !toWake.empty() {
                var waiter = toWake.pop()
                resumeWaiter(waiter)
            }
        }

        func `deinit`() {
            tinyThread.mtx_destroy(ptrof _osMutex)
        }
    }

    pub class Semaphore {
        _count = Atomic[i32]()
        _waiters = List[Coroutine]{}
        _osMutex = tinyThread.mtx_t{}

        func `init`(initial: i32) {
            _count.store(initial)
            tinyThread.mtx_init(ptrof _osMutex, mtx_plain!)
        }

        // Acquire one resource (blocks if count is 0)
        func acquire() {
            while (_count.load() <= 0) {
                tinyThread.mtx_lock(ptrof _osMutex)
                _waiters.push(running())
                tinyThread.mtx_unlock(ptrof _osMutex)
                suspend()
            }
            _count.fetchSub(1)
        }

        // Try to acquire without blocking
        func tryAcquire(): bool {
            var current = _count.load()
            if (current <= 0) {
                return false
            }
            if (_count.compareAndSwap(current, current - 1)) {
                return true
            }
            return false
        }

        // Release one resource
        func release() {
            _count.fetchAdd(1)

            tinyThread.mtx_lock(ptrof _osMutex)
            var waiter = _waiters.pop()
            tinyThread.mtx_unlock(ptrof _osMutex)

            if (waiter != null) {
                resumeWaiter(waiter)
            }
        }

        func `deinit`() {
            tinyThread.mtx_destroy(ptrof _osMutex)
        }
    }

    pub class WaitGroup {
        _count = Atomic[i32]()
        _waiters = List[Coroutine]{}
        _osMutex = tinyThread.mtx_t{}

        func `init`() {
            _count.store(0)
            tinyThread.mtx_init(ptrof _osMutex, mtx_plain!)
        }

        // Add to the wait counter
        func add(n: i32) {
            _count.fetchAdd(n)
        }

        // Decrement counter (call when task completes)
        func done() {
            var remaining = _count.fetchSub(1)

            if (remaining == 1) {
                // Last one finished, wake all waiters
                tinyThread.mtx_lock(ptrof _osMutex)
                var toWake = List[Coroutine]{}
                while {
                    var w = _waiters.pop()
                    if (w == null) break
                    toWake.push(w)
                }
                tinyThread.mtx_unlock(ptrof _osMutex)

                while !toWake.empty() {
                    var waiter = toWake.pop()
                    resumeWaiter(waiter)
                }
            }
        }

        // Wait for counter to reach zero
        func wait() {
            if (_count.load() == 0) {
                return
            }

            tinyThread.mtx_lock(ptrof _osMutex)
            _waiters.push(running())
            tinyThread.mtx_unlock(ptrof _osMutex)
            suspend()
        }

        func `deinit`() {
            tinyThread.mtx_destroy(ptrof _osMutex)
        }
    }

    pub struct SharedChannel[T] {
        _buffer: CircularBuffer[T]
        _in: ^Coroutine = null
        _out: ^Coroutine = null
        _mtx = tinyThread.mtx_t{}

        func `init`(capacity: i32 = 1) {
            _buffer = CircularBuffer[T](capacity)
            tinyThread.mtx_init(ptrof _mtx, mtx_plain!)
        }

        func send(x: T, dd: i64 = 0): bool {
            tinyThread.mtx_lock(ptrof _mtx)
            if _buffer.full() {
                _in = running()
                tinyThread.mtx_unlock(ptrof _mtx)
                if timeout(dd) {
                    tinyThread.mtx_lock(ptrof _mtx)
                    _in = null
                    tinyThread.mtx_unlock(ptrof _mtx)
                    return false
                }
                tinyThread.mtx_lock(ptrof _mtx)
                _in = null
                if wasCancelled() {
                    tinyThread.mtx_unlock(ptrof _mtx)
                    return false
                }
            }

            _buffer.push(&&x) catch discard
            var waiter = _out
            _out = null
            tinyThread.mtx_unlock(ptrof _mtx)

            if waiter != null {
                resumeWaiter(waiter)
            }
            return true
        }

        func receive(dd: i64 = 0): T? {
            tinyThread.mtx_lock(ptrof _mtx)
            if _buffer.empty() {
                _out = running()
                tinyThread.mtx_unlock(ptrof _mtx)
                if timeout(dd) {
                    tinyThread.mtx_lock(ptrof _mtx)
                    _out = null
                    tinyThread.mtx_unlock(ptrof _mtx)
                    return null
                }
                tinyThread.mtx_lock(ptrof _mtx)
                _out = null
                if wasCancelled() {
                    tinyThread.mtx_unlock(ptrof _mtx)
                    return null
                }
            }

            var val = _buffer.pop() catch {
                tinyThread.mtx_unlock(ptrof _mtx)
                return null
            }
            var waiter = _in
            _in = null
            tinyThread.mtx_unlock(ptrof _mtx)

            if waiter != null {
                resumeWaiter(waiter)
            }
            return &&val
        }
    }
}
