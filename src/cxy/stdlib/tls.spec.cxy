module tls_spec

// TLS for the fetch client: a server certificate is verified by default, against the
// system roots or the CA files of an SslContext, and an SslContext can carry a client
// certificate for mutual TLS. The tests talk to a real TLS server in this file.
//
// The certificates below were made once with openssl (EC P-256, valid until 2126):
//   CA          cxy-test-ca, signs the server and the client
//   server      CN=localhost, SAN DNS:localhost and IP:127.0.0.1
//   client      CN=cxy-test-client, signed by the CA
//   other CA    cxy-other-ca, the CA of the rogue client
//   rogue       a client certificate the server's CA did not sign

import test { SslContext, SslSocket, SslError } from "stdlib/ssl.cxy"
import test { Session } from "stdlib/fetch.cxy"
import test { Method } from "stdlib/http.cxy"
import test { Address } from "stdlib/net.cxy"
import test { TcpListener } from "stdlib/tcp.cxy"

import "unistd.h" as unistd
import "fcntl.h" as fcntl
import "openssl/ssl.h" as SSL
import "openssl/types.h" as TYPES

