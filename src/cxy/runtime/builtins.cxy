@hint extern func __cxy_stack_trace_destroy(st: ^void): void

@inline
pub func strerr() => strerror(errno!)

/* Builtin Optional Type */
pub struct Optional[T] {
    /* @note: Do not change the order of these members */
    ok: bool = false;
    val: T

    @inline func `init`() {
        ok = false
        zero!(@forced ptrof val)
    }

    @inline func `init`(value: T) { val = &&value; ok = true }

    #if ((T.isClass || T.isDestructible) || (has_member!(#T, "op__destructor", #func() -> void))) {
        func `destructor`() {
            if (ok) {
                #if (T.isClass || T.isDestructible)
                    delete val
                else
                    val.op__destructor()
            }
        }
    }

    @inline func `copy`() {
        #if (T.isClass || T.isDestructible)
            return This{ ok: ok, val: @copy val }
        else #if (has_member!(#T, "op__copy", #func() -> T))
            return This{ ok: ok, val: val.op__copy() }
        else
            return This{ ok: ok, val: val }
    }

    @inline func `!!`() => ok
    @inline func `deref`() { assert!(ok); return val }
    @inline func `&.`() { return &val }
    @optimize(0) func move() { ok = false; return &&val }
    // Short circuit to !!opt ? opt.move() : def
    @inline func `||`(def: T) => ok? move() : &&def
    @inline const func `!!`() => ok
    @inline const func `deref`() { return val }
    @inline const func `&.`() { return &val }
    @inline const func `is`[T]() => val is #T
    @inline const func ref() { assert!(ok); return &val }

    #if (T.isPrimitive) {
        @inline const func `==`(other: &const T) => ok && val == other
        @inline const func `!=`(other: &const T) => !ok || val != other
    }
}

/* Creates a valid optional value */
@inline
pub func Some[T](value: T) => Optional[T]{ ok: true, val: &&value }

/* Creates an invalid optional value */
@inline
pub func None[T]() => Optional[T]()

@hint extern func __cxy_call_trace_has(st: ^void, i: i64): bool
@hint extern func __cxy_call_trace_get(st: ^void, i: i64, mod: ^string, cls: ^string, fun: ^string, path: ^string, line: ^u64): bool

@builtin
pub class Exception {
    name: string
    stackTrace: ^void = null

    func `init`(name: string) {
        this.name = name
        this.stackTrace = null
    }

    virtual func what(): string => name

    @inline
    func push(mod: string, cls: string, fun: string, path: string, line: u64) {
        if (this.stackTrace == null) {
            this.stackTrace = __cxy_stack_trace_alloc()
        }
        __cxy_stack_trace_push(this.stackTrace, mod, cls, fun, path, line)
    }

    @inline func `deinit`() {
        if (this.stackTrace != null) {
            __cxy_stack_trace_destroy(this.stackTrace)
            this.stackTrace = null
        }
    }
}

@hint extern func __cxy_dump_unhandled_exception(name: string, msg: string, st: ^void): void

@[used, inline]
pub func panicOnUnhandledException(ex: &Exception): void {
    if (ex != null) {
        __cxy_dump_unhandled_exception(ex.name, ex.what(), ex.stackTrace)
    }
}

pub type HashCode = u32
#const FNV_32_PRIME = 0x01000193`u32
#const FNV_32_INIT = 0x811c9dc5`u32

@hint pub extern func hash_fnv1a_uint8(h: HashCode, x: u8): HashCode
@hint pub extern func hash_fnv1a_uint16(h: HashCode, x: u16): HashCode
@hint pub extern func hash_fnv1a_uint32(h: HashCode, x: u32): HashCode
@hint pub extern func hash_fnv1a_uint64(h: HashCode, x: u64): HashCode
@hint pub extern func hash_fnv1a_uint128(h: HashCode, x: u128): HashCode
@hint pub extern func hash_fnv1a_ptr(h: HashCode, ptr: ^const void): HashCode
@hint pub extern func hash_fnv1a_string(h: HashCode, str: string): HashCode
@hint pub extern func hash_fnv1a_n_string(h: HashCode, str: string, len: u64): HashCode
@hint pub extern func hash_fnv1a_string_n_igc(h: HashCode, str: ^const char, len: u64): HashCode
@hint pub extern func hash_fnv1a_string_igc(h: HashCode, str: const string): HashCode
@hint pub extern func hash_fnv1a_bytes(h: HashCode, ptr: ^const void, size: u64): HashCode

@[pure]
pub func hash[T](val: &const T, @unused init: HashCode = #{FNV_32_INIT}) : HashCode {
    #if (#T == #string) {
        return hash_fnv1a_string(init, val)
    }
    else #if (#T == #i8 || #T == #u8 || #T == #char) {
        return hash_fnv1a_uint8(init, <u8>val)
    }
    else #if (#T == #i16 || #T == #u16) {
        return hash_fnv1a_uint16(init, <u16>val)
    }
    else #if (#T == #i32 || #T == #u32 || #T == #wchar) {
        return hash_fnv1a_uint32(init, <u32>val)
    }
    else #if (T.isFloat || #T == #i64 || #T == #u64) {
        return hash_fnv1a_uint64(init, <u64>val)
    }
    else #if (#T == #i128 || #T == #u128) {
        return hash_fnv1a_uint128(init, <u128>val)
    }
    else #if (T.isEnum) {
        return hash_fnv1a_uint64(init, <u64>val)
    }
    else #if (T.isTuple) {
        var code = init;
        #for (const i: 0..T.membersCount) {
            code = hash(val.#{i}, code)
        }
        return code
    }
    else #if (T.isArray || T.isSlice) {
        var code = init;
        for (const x: val) {
            code = hash(x, code)
        }
        return code
    }
    else #if (T.isUnion) {
        var code = init;
        match (val) {
            #for (const i: 0..#{T.membersCount}) {
                case #{typeat!(T, i)} as y => {
                    code = hash(#{i}, code)
                    code = hash(y, code)
                }
            }
        }
        return code;
    }
    else {
        // this will fail if T does not implement hash function
        require!(
            has_member!(#T, "op__hash", #const func() -> HashCode),
            "type '{t}' must implement `hash` operator", #T
        )
        return val.op__hash()
    }
}

@hint extern func sputu128(value: u128, buf: ^char, size: u64): u64
@hint extern func sputi128(value: i128, buf: ^char, size: u64): u64

iterator StringIterator {
    s: string
    size: u64
    i = 0.i32

    func `init`(s: string, size: u64) {
        this.s = s
        this.size = size
    }

    func `()`(): (char, i32)? {
        if (i >= size) {
            return null
        }
        return (s.[i], i++)
    }

    func `!!`() => i < size
}

#if (!defined WITHOUT_BUILTINS) {

@alias("__string")
pub struct strview {
    s: string = null;
    _size: u64 = 0;

    @inline func `init`() {}

    @inline func `init`(s: string) {
        this.s = s
        if ((s !: ^void) != null)
            _size = strlen(s)
    }

    func `init`(s: string, size: u64) {
        this.s = s
        _size = size
    }

    const func trimLeft() {
        var i = 0`u64
        while (i < _size && isSpace!(s.[i]))
            i++
        if (i != 0) {
            var p = ptroff!(this.s !: ^const char + i);
            return This(p !: string, _size - i)
        }
        return This(s, _size)
    }

    const func trimRight() {
        var i = _size
        while (i > 0) {
            if (!isSpace!(s.[i - 1]))
                break
            i--
        }
        return This(s, i)
    }

    @inline
    const func trim() {
        return trimLeft().trimRight()
    }

    const func compare(other: &const This) {
        if (_size == other._size)
            return strncmp(this.s, other.s, _size)
        else if (_size < other._size)
            return -1
        else
            return 1
    }

    @inline const func `==`(other: &const This) => compare(other) == 0
    @inline const func `!=`(other: &const This) => compare(other) != 0
    @inline const func `<`(other: &const This) => compare(other) < 0
    @inline const func `<=`(other: &const This) => compare(other) <= 0
    @inline const func `>`(other: &const This) => compare(other) > 0
    @inline const func `>=`(other: &const This) => compare(other) >= 0
    @inline const func `==`(other: This) => compare(&other) == 0
    @inline const func `!=`(other: This) => compare(&other) != 0
    @inline const func `<`(other: This) => compare(&other) < 0
    @inline const func `<=`(other: This) => compare(&other) <= 0
    @inline const func `>`(other: This) => compare(&other) > 0
    @inline const func `>=`(other: This) => compare(&other) >= 0
    @inline const func `[]`(idx: u64) => s.[idx]
    @inline const func `hash`() => hash_fnv1a_n_string(#{FNV_32_INIT}, this.s, _size)
    @inline const func `copy`() { return This(s, _size) }

    @inline const func size() => _size
    @inline const func data() => s !: ^const char
    @inline const func str() => s
    @inline const func empty() => _size == 0
    @inline const func isnt() {
        return !empty() && s.[_size] == '\0'`char
    }

    const func substr(start: u64, count: i64 = -1) {
        assert!(start <= _size)
        if (count == -1)
            count = <i64>(_size - start);
        else
            assert!(count >= 0 && count <= (_size - start))
        var q = s !: ^const char;
        return This(ptroff!(q + start) !: string, count)
    }

    const func copyto(buf: ^char, size: u64) {
        assert!(size > _size)
        memcpy(buf !: ^void, s !: ^void, _size)
        buf.[_size] = '\0'`char
    }

    const func toi[T](base: i32 = 0) {
        require!(T.isInteger, "type '{t}' unsupported by `__string.toi`", #T)
        var ep: ^const char = null;
        return <T>strtoll(s !: ^const char, ptrof ep, base);
    }

    const func tof[T]() {
        require!(T.isFloat, "type '{t}' unsupported by `__string.tof`", #T)
        var ep: ^const char = null;
        return <T>strtod(s !: ^const char, ptrof ep);
    }

    func `as`[T]() {
        #if T.isInteger {
            return toi[T]()
        }
        else #if T.isFloat {
            return tof[T]()
        }
        else #if T.isString {
            #if T.isClass {
                return String(s, _size)
            }
            else #if T.isStruct {
                return This(s, _size)
            }
            else {
                return s
            }
        }
        else {
            error!("type '{t}' unsupported by `__string.as`", #T)
        }
    }

    const func indexOf(ch: char) : u64? {
        var i = 0`u64;
        while (i < _size) {
            if (s.[i] == ch)
                return i
            i++
        }
        return null
    }

    @inline
    const func contains(ch: char) : bool {
        return indexOf(ch) as bool
    }

    @inline
    const func contains(s: __string) : bool {
        return !!find(s)
    }

    @inline
    const func contains(s: string) : bool {
        return !!find(s)
    }

    const func rIndexOf(ch: char) : u64? {
        if (_size == 0)
            return null

        var i = _size - 1;
        while (i > 0) {
            if (s.[i] == ch)
                return i
            i--
        }
        return null
    }

    const func endswith(suffix: This) {
        if (suffix.size() > size())
            return false;
        return substr(size() - suffix.size()) == suffix
    }

    const func startswith(suffix: This) {
        if (suffix.size() > size())
            return false;
        return substr(0`u64, <i64>suffix.size()) == suffix
    }

    const func find(part: This) : u64? {
        if (part.empty()) {
            if (empty())
                return null
            return _size - 1
        }
        var i = _size;
        var j = 0`u64;
        var p = s !: ^const char;
        while (i >= part._size) {
            i--
            if (memcmp(ptroff!(p + j) !: ^const void, part.s !: ^const void, part._size) == 0)
                return j
            j++
        }
        return null
    }

    const func rfind(part: This) : u64? {
        if (_size >= part._size) {
            if (part.empty()) {
                if (empty())
                    return null
                return _size - 1
            }
            var j = <i64>(_size - part._size);
            var p = s !: ^const char;
            while (j >= 0) {
                if (memcmp(ptroff!(p + j) !: ^const void, part.s !: ^const void, part._size) == 0)
                    return <u64>j
                j--
            }
        }
        return null
    }

    const func `..`() => StringIterator(s, _size)

    const func `[..]`(st: i32, e: i32? = null) {
        var end = e ?? _size as i32 - 1;
        assert!(st <= end && end < _size)
        return slice!(ptrof s.[st], end)
    }
}

#const CXY_STRING_BUILDER_DEFAULT_CAPACITY = 32`u64

@[inline, pure]
pub func isnull[T](cls: &const T) {
    require!(T.isPointer || T.isClass, "isnull can only be used on class types")
    return cls == null
}

@builtin
pub class OutputStream {
    virtual func append(str: ^const void, size: u64): u64?

    @inline
    func appendString(s: string) : void {
        if (s != null)
            append(s !: ^const void, strlen(s))
    }

    @inline
    func appendString(s: &const __string) : void {
        append(s.s !: ^const void, s.size())
    }

    func appendSignedInt(num: i128) {
        var buf: [char, 64];
        const len = sputi128(num, buf, 64);
        append(buf !: ^const void, len)
    }

    func appendUnSignedInt(num: u128) {
        var buf: [char, 64];
        const len = sputu128(num, buf, 64);
        append(buf !: ^const void, len)
    }

    func appendFloat(num: f64) {
        var data: [char, 32];
        const len = sprintf(data, "%g", num);
        append(data !: ^const void, len)
    }

    func appendChar(ch: wchar) {
        var data: [char, 5];
        var size: u64 = 0;
        if (ch < 0x80) {
            data.[0] = <char> ch
            size = 1
        }
        else if (ch < 0x800) {
            data.[0] = <char> (0xC0 | (ch >> 6))
            data.[1] = <char> (0x80 | (ch & 0x3f))
            size = 2;
        }
        else if (ch < 0x10000) {
            data.[0] = <char> (0xE0 | (ch >> 12))
            data.[1] = <char> (0x80 | ((ch >> 6) & 0x3f))
            data.[2] = <char> (0x80 | (ch & 0x3f))
            size = 3
        }
        else if (ch < 0x200000) {
            data.[0] = <char> (0xF0 | (ch >> 16))
            data.[1] = <char> (0x80 | ((ch >> 12) & 0x3f))
            data.[2] = <char> (0x80 | ((ch >> 6) & 0x3f))
            data.[3] = <char> (0x80 | (ch & 0x3f))
            size = 4
        }
        else {
            // TODO raise OutOfRangeException()
        }
        append(data !: ^const void, size)
    }


    @inline
    func appendBool(val: bool) {
        if (val)
            append("true" !: ^const void, 4`u64)
        else
            append("false" !: ^const void, 5`u64)
    }

    func appendPointer[T](ptr: &const T) {
        var data: [char, 32];
        const len = sprintf(data, "%p", ptr !: ^const void);
        append(data, len)
    }

    @transient
    func `<<`[U](val: &const U) : &OutputStream {
        #if (U.isString)
            #if (U.isClass)
                if (isnull(val))
                    appendString("null")
                else
                    append(val._data !: ^const void, val.size())
            else
                appendString(val)
        else #if (U.isInteger)
            appendSignedInt(<i128>val)
        else #if (U.isFloat)
            appendFloat(val)
        else #if (U.isBoolean)
            appendBool(val)
        else #if (#U == #wchar || #U == #char)
             appendChar(val)
        else #if (U.isEnum) {
             switch(val) {
                #for (const V: U.members) {
                    case U.#{mk_ident!(V.name)} => {
                        #const attr = V.attributes.["str"];
                        #if (attr) {
                            appendString(#{attr.[0]})
                        }
                        else {
                            appendString(#{U.name})
                            appendChar('.')
                            appendString(#{V.name})
                        }
                    }
                }
            }
        }
        else #if (U.isOptional) {
            if (val)
                this << *val
            else
                appendString("null")
        }
        else #if (U.isClass) {
            require!(
                has_member!(#U, "op__str", #const func (_: &OutputStream) -> void),
                "type {t} does not implement `str` operator",
                #U
            )
            if (isnull(val))
                appendString("null")
            else
                val.op__str(this)
        }
        else #if (U.isStruct) {
            #if (has_member!(#U, "op__str", #const func (_: &OutputStream) -> void)) {
                val.op__str(this)
            } else {
                #if (!U.isAnonymousStruct)
                    appendString(#{U.name})
                appendString("{")

                #const first = true
                #for (const M: U.members) {
                    #if (M.isField) {
                        #if (!first)
                            this.appendString(", ")
                        appendString(#{M.name})
                        appendString(": ")
                        #if (M.isString)
                            appendString("\"")
                        else #if (#M == #wchar || #M == #char)
                            appendString("'")
                        this << val.#{mk_ident!(M.name)}
                        #if (M.isString)
                            appendString("\"")
                        else #if (#M == #wchar || #M == #char)
                            appendString("'")
                        #{first = false}
                    }
                }
                appendString("}")
            }
        }
        else #if (U.isTuple) {
            this.appendChar('(')
            #for (const i: 0..U.membersCount) {
                #if (i != 0)
                    this.appendString(", ")
                this << val.#{i}
            }
            this.appendChar(')')
        }
        else #if (U.isArray || U.isSlice) {
            this.appendChar('[')
            for (const i: 0..len!(val)) {
                if (i != 0)
                    this.appendString(", ")
                this << val.[i]
            }
            this.appendChar(']')
        }
        else #if (U.isUnion) {
            match (val) {
                #for (const i: 0..#{U.membersCount}) {
                    case #{typeat!(U, i)} as y => this << y
                }
            }
        }
        else #if (U.isPointer) {
            this.appendPointer[#{U.pointedType}](val)
        }
        else #if (U.isFunction) {
            this.appendString("TODO//function")
        }
        else {
            error!("type {t} not supported by OutputStream::`<<` operator", #U)
        }
        return &this
    }
}

@builtin
pub class String : OutputStream {
    - _capacity: u64 = 0;
    - _size: u64 = 0;
    - _data: ^char = null;

    - func grow(growSize: u64) {
        const newSize = max(_size + growSize, 16`u64);
        if (this._data == null) {
            this._data = <^char> __alloc_buffer(newSize + 1)
            this._capacity = newSize
        }
        else if (this._capacity < newSize) {
            while (this._capacity < newSize) {
                this._capacity <<= 1
            }
            var tmp = __realloc_buffer(this._data !: ^void, this._capacity+1)
            if (tmp == null) {
                panic!("failed to grow string buffer")
            }
            this._data = <^char> tmp
            this._data.[_size] = '\0'`char
        }
    }

    @inline
    func `init`() {}

    @inline
    func `init`(str: string) {
        super.appendString(str)
    }

    @inline
    func `init`(str: ^const char, len: u64) {
        append(str, len)
    }

    @inline
    func `init`(str: __string) {
        super.appendString(&str)
    }

    @inline
    func `init`(str: &const __string) {
        super.appendString(str)
    }

    @inline
    func `deinit`() {
        clear()
    }

    @inline
    - func head() => _data
    @inline
    - func tail() =>
        ptroff!( _data + _size ) // This is okay since _size is always < _capacity

    func reserve(size: u64) {
        grow(size)
        return tail()
    }

    func resize(newSize: u64) {
        assert!(_capacity >= newSize)
        _size = newSize
        _data.[_size] = '\0'`char
    }

    func clear() : void {
        if (_data != null) {
            __free_buffer(this._data)
            this._data = null
            this._capacity = 0
            this._size = 0
        }
    }

    func append(str: ^const char, size: u64) : u64? {
        if (size) {
            grow(size)
            var p = this._data + this._size;
            memmove(p, str, size)
            this._size += size
            this._data.[this._size] = <char>'\0'
        }
        return size
    }

    func trimLeft() {
        var i = 0`u64
        while (i < _size && isSpace!(_data.[i]))
            i++
        if (i != 0) {
            var p = ptroff!(this._data + i);
            memmove(_data, p, _size - i)
            _size = _size - i
        }
    }

    func trimLeft(ch: char) {
        var i = 0`u64
        while (i < _size && _data.[i] == ch)
            i++
        if (i != 0) {
            var p = ptroff!(this._data + i);
            memmove(_data, p, _size - i)
            _size = _size - i
        }
    }

    func trimRight() {
        while (_size > 0) {
            if (!isSpace!(_data.[_size - 1]))
                break
            _size--
        }
        if (_capacity > 0)
            _data.[_size] = '\0'
    }

    func trimRight(ch: char) {
        while (_size > 0) {
            if (_data.[_size - 1] != ch)
                break
            _size--
        }
        if (_capacity > 0)
            _data.[_size] = '\0'
    }

    @inline
    func trim() {
        trimLeft()
        trimRight()
    }

    @inline
    func trim(ch: char) {
        trimLeft(ch)
        trimRight(ch)
    }

    @inline
    const func indexOf(ch: char) : u64? {
        var i = 0`u64;
        while (i < _size) {
            if (_data.[i] == ch)
                return i
            i++
        }
        return null
    }

    @inline
    const func contains(ch: char) : bool {
        return !!indexOf(ch)
    }

    @inline
    const func rIndexOf(ch: char) : u64? {
        if (_size == 0)
            return null

        var i = _size - 1;
        while (i > 0) {
            if (_data.[i] == ch)
                return i
            i--
        }
        return null
    }

    @inline
    func `+`[U](other: &const U) => this << other

    @inline
    const func `str`(sb: OutputStream) {
        sb.append(_data, _size)
    }

    @inline
    const func `hash`() {
        if (this._data) {
            return hash_fnv1a_bytes(#{FNV_32_INIT}, this._data, this._size)
        }
        else {
            return #{FNV_32_INIT}
        }
    }

    const func compare(other: ^const char, size: u64) {
        if (_size != size)
            return <i32>(_size - size)

        for (const i : 0.._size) {
            if (_data.[i] != other.[i])
                return (<i32>_data.[i]) - (<i32>other.[i])
        }

        return <i32>0
    }

    @inline
    const func compare(other: &const String) =>
        compare(other._data, other._size)

    @inline
    const func compare(other: const string) =>
        compare(other !: ^const char, strlen(other))

    @inline
    const func compare(other: const __string) =>
        compare(other.data(), other.size())

    @inline
    const func `==`(other: &const String) => compare(other) == 0

    @inline
    const func `!=`(other: &const String) => compare(other) != 0

    @inline
    const func `<`(other: &const String) => compare(other) < 0

    @inline
    const func `>`(other: &const String) => compare(other) > 0

    @inline
    const func `<=`(other: &const String) => compare(other) <= 0

    @inline
    const func `>=`(other: &const String) => compare(other) >= 0

    @inline
    const func `==`(other: const string) => compare(other) == 0

    @inline
    const func `!=`(other: const string) => compare(other) != 0

    @inline
    const func `<`(other: const string) => compare(other) < 0

    @inline
    const func `>`(other: const string) => compare(other) > 0

    @inline
    const func `<=`(other: const string) => compare(other) <= 0

    @inline
    const func `>=`(other: const string) => compare(other) >= 0

    @inline
    const func `==`(other: const __string) => compare(other) == 0

    @inline
    const func `!=`(other: const __string) => compare(other) != 0

    @inline
    const func `<`(other: const __string) => compare(other) < 0

    @inline
    const func `>`(other: const __string) => compare(other) > 0

    @inline
    const func `<=`(other: const __string) => compare(other) <= 0

    @inline
    const func `>=`(other: const __string) => compare(other) >= 0

    @inline
    const func `[]`(idx: u32) {
        assert!(idx < _size)
        return this._data.[idx]
    }

    const func `..`() => StringIterator(_data !: string, _size)

    @inline const func size() => _size
    @inline const func capacity() => _capacity
    @inline const func data() => _data
    @inline const func empty() => _size == 0
    @inline const func str() => _data !: string
    @[inline, deprecated] const func __str() => __string(_data !: string, _size)
    @inline const func s() => __string(_data !: string, _size)
    @inline const func view() => __string(_data !: string, _size)
    @inline const func copy() => String(_data, _size)
    @inline const func substr(start: u64, count: i64 = -1) => __str().substr(start, count)
    @inline const func endswith(suffix: String) => __str().endswith(suffix.__str())
    @inline const func endswith(suffix: __string) => __str().endswith(suffix)
    @inline const func endswith(suffix: string) => __str().endswith(suffix)
    @inline const func startswith(suffix: String) =>  __str().startswith(suffix.__str())
    @inline const func startswith(suffix: __string) => __str().startswith(suffix)
    @inline const func startswith(suffix: string) =>  __str().startswith(suffix)
    @inline const func find(substr: __string) => __str().find(substr)
    @inline const func find(substr: string) => __str().find(substr)
    @inline const func rfind(substr: __string) => __str().rfind(substr)
    @inline const func rfind(substr: string) => __str().rfind(substr)
    @inline const func contains(ch: __string) => __str().contains(ch)
    @inline const func contains(ch: string) => __str().contains(ch)
}

pub class BufferedOutputStream: OutputStream {
    - _buffer: ^char
    - _capacity: u64
    - _size: u64

    @memtrace(callsite)
    func `init`(capacity: u64 = 1024) {
        _capacity = capacity
        _size = 0
        _buffer = __alloc_buffer(capacity) !: ^char
    }

    virtual func flush(str: ^const void, size: u64): void

    func sync() {
        if (_size > 0) {
            flush(_buffer, _size)
            _size = 0
        }
    }

    func append(data: ^const void, size: u64): u64? {
        var room = _capacity - _size
        if (size > room && _size > 0) {
            sync()
            room = _capacity
        }
        if (size < room) {
            var src = data !: ^const char;
            memcpy(ptrof _buffer.[_size], src, size)
            _size += size
        }
        else {
            flush(data, size)
        }
        return size
    }

    @inline
    func `deinit`() {
        if (_buffer) {
            sync()
            __free_buffer(_buffer !: ^void)
            _buffer = null
        }
    }
}

class StdOutputStream : OutputStream {
    - fd: i32
    func `init`(fd: i32 = 0) {
        this.fd = fd
    }

    func append(str: ^const char, size: u64): u64? {
        if (size) {
           write(fd, str, size)
        }
        return size
    }
}

pub func toHexString(os: &OutputStream, data: ^const void, len: u64, caps: bool = false) {
    const p = data !: ^const u8
    const hexCharsCaps = "0123456789ABCDEF"
    const hexChars = "0123456789abcdef"
    if caps {
        for i : 0..len {
            var c = p.[i]
            os << hexCharsCaps.[(c >> 4) & 0xF]
               << hexCharsCaps.[c & 0xF]
        }
    }
    else {
        for i : 0..len {
            var c = p.[i]
            os << hexChars.[(c >> 4) & 0xF]
               << hexChars.[c & 0xF]
        }
    }
}

pub class Bytes {
    _data: ^u8 = null
    _len: u64 = 0

    @memtrace(callsite)
    func `init`(len: u64) {
        _data = __alloc_buffer(len) !: ^u8
        _len = len
    }

    func `deinit`() {
        if (_data != null)
            __free_buffer(_data !: ^void)
    }

    func `[]`(index: u64) {
        assert!(index < _len)
        return _data.[index]
    }

    func `[]=`(index: u64, value: u8) {
        assert!(index < _len)
        _data.[index] = value
    }

    @inline
    const func `str`(os: &OutputStream) {
        toHexString(os, _data !: ^const void, _len)
    }

    func data() => _data

    const func size() => _len
    const func data() => _data
}

macro ref(ptr) __smart_ptr_get((ptr!) !: sptr)

macro deref(ptr) __smart_ptr_drop((ptr!) !: sptr)

macro stackAlloc(T, ...ARGS) =({
    require!(T!.isClass, "Type '{t}' must be a class type", #T!)
    var obj = mk_bc!(bfiAlloca!, #&T!, T!);
    init_defaults!(obj)
    obj.op__init(ARGS!);
    obj
})

pub var stdout: OutputStream = StdOutputStream(1);
pub var stderr: OutputStream = StdOutputStream(2);

#if (defined MACOS) {
macro SC_PAGESIZE         29
macro SC_NPROCESSORS_ONLN 58
}
else #if (defined UNIX) {
macro SC_PAGESIZE         30
macro SC_NPROCESSORS_ONLN 84
}
pub var SysConfPageSize = sysconf(SC_PAGESIZE!);
pub var SysConfNumProcs = sysconf(SC_NPROCESSORS_ONLN!);

@inline
pub func print[T](data: &const T) {
    require!(T.isString, "type '{t}' is not a string, `print` only supports string types", #T)
    #if (T.isClass) {
        write(0, data.data(), data.size())
    }
    else {
        write(0, data, strlen(data))
    }
}

pub func println(...args: auto) {
    #for (const x: args) {
        stdout << #{x}
    }
    stdout << '\n'
}

@inline
pub func min[T](a: T, b: T) => a < b? a : b

@inline
pub func max[T](a: T, b: T) => a > b? a : b

pub struct Equals[K] {
    func `()`(lhs: &const K, rhs: &const K): bool {
        #if (has_member!(#K, "op__eq", #const func(_: &const K) -> bool)) {
            return lhs == rhs
        }
        else #if K.isInteger || K.isFloat || K.isBoolean || K.isEnum || K.isChar || #K == #string {
            return lhs == rhs
        }
        else {
            error!("type {t} does not implement equality operator", #K)
        }
    }

    #if (K == String) {
        @inline
        func `()`(lhs: &const String, rhs: &const __string): bool {
            return lhs == rhs
        }
    }
}

pub struct Hash[K] {
    // @inline
    func `()`(val: &const K) => hash(val)
}

pub struct EqualsCase {
    @inline
    const func `()`(lhs: &const String, rhs: &const String) =>
        lhs.size() == rhs.size() && strncasecmp(
            lhs.str(),
            rhs.str(),
            lhs.size()) == 0

    @inline
    const func `()`(lhs: const string, rhs: const string) =>
        strcasecmp(lhs, rhs) == 0

    @inline
    const func `()`(lhs: &const __string, rhs: &const __string) =>
        lhs.size() == rhs.size() && strncasecmp(
            lhs.str(),
            rhs.str(),
            lhs.size()) == 0
}

pub struct HashCase {
    @inline
    const func `()`(value: &const const String) =>
        hash_fnv1a_string_n_igc(#{FNV_32_INIT}, value.data(), value.size())

    @inline
    const func `()`(value: &const __string) =>
        hash_fnv1a_string_n_igc(
            #{FNV_32_INIT},
            value.data(),
            value.size()
        )

    @inline
    const func `()`(value: const string) =>
        hash_fnv1a_string_igc(#{FNV_32_INIT}, value)
}

@[inline]
pub func update[Lhs, Rhs](@unused lhs: &Lhs, @unused rhs: Rhs) {
    require!(Lhs.isClass || Lhs.isStruct, "lhs must be a class/struct type")
    require!(Rhs.isStruct, "rhs must be a struct type")
    #for (const M: Rhs.members) {
        #if (M.isField) {
            #const T = M.Tinfo;
            require!(M.isField, "member {s} must be a field", M.name)
            require!(has_member!(#Lhs, M.name, #T),
                     "target does not have a member named '{s}' of type {t}", M.name, #T)
            lhs.#{mk_ident!(M.name)} = && rhs.#{mk_ident!(M.name)}
        }
    }
}


pub func StreamException(ex: &Exception, os: &OutputStream) {
    os << ex.name << ": " << ex.what() << "\n"
    var i = 0.i64
    while __cxy_call_trace_has(ex.stackTrace, i) {
        var mod: string = null
        var cls: string = null
        var fun: string = null
        var path: string = null
        var line: u64 = 0
        __cxy_call_trace_get(ex.stackTrace, i, ptrof mod, ptrof cls, ptrof fun, ptrof path, ptrof line)

        if i != 0 { os << '\n' }
        os << "  [" << i << "] "
        if mod != null {
            os << mod << '.'
        }
        if cls != null {
            os << cls << '.'
        }
        if fun != null { os << fun }
        else { os << "unknown" }
        os << ':'
        if path != null { os << path }
        else { os << "unknown" }
        os << ':' << line
        i++
    }
}

pub class OutOfRangeException: Exception {
    msg: String = null;

    func `init`(msg: String = null) {
        super( "OutOfRangeException" )
        this.msg = &&msg
    }

    func what() => msg == null? name : msg.str()
}

